---
import Base from "../../layouts/Base.astro";
import Pagination from "../../components/Pagination.astro";
import FilterPanel from "../../components/FilterPanel.astro";
import SortButton from "../../components/SortButton.astro";
import ActionBar from "../../components/ActionBar.astro";
import { api } from "../../lib/api";
export const prerender = false;

const sort = Astro.url.searchParams.get("sort") ?? "title";
const genres = Astro.url.searchParams.getAll("genre");
const years = Astro.url.searchParams.getAll("year").map(Number).filter((n) => !Number.isNaN(n));
const statuses = Astro.url.searchParams.getAll("status");
const watched = Astro.url.searchParams.getAll("watched");
const page = Number(Astro.url.searchParams.get("page") ?? 1);
const { token } = Astro.locals;
Astro.response.headers.set("Cache-Control", "private, no-cache");

const data = await api.shows.list({
  sort,
  page,
  genre: genres,
  year: years,
  status: statuses,
  watched,
}, token);

const TV_GENRES = [
  "Action & Adventure", "Animation", "Comedy", "Crime", "Documentary",
  "Drama", "Family", "Kids", "Mystery", "News", "Reality",
  "Sci-Fi & Fantasy", "Soap", "Talk", "War & Politics", "Western",
];

const TV_STATUSES = ["Returning Series", "In Production", "Planned", "Ended", "Canceled"];

const hasFilters = genres.length > 0 || years.length > 0 || statuses.length > 0 || watched.length > 0;

// Build base URL preserving active filters (without page)
const baseParams = new URLSearchParams();
baseParams.set("sort", sort);
genres.forEach((g) => baseParams.append("genre", g));
years.forEach((y) => baseParams.append("year", String(y)));
statuses.forEach((s) => baseParams.append("status", s));
watched.forEach((w) => baseParams.append("watched", w));
const baseUrl = `/collection/shows?${baseParams.toString()}`;
---

<Base title="My Shows">
  <div class="flex items-center gap-1 mb-6 bg-zinc-900 border border-zinc-800 rounded-xl p-1 w-fit">
    <a href="/shows" class="px-4 py-1.5 rounded-lg text-sm font-medium text-zinc-400 hover:text-zinc-100 transition-colors active:scale-95 active:opacity-70">Explore</a>
    <a href="/collection/shows" class="px-4 py-1.5 rounded-lg text-sm font-semibold bg-blue-600 text-white transition-colors active:scale-95 active:opacity-70">My Collection</a>
  </div>
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-10">
    <div class="flex items-baseline gap-3">
      <h1 class="page-title">My Shows</h1>
      <span class="text-zinc-500 font-medium">{data.total_results.toLocaleString()} total</span>
    </div>

    <!-- Sort & filter controls -->
    <div class="flex items-center gap-3">
      <SortButton
        id="show-sort"
        current={sort}
        options={[
          { value: "title", label: "A–Z" },
          { value: "rating", label: "Top" },
          { value: "release_date", label: "Newest" },
          { value: "created_at", label: "Recently Added" },
          { value: "last_watched", label: "Recently Watched" },
        ]}
      />
      <FilterPanel
        id="show-filters"
        basePath="/collection/shows"
        currentSort={sort}
        sections={[
          { key: "genre", label: "Genre", options: TV_GENRES.map((g) => ({ value: g, label: g })), selected: genres },
          { key: "year", label: "Year", selected: years.map(String), dynamic: true, endpoint: "/api/proxy/shows/years" },
          { key: "status", label: "Status", options: TV_STATUSES.map((s) => ({ value: s, label: s })), selected: statuses },
          { key: "watched", label: "Progress", options: [{ value: "watched", label: "Started" }, { value: "unwatched", label: "Not Started" }], selected: watched },
        ]}
      />
    </div>
  </div>

  {data.results.length === 0 ? (
    <div class="bg-zinc-900/50 rounded-2xl p-12 text-center border border-dashed border-zinc-800">
      <div class="text-zinc-500 mb-4 text-lg">
        {hasFilters ? "No shows match the selected filters" : "Your library is empty"}
      </div>
      {!hasFilters && (
        <a href="/settings" class="inline-flex items-center px-6 py-3 bg-zinc-100 text-zinc-950 font-bold rounded-xl hover:bg-zinc-200 transition">
          Set up Sync
        </a>
      )}
    </div>
  ) : (
    <>
      <div class="space-y-8">
        {data.results.map((item) => {
          const progress = Math.max(0, Math.min(100, item.watch_pct ?? 0));

          return (
            <article class="group relative overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-950 shadow-xl">

              <div class="flex flex-col md:flex-row">

                <!-- POSTER -->
                <a
                  href={`/show/${item.tmdb_id}`}
                  class="relative w-full md:w-[220px] lg:w-[250px] shrink-0 aspect-[2/3] md:aspect-auto"
                >
                  {item.poster_path ? (
                    <img
                      src={item.poster_path}
                      alt={item.title}
                      class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                      loading="lazy"
                    />
                  ) : (
                    <div class="absolute inset-0 bg-zinc-900 flex items-center justify-center text-zinc-600">
                      <span class="text-5xl">📺</span>
                    </div>
                  )}

                  <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
                </a>

                <!-- BACKDROP / INFORMATION -->
                <div class="relative min-w-0 flex-1 min-h-[330px]">

                  {item.backdrop_path ? (
                    <img
                      src={item.backdrop_path}
                      alt=""
                      class="absolute inset-0 w-full h-full object-cover opacity-45"
                      loading="lazy"
                    />
                  ) : (
                    <div class="absolute inset-0 bg-zinc-900"></div>
                  )}

                  <!-- Dark overlay -->
                  <div class="absolute inset-0 bg-gradient-to-r from-zinc-950/95 via-zinc-950/80 to-zinc-950/45"></div>
                  <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-transparent to-zinc-950/20"></div>

                  <!-- CONTENT -->
                  <div class="relative z-10 flex min-h-[330px] flex-col justify-end p-6 lg:p-8">

                    <!-- ACTIONS -->
                    <div class="absolute top-5 right-5">
                      <ActionBar
                        tmdbId={Number(item.tmdb_id)}
                        mediaType="series"
                        watched={item.watched ?? false}
                        inLists={item.in_lists ?? []}
                        inLibrary={true}
                        collectionPct={item.collection_pct ?? 0}
                        watchPct={item.watch_pct ?? 0}
                        showTmdbId={Number(item.tmdb_id)}
                        isMonitored={item.is_monitored ?? false}
                        requestEnabled={item.request_enabled ?? false}
                        requestStatus={item.request_status ?? null}
                        userRating={item.user_rating ?? null}
                      />
                    </div>

                    <!-- TITLE -->
                    <a
                      href={`/show/${item.tmdb_id}`}
                      class="block mb-3 pr-40"
                    >
                      <h2 class="text-2xl lg:text-3xl font-black text-white tracking-tight group-hover:text-red-500 transition-colors">
                        {item.title}
                      </h2>
                    </a>

                    <!-- BASIC PROGRESS -->
                    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 mb-5 text-sm">
                      <span class="font-bold text-zinc-100">
                        {Math.round(progress)}% watched
                      </span>

                      {item.status && (
                        <span class="text-zinc-400">
                          {item.status}
                        </span>
                      )}

                      {item.first_air_date && (
                        <span class="text-zinc-500">
                          {String(item.first_air_date).slice(0, 4)}
                        </span>
                      )}
                    </div>

                    <!-- PROGRESS BAR -->
                    <div class="w-full max-w-4xl">
                      <div class="h-2 bg-zinc-800 rounded-full overflow-hidden">
                        <div
                          class="h-full bg-red-600 rounded-full transition-all"
                          style={`width: ${progress}%`}
                        ></div>
                      </div>

                      <div class="flex justify-between mt-2 text-[10px] font-black uppercase tracking-[0.18em] text-zinc-500">
                        <span>Progress</span>
                        <span>{Math.round(progress)}%</span>
                      </div>
                    </div>

                  </div>
                </div>

              </div>
            </article>
          );
        })}
      </div>

      <Pagination
        currentPage={data.page}
        totalPages={data.total_pages}
        baseUrl={baseUrl}
      />
    </>
  )}
</Base>
