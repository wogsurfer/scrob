---
// The physical disc collection, laid out like Collectorz: folders down the
// side, covers or a list in the middle, and the selected release's details on
// the right. The whole collection is sent once and filtered in the browser.
import Base from "../../layouts/Base.astro";
import CollectionNav from "../../components/CollectionNav.astro";
import { api, type PhysicalSummary } from "../../lib/api";
import watchdIconWhite from "../../assets/watchd-icon-white.png";
import watchdIconRed from "../../assets/watchd-icon-red.png";
import "../../styles/collection.css";
export const prerender = false;

const { token } = Astro.locals;
Astro.response.headers.set("Cache-Control", "private, no-cache");

let items: PhysicalSummary[] = [];
let error = "";
try {
  items = (await api.physical.items(token)).items;
} catch (e: unknown) {
  error = e instanceof Error ? e.message : "Couldn't load the collection";
}

const status = Astro.url.searchParams.get("status") === "wishlist" ? "wishlist" : "owned";
// Counted as they sit on the shelf: a box set once.
const owned = items.filter((i) => i.status === "owned" && !i.parent_id).length;
const wishlist = items.filter((i) => i.status === "wishlist" && !i.parent_id).length;
---

<Base title={status === "wishlist" ? "Wish List" : "Collection"}>
  <div class="coll" data-status={status}>
    <CollectionNav active={status} owned={owned} wishlist={wishlist} />

    {error && <div class="coll-error">{error}</div>}

    {!error && items.length === 0 && (
      <div class="coll-empty">
        <p class="coll-empty-title">No discs yet</p>
        <p>Add your first disc, or import your Collectorz export.</p>
      </div>
    )}

    {items.length > 0 && (
      <>
        <div class="coll-toolbar">
          <div class="coll-search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" stroke-linecap="round" /></svg>
            <input id="coll-q" type="search" placeholder="Search title, edition, barcode, director…" autocomplete="off" />
          </div>
          <div class="coll-letters" id="coll-letters" role="group" aria-label="First letter">
            {["All", "#", ..."ABCDEFGHIJKLMNOPQRSTUVWXYZ"].map((l) => <button type="button" data-letter={l}>{l}</button>)}
          </div>
          <div class="coll-controls">
            <label class="coll-select">
              <span>Sort</span>
              <select id="coll-sort">
                <option value="title">Title</option>
                <option value="release_year">Release year</option>
                <option value="purchase_date">Purchase date</option>
                <option value="date_added">Date added</option>
                <option value="disc_release_date">Disc release</option>
                <option value="my_rating">My rating</option>
                <option value="imdb_rating">IMDb rating</option>
                <option value="runtime">Running time</option>
                <option value="distributor">Distributor</option>
                <option value="format">Format</option>
                <option value="index_no">Index</option>
              </select>
            </label>
            <button type="button" id="coll-dir" class="coll-icon-btn" title="Reverse order" aria-label="Reverse order">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 4v16M7 20l-3-3M7 20l3-3M17 20V4M17 4l-3 3M17 4l3 3" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
            <div class="coll-views" role="group" aria-label="View">
              <button type="button" data-view="grid" title="Covers" aria-label="Covers">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1.5" /><rect x="14" y="3" width="7" height="9" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg>
              </button>
              <button type="button" data-view="list" title="List" aria-label="List">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" stroke-linecap="round" /></svg>
              </button>
            </div>
            <input id="coll-size" type="range" min="120" max="300" step="10" value="180" title="Cover size" aria-label="Cover size" />
            <div class="coll-cols-wrap">
              <button type="button" id="coll-cols-btn" class="coll-cols-btn" aria-expanded="false" hidden>Columns</button>
              <div id="coll-cols" class="coll-cols" hidden>
                <div class="coll-cols-head">
                  <b>Columns</b>
                  <button type="button" id="coll-cols-reset">Reset</button>
                </div>
                <p class="coll-cols-hint">Tick to show. Reorder with the arrows, or drag a column's header in the list.</p>
                <input id="coll-cols-find" placeholder="Find a column" autocomplete="off" />
                <ul id="coll-cols-list"></ul>
              </div>
            </div>
          </div>
        </div>

        <div class="coll-body">
          <aside class="coll-folders">
            <button type="button" id="coll-folders-toggle" class="coll-folders-toggle" aria-label="Hide folders" title="Hide folders">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m15 6-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
            <span class="coll-folders-tab">Folders</span>
            <label class="coll-select coll-group">
              <span>Folders</span>
              <select id="coll-group">
                <option value="">None</option>
                <option value="format">Format</option>
                <option value="package">Packaging</option>
                <option value="distributor">Distributor</option>
                <option value="store">Store</option>
                <option value="genres">Genre</option>
                <option value="director">Director</option>
                <option value="regions">Region</option>
                <option value="edition">Edition</option>
                <option value="in_set">Box set</option>
                <option value="franchise">Franchise</option>
                <option value="series">Series</option>
                <option value="tags">Tags</option>
                <option value="audience_rating">Age rating</option>
                <option value="condition">Condition</option>
                <option value="location">Location</option>
                <option value="purchase_year">Purchase year</option>
                <option value="decade">Release decade</option>
                <option value="seen">Seen</option>
                <option value="kind">Film or TV</option>
              </select>
            </label>
            <ul id="coll-folder-list"></ul>
          </aside>

          <main class="coll-main">
            <p class="coll-count" id="coll-count"></p>
            <div id="coll-grid" class="coll-grid"></div>
            <div id="coll-list" class="coll-list" hidden>
              <table>
                <thead><tr id="coll-head"></tr></thead>
                <tbody id="coll-rows"></tbody>
              </table>
            </div>
          </main>

          <aside class="coll-detail" id="coll-detail" aria-live="polite">
            <div class="coll-detail-empty">Pick a disc to see its details</div>
          </aside>
        </div>
      </>
    )}
  </div>

  <script type="application/json" id="coll-data" set:html={JSON.stringify(items).replace(/</g, "\\u003c")}></script>
  <div id="coll-icons" data-white={watchdIconWhite.src} data-red={watchdIconRed.src} hidden></div>
</Base>

<script>
  import type { PhysicalSummary, PhysicalDetail } from "../../lib/api";
  import { DEFAULT_COLS, makeColumns } from "../../lib/collection/columns";
  import { esc, fmtDate, formatIcon, ratingIcon, regionIcon } from "../../lib/collection/format";
  import {
    ageRating, folderOf as shelfFolderOf, formatClass, formatLabel, hits as shelfHits, matches as shelfMatches,
    prepareSets, setSize, sortItems,
  } from "../../lib/collection/shelf";

  const root = document.querySelector<HTMLElement>(".coll");
  const dataEl = document.getElementById("coll-data");
  if (root && dataEl && document.getElementById("coll-grid")) {
    const all: PhysicalSummary[] = JSON.parse(dataEl.textContent || "[]");
    // Box sets hold their films; `kids` looks a set's films up.
    const kids = prepareSets(all);
    const icons = document.getElementById("coll-icons")!.dataset;
    const status = root.dataset.status || "owned";

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const q = $<HTMLInputElement>("coll-q");
    const sortSel = $<HTMLSelectElement>("coll-sort");
    const groupSel = $<HTMLSelectElement>("coll-group");
    const sizeInput = $<HTMLInputElement>("coll-size");
    const grid = $<HTMLDivElement>("coll-grid");
    const list = $<HTMLDivElement>("coll-list");
    const rows = $<HTMLTableSectionElement>("coll-rows");
    const folderList = $<HTMLUListElement>("coll-folder-list");
    const countEl = $<HTMLParagraphElement>("coll-count");
    const detail = $<HTMLElement>("coll-detail");

    // Per-viewer preferences.
    const saved = (() => { try { return JSON.parse(localStorage.getItem("collection-view") || "{}"); } catch { return {}; } })();

    // List view columns.
    const setTitle = (i: PhysicalSummary) => (i.is_set ? i.title : i.parent_id ? all.find((x) => x.id === i.parent_id)?.title ?? "" : "");
    const COLS = makeColumns(setTitle);
    let cols: string[] = (Array.isArray(saved.cols) ? saved.cols : DEFAULT_COLS).filter((k: string) => k in COLS);
    if (!cols.includes("title")) cols.unshift("title");
    const state = {
      q: "",
      letter: "All",
      sort: saved.sort || "title",
      dir: saved.dir || 1,
      view: saved.view || "grid",
      size: saved.size || 180,
      // A link can open a folder: ?group=kind&folder=TV.
      group: new URL(location.href).searchParams.get("group") ?? saved.group ?? "format",
      folder: new URL(location.href).searchParams.get("folder") as string | null,
      // ?show= (from a show's Collection button): only that series' discs.
      show: Number(new URL(location.href).searchParams.get("show")) || null,
      // Folded away by default on a phone, where they'd fill the screen.
      foldersHidden: saved.foldersHidden ?? matchMedia("(max-width: 767px)").matches,
      // Sets opened in the list view.
      expanded: new Set<number>(),
      // Sets closed by hand, even where a search or folder would open them.
      collapsed: new Set<number>(),
      // ?tmdb= (from a film card) opens your copy of that film. Films and
      // series are numbered apart on TMDB, so a show can share its number.
      selected: Number(new URL(location.href).searchParams.get("item"))
        || (() => {
          const tmdb = Number(new URL(location.href).searchParams.get("tmdb"));
          return (tmdb && all.find((i) => i.tmdb_id === tmdb && i.tmdb_kind === "movie" && i.status === status)?.id) || null;
        })(),
    };
    const save = () => {
      try { localStorage.setItem("collection-view", JSON.stringify({ sort: state.sort, dir: state.dir, view: state.view, size: state.size, group: state.group, cols, foldersHidden: state.foldersHidden })); } catch {}
    };

    const inStatus = all.filter((i) => i.status === status && !i.parent_id);
    // The shelf rules (lib/collection/shelf.ts) with this page's filters.
    const folderOf = (i: PhysicalSummary, group: string) => shelfFolderOf(i, group, kids);
    const matches = (i: PhysicalSummary, skipFolder = false) => shelfMatches(i, state, kids, skipFolder);
    const hits = (i: PhysicalSummary) => shelfHits(i, state, kids);
    const sorted = (items: PhysicalSummary[]) => sortItems(items, state.sort, state.dir, kids, COLS[state.sort]?.sort);

    function renderFolders() {
      folderList.innerHTML = "";
      if (!state.group) return;
      const counts = new Map<string, number>();
      for (const i of inStatus) if (matches(i, true)) for (const v of folderOf(i, state.group)) counts.set(v, (counts.get(v) || 0) + 1);
      const numeric = ["purchase_year", "decade"].includes(state.group);
      const entries = [...counts].sort((a, b) =>
        a[0] === "(none)" ? 1 : b[0] === "(none)" ? -1 : numeric ? b[0].localeCompare(a[0]) : a[0].localeCompare(b[0]),
      );
      const total = inStatus.filter((i) => matches(i, true)).length;
      const li = (label: string, count: number, value: string | null) =>
        `<li><button type="button" class="${state.folder === value ? "active" : ""}" data-folder="${value === null ? "" : esc(value)}" data-all="${value === null}"><span>${esc(label)}</span><b>${count}</b></button></li>`;
      folderList.innerHTML = li(status === "wishlist" ? "[Whole wish list]" : "[Whole collection]", total, null) + entries.map(([v, c]) => li(v, c, v)).join("");
    }

    function card(i: PhysicalSummary) {
      const seen = i.seen ? icons.red : icons.white;
      const k = kids(i);
      const h = hits(i);
      const sub = h.length ? `Includes ${h.map((x) => x.title).join(", ")}` : [i.release_year, i.edition].filter(Boolean).join(" · ");
      return `<button type="button" class="coll-card${i.is_set ? " is-set" : ""}${i.id === state.selected ? " selected" : ""}" data-id="${i.id}" title="${esc(i.title)}${i.is_set ? ` · ${esc(k.map((x) => x.title).join(", "))}` : i.edition ? ` · ${esc(i.edition)}` : ""}">
        <span class="coll-cover">${i.cover ? `<img src="${i.cover}" alt="" loading="lazy" decoding="async" />` : `<span class="coll-nocover">${esc(i.title)}</span>`}
          ${i.unedited ? `<span class="coll-new" title="Never edited: no cover scan or details yet">NEW</span>` : ""}
          ${status === "owned" ? `<img class="coll-w" src="${seen}" alt="${i.seen ? "Seen" : "Not seen"}" />` : ""}
          ${i.is_set ? `<span class="coll-set">${esc(setSize(k))}</span>` : ""}
        </span>
        <span class="coll-card-title">${esc(i.title)}</span>
        <span class="coll-card-sub${h.length ? " hit" : ""}">${esc(sub)}</span>
      </button>`;
    }

    // A cell's plain text, for its tooltip (long values are cut short).
    function cellText(i: PhysicalSummary, c: string): string {
      const v = COLS[c].sort ? COLS[c].sort!(i) : (i as any)[c];
      return v == null || v === false ? "" : String(v);
    }

    function row(i: PhysicalSummary, kid = false): string {
      const k = kids(i);
      const h = hits(i);
      const open = i.is_set && !state.collapsed.has(i.id) && (state.expanded.has(i.id) || h.length > 0);
      const toggle = i.is_set
        ? `<button type="button" class="coll-expand${open ? " open" : ""}" data-expand="${i.id}" aria-label="${open ? "Hide" : "Show"} the films in this set">▸</button>`
        : "";
      const self = `<tr data-id="${i.id}" class="${[i.id === state.selected && "selected", kid && "kid", i.is_set && "set"].filter(Boolean).join(" ")}">
        ${cols.map((c) => c === "title"
          ? `<td class="t">${toggle}${esc(i.title)}${i.is_set ? ` <span class="coll-set-inline">${esc(setSize(k))}</span>` : ""}</td>`
          : `<td class="${COLS[c].dim ? "dim" : ""}" title="${esc(cellText(i, c))}">${COLS[c].cell ? COLS[c].cell!(i) : esc((i as any)[c])}</td>`).join("")}
      </tr>`;
      return open ? self + (h.length && !state.expanded.has(i.id) ? h : k).map((x) => row(x, true)).join("") : self;
    }

    function render() {
      const visible = sorted(inStatus.filter((i) => matches(i)));
      // The show's name: what its discs' titles share ("Breaking Bad: The
      // First Season", "Breaking Bad: The Second Season"... -> "Breaking Bad").
      const showTitles = state.show ? all.filter((i) => i.tmdb_id === state.show && i.tmdb_kind === "tv").map((i) => i.title) : [];
      let showName = showTitles[0] ?? "this show";
      if (showTitles.length > 1) {
        let common = showTitles.reduce((a, b) => { let n = 0; while (n < a.length && a[n] === b[n]) n++; return a.slice(0, n); });
        if (common.includes(":")) common = common.slice(0, common.lastIndexOf(":"));
        showName = common.trim() || showName;
      }
      countEl.innerHTML = esc(`${visible.length.toLocaleString()} ${visible.length === 1 ? "disc" : "discs"}${state.folder != null ? ` in ${state.folder}` : ""}`)
        + (state.show ? ` of ${esc(showName)} · <a href="/collection" class="coll-showall">Show all</a>` : "");
      grid.hidden = state.view !== "grid";
      list.hidden = state.view !== "list";
      grid.style.setProperty("--cover", `${state.size}px`);
      if (state.view === "grid") grid.innerHTML = visible.map(card).join("");
      else rows.innerHTML = visible.map((i) => row(i)).join("");
      document.querySelectorAll<HTMLButtonElement>("#coll-letters button").forEach((b) => b.classList.toggle("active", b.dataset.letter === state.letter));
      document.querySelectorAll<HTMLButtonElement>(".coll-views button").forEach((b) => b.classList.toggle("active", b.dataset.view === state.view));
      $("coll-head").innerHTML = cols.map((c) => `<th data-sort="${c}" draggable="true" title="Click to sort, drag to move" data-active="${c === state.sort ? (state.dir > 0 ? "asc" : "desc") : ""}">${esc(COLS[c].label)}</th>`).join("");
      $("coll-cols-btn").hidden = state.view !== "list";
      if (state.view !== "list") $("coll-cols").hidden = true;
      renderFolders();
    }

    // ── Detail panel ─────────────────────────────────────────────────────
    const chips = (values?: string[]) => (values?.length ? `<div class="cd-chips">${[...new Set(values)].map((v) => `<span>${esc(v)}</span>`).join("")}</div>` : "");
    const fact = (label: string, value: unknown) => (value === null || value === undefined || value === "" ? "" : `<div class="cd-fact"><dt>${esc(label)}</dt><dd>${value}</dd></div>`);
    const section = (title: string, body: string, open = true) => (body ? `<details class="cd-section"${open ? " open" : ""}><summary>${esc(title)}</summary>${body}</details>` : "");

    // "Watched twice, last on 14 March 2025"; "Watched once, on 2 June 2024".
    function watchedText(d: PhysicalDetail) {
      if (!d.plays) return d.seen ? "Marked as watched" : "Not watched yet";
      const times = d.plays === 1 ? "once" : d.plays === 2 ? "twice" : `${d.plays} times`;
      const when = d.last_watched
        ? new Date(d.last_watched).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })
        : "";
      return when ? `Watched ${times}, ${d.plays === 1 ? "on" : "last on"} ${when}` : `Watched ${times}`;
    }

    // Your rating of the disc: ten stars to click, yours lit; clicking your
    // rating again clears it.
    // A star lit, half lit (its left half is the half rating) or not, for a rating out of 10.
    const starClass = (star: number, r?: number | null) => (!r ? "" : star <= r ? "on" : star - 0.5 === r ? "half" : "");
    function stars(id: number, n?: number | null) {
      return `<span class="cd-stars cd-rate" data-id="${id}" data-rating="${n || 0}" title="${n ? `Your rating: ${n}/10` : "Rate this disc"}">${Array.from({ length: 10 }, (_, k) =>
        `<button type="button" data-star="${k + 1}" class="${starClass(k + 1, n)}" aria-label="Rate ${k + 1} out of 10"></button>`).join("")}</span>`;
    }

    function discsHtml(d: PhysicalDetail) {
      const discs = d.specs.discs || [];
      if (discs.length <= 1 && !discs.some((x: any) => x.episodes?.length)) return "";
      return discs.map((x: any) => `<div class="cd-disc">
        <p class="cd-disc-head"><b>${esc(x.title || "Disc")}</b>${x.format ? ` <span class="coll-fmt-inline coll-fmt-${formatClass(x.format)}">${esc(formatLabel(x.format))}</span>` : ""}</p>
        ${x.features?.length ? `<p class="cd-dim">${x.features.map(esc).join(" · ")}</p>` : ""}
        ${x.episodes?.length ? `<ol class="cd-episodes">${x.episodes.map((e: any) => `<li>${esc(e.title)}${e.runtime ? ` <span class="cd-dim">${e.runtime} min</span>` : ""}</li>`).join("")}</ol>` : ""}
        ${x.extra_features ? `<pre class="cd-pre">${esc(x.extra_features)}</pre>` : ""}
      </div>`).join("");
    }

    function detailHtml(d: PhysicalDetail) {
      const s = d.specs;
      const filmHref = d.tmdb_id ? (d.tmdb_kind === "tv" ? `/show/${d.tmdb_id}` : `/media/movie/${d.tmdb_id}`) : null;
      // Multi-disc releases list what's on each disc, so "On the disc" would repeat it.
      const discs = discsHtml(d);
      const people = (role: string) => (s.crew || []).filter((c: any) => c.role === role).map((c: any) => esc(c.name)).join(", ");
      // A film in a set: the shelf details (barcode, price, location...) are the set's.
      const p = d.parent;
      const shelf = p ?? d;
      const seenOf = d.contents.filter((x) => x.seen).length;
      const films = (list: PhysicalDetail["contents"], cls = "") => `<div class="cd-mini ${cls}">${list.map((b) => `<button type="button" data-id="${b.id}">
        ${b.cover ? `<img src="${b.cover}" alt="" loading="lazy" />` : `<span class="cd-mini-none">${esc(b.title)}</span>`}
        <span>${esc(b.title)}${b.release_year ? ` (${b.release_year})` : ""}</span>
        ${status === "owned" ? `<img class="cd-mini-w" src="${b.seen ? icons.red : icons.white}" alt="${b.seen ? "Seen" : "Not seen"}" />` : ""}
      </button>`).join("")}</div>`;
      return `
        ${d.backdrop ? `<div class="cd-backdrop" style="background-image:url('${esc(d.backdrop)}')"></div>` : ""}
        <button type="button" class="cd-close" aria-label="Close">×</button>
        <div class="cd-top">
          <button type="button" class="cd-cover">
            ${d.cover_full ? `<img src="${esc(d.cover_full)}" alt="Cover of ${esc(d.title)}" />` : `<span class="coll-nocover">${esc(d.title)}</span>`}
          </button>
          <div class="cd-head">
            <h2>${esc(d.title)}${s.title_extension ? ` <span>${esc(s.title_extension)}</span>` : ""}</h2>
            ${p ? `<button type="button" class="cd-partof" data-id="${p.id}">Part of <b>${esc(p.title)}</b></button>` : ""}
            <p class="cd-sub">${[d.release_year, s.studios?.slice(0, 2).join(" / ")].filter(Boolean).map(esc).join(" · ")}</p>
            ${shelf.edition ? `<p class="cd-edition">${esc(shelf.edition)}</p>` : ""}
            <div class="cd-badges">
              ${shelf.format ? formatIcon(shelf.format) || `<span class="cd-badge coll-fmt-${formatClass(shelf.format)}">${esc(shelf.format)}</span>` : ""}
              ${d.is_set ? `<span class="cd-badge cd-setbadge">${esc(setSize(d.contents as any))}</span>` : ""}
              ${(d.regions || []).map((r) => regionIcon(r) || `<span class="cd-badge cd-region">${esc(r.replace("Region ", ""))}</span>`).join("")}
              ${d.audience_rating ? ratingIcon(d.audience_rating) || `<span class="cd-badge cd-age">${esc(ageRating(d.audience_rating))}</span>` : ""}
              ${d.status === "wishlist" ? `<span class="cd-badge cd-wish">Wish list</span>` : ""}
            </div>
            <div class="cd-ratings">
              ${d.imdb_rating ? (() => {
                const inner = `IMDb <b>${d.imdb_rating}</b>${s.imdb_votes ? ` <i>${Number(s.imdb_votes).toLocaleString()}</i>` : ""}`;
                // Opens the film's page on IMDb.
                return /^tt\d+$/.test(s.imdb_id || "")
                  ? `<a class="cd-imdb" href="https://www.imdb.com/title/${s.imdb_id}/" target="_blank" rel="noopener" title="Open on IMDb">${inner}</a>`
                  : `<span class="cd-imdb">${inner}</span>`;
              })() : ""}
              ${stars(d.id, d.my_rating)}
            </div>
            <p class="cd-seen ${(d.is_set ? d.contents.length > 0 && seenOf === d.contents.length : d.seen) ? "on" : ""}">
              <img src="${(d.is_set ? d.contents.length > 0 && seenOf === d.contents.length : d.seen) ? icons.red : icons.white}" alt="" />
              ${d.is_set ? `Seen ${seenOf} of ${d.contents.length}` : watchedText(d)}
            </p>
          </div>
          <div class="cd-story">
            ${s.tagline ? `<p class="cd-tagline">“${esc(s.tagline)}”</p>` : ""}
            ${s.plot ? `<p class="cd-plot-label">Plot</p><p class="cd-plot">${esc(s.plot)}</p>` : ""}
        <div class="cd-actions">
          <a class="cd-btn" href="/collection/${d.id}/edit">Edit</a>
          ${d.is_set ? `<a class="cd-btn ghost" href="/collection/add?set=${encodeURIComponent(d.title)}">Add a film</a>` : ""}
          ${filmHref ? `<a class="cd-btn ghost" href="${filmHref}">${d.tmdb_kind === "tv" ? "Show page" : "Film page"} →</a>` : ""}
        </div>
          </div>
        </div>

        <div class="cd-sections">
        ${d.is_set ? section(`In this set`, d.contents.length ? films(d.contents, "cd-set-films") : `<p class="cd-dim">No films in it yet. Add them with “Add a film”, or set “Part of a set” when editing a disc.</p>`) : ""}
        ${section("Edition", `<dl class="cd-facts">
          ${fact("Distributor", esc(shelf.distributor))}
          ${fact("Barcode", shelf.barcode ? `<span class="cd-mono">${esc(shelf.barcode)}</span>` : "")}
          ${fact("Disc release", esc(fmtDate(d.disc_release_date)))}
          ${fact("Discs", d.disc_count)}
          ${fact("Packaging", esc(d.package))}
          ${fact("Running time", d.runtime ? `${d.runtime} min` : "")}
          ${fact("Layers", esc(s.layers))}
          ${fact("Colour", s.color && s.color !== "Color" ? esc(s.color) : "")}
          ${fact("HDR", esc(s.hdr))}
          ${fact("Series", esc(d.series))}
        </dl>`)}
        ${section("Picture and sound", `
          ${s.ratios?.length ? `<p class="cd-label">Aspect ratio</p>${chips(s.ratios)}` : ""}
          ${s.audio?.length ? `<p class="cd-label">Audio</p>${chips(s.audio)}` : ""}
          ${s.subtitles?.length ? `<p class="cd-label">Subtitles</p>${chips(s.subtitles)}` : ""}
          ${s.features?.length && !discs ? `<p class="cd-label">On the disc</p>${chips(s.features)}` : ""}
          ${s.extras?.length ? `<p class="cd-label">In the box</p>${chips(s.extras)}` : ""}
        `.trim())}
        ${section("Discs", discs, false)}
        ${section("Extra features", s.extra_features ? `<pre class="cd-pre">${esc(s.extra_features)}</pre>` : "", false)}
        ${section(p ? "Purchase (the set)" : "Purchase", `<dl class="cd-facts">
          ${fact("Purchased", esc(fmtDate(shelf.purchase_date)))}
          ${fact("Store", esc(shelf.store))}
          ${fact("Price", shelf.purchase_price != null ? esc(shelf.purchase_price.toFixed(2)) : "")}
          ${fact("Value", d.current_value != null ? esc(d.current_value.toFixed(2)) : "")}
          ${fact("Condition", esc(shelf.condition))}
          ${fact("Location", esc(shelf.location))}
          ${fact("Index", d.index_no)}
          ${fact("Owner", esc(d.owner))}
          ${fact("Added", esc(fmtDate(d.date_added)))}
          ${fact("Seen in cinema", esc(s.seen_in_cinema))}
          ${fact("Viewing date", esc(fmtDate(d.viewing_date)))}
        </dl>${d.notes ? `<p class="cd-notes">${esc(d.notes)}</p>` : ""}${d.tags?.length ? chips(d.tags.map((t) => `#${t}`)) : ""}`)}
        ${d.is_set ? "" : section("Film", `<dl class="cd-facts">
          ${fact("Director", people("Director"))}
          ${fact("Writer", people("Writer"))}
          ${fact("Music", people("Composer") || people("Musician"))}
          ${fact("Genre", esc((d.genres || []).join(", ")))}
          ${fact("Country", esc(s.country))}
          ${fact("Language", esc(s.language))}
          ${fact("Adaptation of", esc(s.adaptation_of))}
          ${fact("Based on", esc(s.adapted_titles))}
        </dl>`)}
        ${section("Cast", (s.cast || []).length ? `<ul class="cd-cast">${s.cast.slice(0, 24).map((c: any) => `<li><b>${esc(c.name)}</b>${c.character ? `<span>${esc(c.character)}</span>` : ""}</li>`).join("")}</ul>` : "", false)}
        ${p ? section("Also in this set", d.contents.filter((x) => x.id !== d.id).length ? films(d.contents.filter((x) => x.id !== d.id)) : "") : ""}
        ${section("Your other editions", d.other_editions.length ? `<ul class="cd-others">${d.other_editions.map((o) => `<li><button type="button" data-id="${o.id}">${esc(o.format || "")} · ${esc(o.edition || "Edition")}${o.status === "wishlist" ? " (wish list)" : ""}</button></li>`).join("")}</ul>` : "")}
        </div>
      `;
    }

    let detailToken = 0;
    async function select(id: number | null, scroll = false) {
      state.selected = id;
      const url = new URL(location.href);
      if (id) url.searchParams.set("item", String(id)); else url.searchParams.delete("item");
      history.replaceState(null, "", url);
      document.querySelectorAll(".coll-card.selected, #coll-rows tr.selected").forEach((e) => e.classList.remove("selected"));
      if (!id) { detail.classList.remove("open"); return; }
      // A film in a set lights up the set it's in.
      const parentId = all.find((i) => i.id === id)?.parent_id;
      for (const key of [id, parentId]) if (key) document.querySelectorAll(`.coll-card[data-id="${key}"], #coll-rows tr[data-id="${key}"]`).forEach((e) => e.classList.add("selected"));
      const mine = ++detailToken;
      detail.classList.add("open", "loading");
      try {
        const res = await fetch(`/api/proxy/physical/items/${id}`);
        if (!res.ok) throw new Error();
        const d: PhysicalDetail = await res.json();
        if (mine !== detailToken) return;
        detail.innerHTML = detailHtml(d);
        detail.scrollTop = 0;
        if (scroll) document.querySelector(`.coll-card[data-id="${id}"], #coll-rows tr[data-id="${id}"], .coll-card[data-id="${parentId}"]`)?.scrollIntoView({ block: "nearest" });
      } catch {
        if (mine === detailToken) detail.innerHTML = `<div class="coll-detail-empty">Couldn't load this disc</div>`;
      } finally {
        if (mine === detailToken) detail.classList.remove("loading");
      }
    }

    // ── Events ───────────────────────────────────────────────────────────
    const rerender = () => render();
    let typing: number | undefined;
    q.addEventListener("input", () => { clearTimeout(typing); typing = window.setTimeout(() => { state.q = q.value.trim(); rerender(); }, 120); });
    $("coll-letters").addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-letter]");
      if (b) { state.letter = b.dataset.letter!; rerender(); }
    });
    sortSel.addEventListener("change", () => { state.sort = sortSel.value; state.dir = ["purchase_date", "date_added", "my_rating", "imdb_rating", "disc_release_date"].includes(state.sort) ? -1 : 1; save(); rerender(); });
    $("coll-dir").addEventListener("click", () => { state.dir *= -1; save(); rerender(); });
    document.querySelector(".coll-views")!.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-view]");
      if (b) { state.view = b.dataset.view!; save(); render(); }
    });
    sizeInput.addEventListener("input", () => { state.size = Number(sizeInput.value); grid.style.setProperty("--cover", `${state.size}px`); save(); });
    groupSel.addEventListener("change", () => { state.group = groupSel.value; state.folder = null; save(); rerender(); });
    folderList.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-folder]");
      if (b) { state.folder = b.dataset.all === "true" ? null : b.dataset.folder!; rerender(); }
    });
    // Drag a column header to move the column.
    const head = $("coll-head");
    let dragging: string | null = null;
    head.addEventListener("dragstart", (e) => {
      const th = (e.target as HTMLElement).closest<HTMLElement>("th[data-sort]");
      if (!th) return;
      dragging = th.dataset.sort!;
      th.classList.add("dragging");
      e.dataTransfer!.effectAllowed = "move";
      e.dataTransfer!.setData("text/plain", dragging);
    });
    head.addEventListener("dragover", (e) => {
      const th = (e.target as HTMLElement).closest<HTMLElement>("th[data-sort]");
      if (!dragging || !th || th.dataset.sort === dragging) return;
      e.preventDefault();
      const after = e.clientX > th.getBoundingClientRect().left + th.offsetWidth / 2;
      head.querySelectorAll("th").forEach((x) => x.classList.remove("drop-before", "drop-after"));
      th.classList.add(after ? "drop-after" : "drop-before");
    });
    head.addEventListener("drop", (e) => {
      const th = (e.target as HTMLElement).closest<HTMLElement>("th[data-sort]");
      if (!dragging || !th) return;
      e.preventDefault();
      const after = th.classList.contains("drop-after");
      const moved = cols.filter((c) => c !== dragging);
      moved.splice(moved.indexOf(th.dataset.sort!) + (after ? 1 : 0), 0, dragging);
      cols = moved;
      save();
      render();
      if (!colsBox.hidden) renderCols();
    });
    head.addEventListener("dragend", () => {
      dragging = null;
      head.querySelectorAll("th").forEach((x) => x.classList.remove("dragging", "drop-before", "drop-after"));
    });

    document.querySelector("#coll-list thead")!.addEventListener("click", (e) => {
      const th = (e.target as HTMLElement).closest<HTMLElement>("th[data-sort]");
      if (!th) return;
      if (state.sort === th.dataset.sort) state.dir *= -1; else { state.sort = th.dataset.sort!; state.dir = 1; if ([...sortSel.options].some((o) => o.value === state.sort)) sortSel.value = state.sort; }
      save(); rerender();
    });
    const pick = (e: Event) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>("[data-id]");
      if (el) select(Number(el.dataset.id));
    };
    grid.addEventListener("click", pick);
    rows.addEventListener("click", (e) => {
      const toggle = (e.target as HTMLElement).closest<HTMLElement>("[data-expand]");
      if (!toggle) return pick(e);
      const id = Number(toggle.dataset.expand);
      // The arrow closes an open set, whatever opened it, and opens a closed
      // one showing all its films.
      if (toggle.classList.contains("open")) { state.expanded.delete(id); state.collapsed.add(id); }
      else { state.collapsed.delete(id); state.expanded.add(id); }
      render();
    });

    detail.addEventListener("click", async (e) => {
      const t = e.target as HTMLElement;
      if (t.closest(".cd-close")) return select(null);
      const jump = t.closest<HTMLElement>(".cd-mini [data-id], .cd-others [data-id], .cd-partof");
      if (jump) return select(Number(jump.dataset.id), true);
      const star = t.closest<HTMLElement>(".cd-rate [data-star]");
      if (star) {
        const box = star.closest<HTMLElement>(".cd-rate")!;
        const id = Number(box.dataset.id), before = Number(box.dataset.rating) || null;
        // The left half of a star rates half a star less.
        const n = Number(star.dataset.star) - (e.offsetX < star.offsetWidth / 2 ? 0.5 : 0);
        const rating = before === n ? null : n;
        // Shown at once, put back if the server says no.
        const show = (r: number | null) => {
          box.dataset.rating = String(r || 0);
          box.title = r ? `Your rating: ${r}/10` : "Rate this disc";
          box.querySelectorAll<HTMLElement>("[data-star]").forEach((b) => b.className = starClass(Number(b.dataset.star), r));
        };
        show(rating);
        const res = await fetch(`/api/proxy/physical/items/${id}/rating`, {
          method: "PUT", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ rating }),
        }).catch(() => null);
        if (!res?.ok) return show(before);
        const item = all.find((x) => x.id === id);
        if (item) item.my_rating = rating ?? undefined;
      }
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && detail.classList.contains("open") && window.matchMedia("(max-width: 767px)").matches) select(null);
    });

    // The columns chooser.
    const colsBox = $("coll-cols");
    const colsList = $("coll-cols-list");
    const colsFind = $<HTMLInputElement>("coll-cols-find");
    function renderCols() {
      const q = colsFind.value.trim().toLowerCase();
      const order = [...cols, ...Object.keys(COLS).filter((k) => !cols.includes(k))];
      let group = "";
      colsList.innerHTML = order.filter((k) => !q || COLS[k].label.toLowerCase().includes(q)).map((k) => {
        const on = cols.includes(k);
        const head = !on && COLS[k].group !== group ? `<li class="coll-cols-group">${esc((group = COLS[k].group))}</li>` : "";
        const idx = cols.indexOf(k);
        return `${head}<li class="${on ? "on" : ""}">
          <label><input type="checkbox" data-col="${k}" ${on ? "checked" : ""} ${k === "title" ? "disabled" : ""} /> ${esc(COLS[k].label)}</label>
          ${on && !q ? `<span class="coll-cols-move">
            <button type="button" data-move="${k}" data-by="-1" ${idx === 0 ? "disabled" : ""} aria-label="Move left">▲</button>
            <button type="button" data-move="${k}" data-by="1" ${idx === cols.length - 1 ? "disabled" : ""} aria-label="Move right">▼</button>
          </span>` : ""}
        </li>`;
      }).join("");
    }
    const colsChanged = () => { save(); renderCols(); render(); };
    $("coll-cols-btn").addEventListener("click", () => {
      colsBox.hidden = !colsBox.hidden;
      $("coll-cols-btn").setAttribute("aria-expanded", String(!colsBox.hidden));
      if (!colsBox.hidden) { colsFind.value = ""; renderCols(); }
    });
    colsFind.addEventListener("input", renderCols);
    colsList.addEventListener("change", (e) => {
      const box = (e.target as HTMLInputElement);
      const k = box.dataset.col!;
      cols = box.checked ? [...cols, k] : cols.filter((c) => c !== k);
      colsChanged();
    });
    colsList.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-move]");
      if (!b) return;
      const from = cols.indexOf(b.dataset.move!);
      const to = from + Number(b.dataset.by);
      if (to < 0 || to >= cols.length) return;
      [cols[from], cols[to]] = [cols[to], cols[from]];
      colsChanged();
    });
    $("coll-cols-reset").addEventListener("click", () => { cols = [...DEFAULT_COLS]; colsChanged(); });
    document.addEventListener("click", (e) => {
      if (!colsBox.hidden && !(e.target as HTMLElement).closest(".coll-cols-wrap")) colsBox.hidden = true;
    });

    // Folders panel: hide it to give the covers or list the room.
    const body = document.querySelector<HTMLElement>(".coll-body")!;
    const foldersToggle = $("coll-folders-toggle");
    const showFolders = () => {
      body.classList.toggle("folders-hidden", state.foldersHidden);
      const label = state.foldersHidden ? "Show folders" : "Hide folders";
      foldersToggle.setAttribute("aria-label", label);
      foldersToggle.title = label;
    };
    foldersToggle.addEventListener("click", () => { state.foldersHidden = !state.foldersHidden; save(); showFolders(); });
    document.querySelector(".coll-folders")!.addEventListener("click", (e) => {
      // A click anywhere on the hidden strip opens it.
      if (state.foldersHidden && !(e.target as HTMLElement).closest("#coll-folders-toggle")) { state.foldersHidden = false; save(); showFolders(); }
    });
    showFolders();

    sortSel.value = state.sort;
    groupSel.value = state.group;
    sizeInput.value = String(state.size);
    render();
    if (state.selected) select(state.selected, true);
  }
</script>
