---
import Base from "../layouts/Base.astro";
import { api } from "../lib/api";
import DashboardWatchlistCard from "../components/DashboardWatchlistCard.astro";
import SectionHeading from "../components/SectionHeading.astro";

export const prerender = false;

const { token } = Astro.locals;

const movies = await api.watchlist.getAll(token!);
---

<Base title="Watchlist">

<SectionHeading title="Watchlist" />

<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-7 gap-x-6 gap-y-8">

    {movies.map((movie) => (
        <DashboardWatchlistCard movie={movie} />
    ))}

</div>

</Base>
