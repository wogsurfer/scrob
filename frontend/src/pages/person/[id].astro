---
import Base from "../../layouts/Base.astro";
import MediaCard from "../../components/MediaCard.astro";
import ActionBar from "../../components/ActionBar.astro";
import { api, type MediaItem } from "../../lib/api";

export const prerender = false;

const { id } = Astro.params;
const { token } = Astro.locals;
const selectedCategory = ["all", "acting", "directing", "writing", "producing", "other"].includes(Astro.url.searchParams.get("category") || "")
  ? Astro.url.searchParams.get("category")!
  : "all";
const person = await api.media.getPerson(Number(id), 1, token, selectedCategory);

const credits = person.credits || [];
const totalPages = Math.ceil(person.total_credits / person.page_size);
const categoryLabels = { all: "All", acting: "Acting", directing: "Directing", writing: "Writing", producing: "Producing", other: "Other" };
---

<Base title={person.name}>
<div class="w-full mx-auto px-4 sm:px-6 lg:px-10 py-8 md:py-12">


    <!-- Person header -->
    <section class="grid grid-cols-1 lg:grid-cols-[300px_1fr] gap-8 lg:gap-12 items-start">

      <!-- Portrait -->
      <div class="lg:sticky lg:top-8">
        {person.profile_path ? (
          <div class="relative aspect-[2/3] w-full max-w-[300px] mx-auto lg:mx-0 rounded-2xl overflow-hidden bg-zinc-900 shadow-2xl ring-1 ring-white/10 group/photo">
            <button
              id="photo-zoom-btn"
              class="w-full h-full block cursor-zoom-in"
              aria-label={`Enlarge photo of ${person.name}`}
            >
              <img
                src={person.profile_path}
                alt={person.name}
                class="w-full h-full object-cover transition-transform duration-500 group-hover/photo:scale-[1.025]"
                loading="eager"
                decoding="async"
              />
              <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover/photo:opacity-100 transition-opacity duration-200 bg-black/25">
                <div class="rounded-full bg-black/60 backdrop-blur-sm p-3 ring-1 ring-white/20">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6 text-white">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607ZM10.5 7.5v6m3-3h-6" />
                  </svg>
                </div>
              </div>
            </button>
          </div>
                ) : (
                  <div class="aspect-[2/3] w-full max-w-[300px] mx-auto lg:mx-0 rounded-2xl bg-zinc-900 flex items-center justify-center text-6xl border border-zinc-800">
                    👤
                  </div>
                )}

                <div class="mt-4">
                  <ActionBar
                    tmdbId={person.tmdb_id}
                    mediaType="person"
                    watched={false}
                    inLists={person.in_lists ?? []}
                    inLibrary={false}
                    collectionPct={0}
                    listOnly={true}
                  />
                </div>
              </div>

      <!-- Header content -->
      <div class="min-w-0">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-5">
          <div>
            {person.known_for_department && (
              <p class="text-red-500 text-xs font-black uppercase tracking-[0.2em] mb-2">
                {person.known_for_department}
              </p>
            )}
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[0.95]">
              {person.name}
            </h1>
          </div>
        </div>

        <!-- Personal details -->
        <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 border-y border-zinc-800/80">
          {person.known_for_department && (
            <div class="py-4 sm:pr-5 sm:border-r border-zinc-800/80">
              <p class="text-[10px] font-black uppercase tracking-[0.16em] text-zinc-600 mb-1">Known For</p>
              <p class="text-sm font-semibold text-zinc-200">{person.known_for_department}</p>
            </div>
          )}

          {person.birthday && (
            <div class="py-4 sm:px-5 sm:border-r border-zinc-800/80">
              <p class="text-[10px] font-black uppercase tracking-[0.16em] text-zinc-600 mb-1">Birthday</p>
              <p class="text-sm font-semibold text-zinc-200">{person.birthday}</p>
            </div>
          )}

          {person.place_of_birth && (
            <div class="py-4 sm:pl-5">
              <p class="text-[10px] font-black uppercase tracking-[0.16em] text-zinc-600 mb-1">Place of Birth</p>
              <p class="text-sm font-semibold text-zinc-200">{person.place_of_birth}</p>
            </div>
          )}
        </div>

                <!-- Biography -->
                {person.biography && (
                  <div class="mt-10 pt-2 max-w-4xl">
                    <div class="flex items-center gap-3 mb-4">
                      <span class="w-1 h-7 rounded-full bg-red-600"></span>
                      <h2 class="text-2xl md:text-3xl font-black tracking-tight text-white">
                        Biography
                      </h2>
                    </div>

            <div>
              <div
                id="biography"
                class="text-zinc-400 leading-7 text-base md:text-lg whitespace-pre-wrap line-clamp-6"
              >
                {person.biography}
              </div>

              <div class="mt-4 flex gap-4">
                <button
                  id="biography-expand"
                  type="button"
                  class="text-sm font-bold text-red-500 hover:text-red-400 transition-colors cursor-pointer"
                >
                  Read more
                </button>

                <button
                  id="biography-contract"
                  type="button"
                  class="hidden text-sm font-bold text-red-500 hover:text-red-400 transition-colors cursor-pointer"
                >
                  Show less
                </button>
              </div>
            </div>
          </div>
        )}
      </div>
    </section>

    <!-- Filmography -->
    <section id="filmography" class="mt-16 md:mt-20 scroll-mt-6">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-7">
        <div>
          <div class="flex items-center gap-3">
            <span class="w-1 h-8 rounded-full bg-red-600"></span>
            <h2 class="text-3xl md:text-4xl font-black tracking-tight text-white">Filmography</h2>
          </div>
          <p class="mt-2 text-sm text-zinc-500">
            {person.all_credits} total credits
          </p>
          <nav aria-label="Credit categories" class="flex flex-wrap gap-x-5 gap-y-2 mt-4">
            {Object.entries(categoryLabels).map(([key, label]) => (
              <a
                href={`/person/${id}?category=${key}#filmography`}
                aria-current={selectedCategory === key ? "page" : undefined}
                class={`text-sm font-bold pb-1 border-b-2 transition-colors ${selectedCategory === key ? "text-red-500 border-red-600" : "text-zinc-400 border-transparent hover:text-white"}`}
              >
                {label} <span class="text-xs opacity-60">{person.credit_counts[key] ?? 0}</span>
              </a>
            ))}
          </nav>

          {(() => {
            const categoryTotal = person.credit_counts[selectedCategory] ?? 0;
            const categoryWatched = person.watched_credit_counts?.[selectedCategory] ?? 0;
            const categoryPercentage = categoryTotal > 0
              ? ((categoryWatched / categoryTotal) * 100).toFixed(1)
              : "0.0";

            return (
              <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-zinc-400">
                <p>
                  <span class="font-bold text-white">{categoryWatched}</span>
                  of {categoryTotal} {categoryLabels[selectedCategory].toLowerCase()} credits watched
                  <span class="text-zinc-600"> · </span>
                  <span>{categoryPercentage}%</span>
                </p>

                {person.imdb_highest && person.imdb_lowest && (
                  <p>
                    <span class="text-zinc-500">Average IMDb rating:</span>
                    <span class="font-bold text-white">
                      {person.imdb_highest.rating.toFixed(1)}
                    </span>
                    <span class="text-zinc-500"> highest</span>
                    <span class="text-zinc-600"> · </span>
                    <span class="font-bold text-white">
                      {person.imdb_lowest.rating.toFixed(1)}
                    </span>
                    <span class="text-zinc-500"> lowest</span>
                  </p>
                )}
              </div>
            );
          })()}

        </div>

        {totalPages > 1 && (
          <div id="credits-pagination-top" class="flex items-center gap-2">
            <button
              id="credits-prev-top"
              disabled
              class="px-3 py-2 text-sm rounded-lg bg-zinc-900 text-zinc-400 border border-zinc-800 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer hover:bg-zinc-800 transition-colors"
            >
              ←
            </button>
            <span id="credits-page-info-top" class="text-xs text-zinc-500 min-w-[72px] text-center">
              Page 1 of {totalPages}
            </span>
            <button
              id="credits-next-top"
              class="px-3 py-2 text-sm rounded-lg bg-zinc-900 text-zinc-400 border border-zinc-800 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer hover:bg-zinc-800 transition-colors"
            >
              →
            </button>
          </div>
        )}
      </div>

      <div
        id="credits-grid"
        class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-x-4 gap-y-8"
      >
        {credits.map((item) => (
          <div class="min-w-0">
            <MediaCard item={item as unknown as MediaItem} />
            {item.character && (
              <p
                title={item.character}
                class="mt-2 px-1 text-xs text-zinc-500 truncate"
              >
                {selectedCategory === "acting" ? "as " : ""}{item.character}
              </p>
            )}
          </div>
        ))}
      </div>

      {totalPages > 1 && (
        <div id="credits-pagination" class="flex items-center justify-center gap-3 mt-10">
          <button
            id="credits-prev"
            disabled
            class="px-4 py-2 text-sm rounded-lg bg-zinc-900 text-zinc-400 border border-zinc-800 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer hover:bg-zinc-800 transition-colors"
          >
            ← Prev
          </button>
          <span id="credits-page-info" class="text-sm text-zinc-400 min-w-[90px] text-center">
            Page 1 of {totalPages}
          </span>
          <button
            id="credits-next"
            class="px-4 py-2 text-sm rounded-lg bg-zinc-900 text-zinc-400 border border-zinc-800 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer hover:bg-zinc-800 transition-colors"
          >
            Next →
          </button>
        </div>
      )}
    </section>
  </div>
</Base>

{person.profile_path && (
  <div id="photo-modal" class="fixed inset-0 z-[999] flex items-center justify-center hidden" role="dialog" aria-modal="true">
    <div id="photo-modal-backdrop" class="absolute inset-0 bg-black/90 backdrop-blur-sm cursor-pointer"></div>
    <img
      src={person.profile_path}
      alt={person.name}
      class="relative max-h-[90vh] max-w-[85vw] md:max-w-[50vw] object-contain rounded-2xl shadow-2xl ring-1 ring-white/10"
    />
    <button
      id="photo-modal-close"
      class="absolute top-4 right-4 p-2 rounded-full bg-black/60 hover:bg-black/80 text-white/70 hover:text-white transition-all duration-200 cursor-pointer"
      aria-label="Close"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
)}

<script>
  const zoomBtn = document.getElementById('photo-zoom-btn');
  const modal = document.getElementById('photo-modal');
  const backdrop = document.getElementById('photo-modal-backdrop');
  const closeBtn = document.getElementById('photo-modal-close');

  if (zoomBtn && modal) {
    function openModal() {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }

    zoomBtn.addEventListener('click', openModal);
    backdrop?.addEventListener('click', closeModal);
    closeBtn?.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  }

  const biography = document.getElementById('biography');
  const biographyExpand = document.getElementById('biography-expand');
  const biographyContract = document.getElementById('biography-contract');

  if (biography && biographyExpand && biographyContract) {
    biographyExpand.addEventListener('click', () => {
      biography.classList.remove('line-clamp-6');
      biographyExpand.classList.add('hidden');
      biographyContract.classList.remove('hidden');
    });

    biographyContract.addEventListener('click', () => {
      biography.classList.add('line-clamp-6');
      biographyContract.classList.add('hidden');
      biographyExpand.classList.remove('hidden');

      biography.scrollIntoView({
        behavior: 'smooth',
        block: 'nearest'
      });
    });
  }
</script>

<script define:vars={{
  personId: person.tmdb_id,
  totalCredits: person.total_credits,
  pageSize: person.page_size,
  selectedCategory,
  creditCounts: person.credit_counts
}}>
  let activeCategory = selectedCategory;
  let currentPage = 1;
  let loading = false;
  let activeTotalCredits = totalCredits;

  const grid = document.getElementById('credits-grid');

  const prevBtn = document.getElementById('credits-prev');
  const nextBtn = document.getElementById('credits-next');
  const pageInfo = document.getElementById('credits-page-info');

  const prevTopBtn = document.getElementById('credits-prev-top');
  const nextTopBtn = document.getElementById('credits-next-top');
  const pageInfoTop = document.getElementById('credits-page-info-top');

  function getTotalPages() {
    return Math.max(1, Math.ceil(activeTotalCredits / pageSize));
  }

  function updatePagination() {
    const totalPages = getTotalPages();
    const pageText = 'Page ' + currentPage + ' of ' + totalPages;

    if (prevBtn) prevBtn.disabled = currentPage <= 1;
    if (nextBtn) nextBtn.disabled = currentPage >= totalPages;
    if (pageInfo) pageInfo.textContent = pageText;

    if (prevTopBtn) prevTopBtn.disabled = currentPage <= 1;
    if (nextTopBtn) nextTopBtn.disabled = currentPage >= totalPages;
    if (pageInfoTop) pageInfoTop.textContent = pageText;
  }

  function updateCategoryUI(category) {
    document.querySelectorAll<HTMLAnchorElement>(
      'nav[aria-label="Credit categories"] a'
    ).forEach((link) => {
      const href = new URL(link.href, window.location.origin);
      const linkCategory = href.searchParams.get('category');

      const active = linkCategory === category;

      link.setAttribute(
        'aria-current',
        active ? 'page' : ''
      );

      link.classList.toggle('text-red-500', active);
      link.classList.toggle('border-red-600', active);

      link.classList.toggle('text-zinc-400', !active);
      link.classList.toggle('border-transparent', !active);
    });

    const summary = document.querySelector(
      '#filmography p.mt-2'
    );

    if (summary) {
      const labels = {
        acting: 'Acting',
        directing: 'Directing',
        writing: 'Writing',
        producing: 'Producing',
        other: 'Other'
      };

      summary.textContent =
        `${Object.values(creditCounts).reduce((a, b) => a + b, 0)} total credits`;
    }
  }

  async function loadPage(page, category = activeCategory) {
    if (loading || !grid) return;

    loading = true;
    grid.style.opacity = '0.45';
    grid.style.pointerEvents = 'none';

    try {
      const res = await fetch(
        '/partials/person-credits?person_id=' +
        personId +
        '&page=' +
        page +
        '&category=' +
        encodeURIComponent(category)
      );

      if (!res.ok) return;

      const html = await res.text();
      const tmp = document.createElement('div');
      tmp.innerHTML = html;

      const wrapper = tmp.firstElementChild;
      if (!wrapper) return;

      grid.innerHTML = wrapper.innerHTML;

      activeCategory = category;
      activeTotalCredits = creditCounts[category] ?? 0;
      currentPage = page;

      updateCategoryUI(category);
      updatePagination();

      history.replaceState(
        null,
        '',
        `/person/${personId}?category=${encodeURIComponent(category)}#filmography`
      );

      grid.scrollIntoView({
        behavior: 'smooth',
        block: 'start'
      });
    } finally {
      grid.style.opacity = '';
      grid.style.pointerEvents = '';
      loading = false;
    }
  }

  prevBtn?.addEventListener('click', () => {
    if (currentPage > 1) {
      loadPage(currentPage - 1);
    }
  });

  nextBtn?.addEventListener('click', () => {
    if (currentPage < getTotalPages()) {
      loadPage(currentPage + 1);
    }
  });

  prevTopBtn?.addEventListener('click', () => {
    if (currentPage > 1) {
      loadPage(currentPage - 1);
    }
  });

  nextTopBtn?.addEventListener('click', () => {
    if (currentPage < getTotalPages()) {
      loadPage(currentPage + 1);
    }
  });

  updatePagination();
</script>