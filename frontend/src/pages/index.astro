---
import Base from "../layouts/Base.astro";
import MediaRow from "../components/MediaRow.astro";
import DashboardWatchlistCard from "../components/DashboardWatchlistCard.astro";
import UpNextCard from "../components/UpNextCard.astro";
import EpisodeCard from "../components/EpisodeCard.astro";
import ContinueWatchingCard from "../components/ContinueWatchingCard.astro";
import DashboardHeader from "../components/DashboardHeader.astro";
import UpcomingSchedule from "../components/UpcomingSchedule.astro";
import Last30Days from "../components/Last30Days.astro";
import GenreStrip from "../components/GenreStrip.astro";

import {
  api,
  type ContinueWatchingItem,
  type MediaItem,
  type WatchlistMovie,
  tmdbImageUrl,
} from "../lib/api";

const { token } = Astro.locals;

Astro.response.headers.set("Cache-Control", "private, no-cache");

const apiUrl =
  import.meta.env.PUBLIC_API_URL ??
  "http://localhost:8000";

// ----------------------------------------------------
// Settings
// ----------------------------------------------------

const settings = await api.auth.getSettings(token!);

const hasTmdbKey =
  !!settings?.has_effective_tmdb_key;

// ----------------------------------------------------
// Defaults
// ----------------------------------------------------

let recentMovies: { results: MediaItem[] } = {
  results: [],
};

let recentShows: { results: MediaItem[] } = {
  results: [],
};

let continueWatching: ContinueWatchingItem[] = [];

let nextUp: MediaItem[] = [];

let dashboardHero: any = null;

let upcomingSchedule: any[] = [];

let watchlist: WatchlistMovie[] = [];

let last30 = null;

let dashboardStats = {
  tv: {
    episodes: 0,
    shows: 0,
    minutes: 0,
  },
  movies: {
    plays: 0,
    movies: 0,
    minutes: 0,
  },
};

// ----------------------------------------------------
// Load dashboard
// ----------------------------------------------------

if (token) {

  const results = await Promise.allSettled([

    api.media.recentlyAdded("movie", token),

    api.media.recentlyAdded("episode", token),

    api.history.continueWatching(token),

    api.history.nextUp(token, 20),

    api.dashboard.stats(token),

    api.dashboard.hero(token),

    api.calendar.upcoming(token, 30),

    api.dashboard.watchlist(token),

    api.dashboard.last30(token),
    
  ]);

  if (results[0].status === "fulfilled") {
    recentMovies = results[0].value;
  }

  if (results[1].status === "fulfilled") {
    recentShows = results[1].value;
  }

  if (results[2].status === "fulfilled") {
    continueWatching =
      results[2].value?.continue_watching ?? [];
  }

  if (results[3].status === "fulfilled") {

    nextUp = results[3].value?.next_up ?? [];

  }

  if (results[4].status === "fulfilled") {
    dashboardStats = results[4].value;
  }

  if (results[5].status === "fulfilled") {
    dashboardHero = results[5].value;
  }

  if (results[6].status === "fulfilled") {
    upcomingSchedule = results[6].value?.episodes ?? [];
  }

  if (results[7].status === "fulfilled") {
    watchlist = results[7].value;
  }

  if (results[8].status === "fulfilled") {
    last30 = results[8].value;
  }

}

// ----------------------------------------------------
// Dashboard Hero
// ----------------------------------------------------

---

<Base title="Dashboard">

  <DashboardHeader
    posters={dashboardHero?.posters ?? []}
    stats={dashboardStats}
  />

  {!hasTmdbKey && (
    <div class="mb-12 p-8 bg-blue-600/10 border border-blue-600/20 rounded-2xl flex flex-col md:flex-row items-center gap-6 text-center md:text-left">
      <div class="w-16 h-16 bg-blue-600 rounded-2xl flex items-center justify-center text-3xl shrink-0 shadow-lg shadow-blue-600/20 text-zinc-100">
        🎬
      </div>
      <div class="flex-1">
        <h2 class="text-xl font-bold text-zinc-100 mb-1">Finish setting up your account</h2>
        <p class="text-zinc-400">To start using Scrob and explore movies and shows, you must add your TMDB Read Access Token.</p>
      </div>
      <a href="/settings" class="px-6 py-3 bg-blue-600 hover:bg-blue-500 text-zinc-100 font-bold rounded-xl transition-all shadow-lg shadow-blue-600/20 active:scale-95">
        Go to Settings
      </a>
    </div>
  )}

  {token && (
    <section class="mb-16">
      <div class="flex items-center justify-between mb-8">
        <h2 class="section-headline">Next Up</h2>

        <div class="flex items-center gap-4">
          <div class="flex items-center gap-2">
            <button
              type="button"
              id="next-up-prev"
              aria-label="Scroll left"
              class="w-9 h-9 flex items-center justify-center rounded-full bg-zinc-900 border border-zinc-800 text-zinc-300 hover:bg-zinc-800 hover:text-white transition disabled:opacity-30 disabled:cursor-not-allowed"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <button
              type="button"
              id="next-up-next"
              aria-label="Scroll right"
              class="w-9 h-9 flex items-center justify-center rounded-full bg-zinc-900 border border-zinc-800 text-zinc-300 hover:bg-zinc-800 hover:text-white transition disabled:opacity-30 disabled:cursor-not-allowed"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </button>
          </div>

          <a
            href="/progress"
            class="text-sm font-bold uppercase tracking-widest text-zinc-400 hover:text-blue-400 transition-all"
          >
            See All →
          </a>
        </div>
      </div>

      {nextUp.length > 0 ? (
        <div id="next-up-row" class="flex gap-5 overflow-x-auto pb-3 scrollbar-none">
          {nextUp.map((item) => (
            <div class="flex-shrink-0">
              <UpNextCard item={item} />
            </div>
          ))}
        </div>
      ) : (
        <p class="rounded-xl border border-zinc-800 bg-zinc-900/40 px-5 py-4 text-sm text-zinc-500">
          New episodes will appear here once they’ve aired.
        </p>
      )}
    </section>
  )}

  <UpcomingSchedule episodes={upcomingSchedule} />

  {watchlist.length > 0 && (
    <section id="watchlist" class="mb-16">

        <div class="flex items-center justify-between mb-8">
            <h2 class="section-headline">Watchlist</h2>

            <a
                href="/watchlist"
                class="text-sm font-bold uppercase tracking-widest text-zinc-400 hover:text-blue-400 transition"
            >
                See All →
            </a>
        </div>

        <div class="flex gap-10 overflow-x-auto pb-3 scrollbar-none -mx-6 px-6 md:mx-0 md:px-0">
            {watchlist.map((movie) => (
                <div class="flex-shrink-0 w-[210px]">
                    <DashboardWatchlistCard movie={movie} />
                </div>
            ))}
        </div>

    </section>
  )}

  <Last30Days data={last30} />

  <GenreStrip genres={last30?.genres ?? []} />

<script define:vars={{ token }}>

  function esc(str) {
          if (str == null) return '';
          return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
        }

  function tmdbImageUrl(path, size = 'w500') {
    if (!path) return null;
    if (path.startsWith('http://') || path.startsWith('https://')) {
      const m = /image\.tmdb\.org\/t\/p\/([^/]+)(\/.+)$/.exec(path);
      if (m) return `/api/proxy/media/image/${m[1]}${m[2]}`;
      return path;
    }
    return `/api/proxy/media/image/${size}${path.startsWith('/') ? path : '/' + path}`;
  }

  // ─────────────────────────────────────────────────────────────────────────

        function mediaCardHtml(item) {
          const isSeries = item.type === 'series';
          const href = isSeries
            ? `/show/${item.tmdb_id}`
            : `/media/${item.type}/${item.tmdb_id}`;
          const year = item.release_date ? item.release_date.slice(0, 4) : null;
          const rating = item.tmdb_rating ? Number(item.tmdb_rating).toFixed(1) : null;
          const raw = item.poster_path;
          const posterUrl = tmdbImageUrl(raw, 'w500');
          const typeLabel = isSeries ? 'Show' : 'Movie';
          const watched = item.watched ?? false;
          const inLists = item.in_lists ?? [];
          const inLibrary = item.in_library ?? false;
          const collectionPct = item.collection_pct ?? (inLibrary ? 100 : 0);
          const watchPct = item.watch_pct ?? (watched ? 100 : 0);
          const watchActive = isSeries ? watchPct > 0 : watched;
          const collectStyle = isSeries && collectionPct > 0
            ? `background: linear-gradient(to right, rgba(168,85,247,0.2) ${collectionPct}%, transparent ${collectionPct}%)`
            : '';
          const watchedFill = watched ? 'currentColor' : 'none';
          const collectedFill = 'none';

          return `<div
            class="flex-shrink-0 w-40 relative flex flex-col rounded-2xl overflow-hidden bg-zinc-900 border border-zinc-800"
            data-card
            data-tmdb-id="${esc(String(item.tmdb_id))}"
            data-media-type="${esc(item.type)}"
            data-show-tmdb-id=""
            data-season=""
          >
            <a href="${esc(href)}" class="block">
              <div class="aspect-[2/3] bg-zinc-950 relative overflow-hidden ring-1 ring-white/5"
                ${posterUrl
                  ? `<img src="${esc(posterUrl)}" alt="${esc(item.title)}" class="w-full h-full object-cover" loading="lazy" decoding="async" />`
                  : `<div class="w-full h-full flex flex-col items-center justify-center text-zinc-700 bg-zinc-900 p-4 text-center"><span class="text-3xl mb-2 opacity-30">🎬</span><span class="text-xs font-bold uppercase tracking-widest">${esc(item.title)}</span></div>`
                }
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
                ${rating ? `<div class="absolute top-2 left-2 bg-black/80 backdrop-blur-md text-yellow-400 text-[10px] font-black px-2 py-0.5 rounded-full shadow-lg border border-zinc-800 flex items-center gap-1"><span class="text-xs leading-none">★</span> ${esc(rating)}</div>` : ''}
              </div>
            </a>
            <div class="grid grid-cols-3 flex-shrink-0">
              <button data-action="watched" data-watched="${watched}" data-watch-pct="${watchPct}" data-state="${watchActive ? 'active' : 'inactive'}"
                title="${isSeries ? `${watchPct}% watched` : (watched ? 'Mark as unwatched' : 'Mark as watched')}"
                class="flex flex-col items-center justify-center gap-1 py-2.5 transition-all cursor-pointer border-r border-zinc-800/60 hover:brightness-125 ${watchActive ? 'bg-green-500/20 text-green-400' : 'bg-zinc-900 text-zinc-400 hover:bg-green-500/10 hover:text-green-500'}">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3" fill="${watchActive ? 'currentColor' : 'none'}"/>
                </svg>
                <span class="text-[8px] font-bold uppercase tracking-wider leading-none">${isSeries ? `${watchPct}%` : 'Watched'}</span>
              </button>
              <button data-action="list" data-in-lists="${esc(JSON.stringify(inLists))}" data-state="${inLists.length > 0 ? 'active' : 'inactive'}" title="Add to list"
                class="flex flex-col items-center justify-center gap-1 py-2.5 transition-all cursor-pointer border-r border-zinc-800/60 hover:brightness-125 ${inLists.length > 0 ? 'bg-sky-500/20 text-sky-400' : 'bg-zinc-900 text-zinc-400 hover:bg-sky-500/10 hover:text-sky-400'}">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/>
                  <line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
                </svg>
                <span class="text-[8px] font-bold uppercase tracking-wider leading-none">Lists</span>
              </button>
              <button data-action="collected" data-in-library="${inLibrary}" data-collection-pct="${collectionPct}" data-state="${(inLibrary || collectionPct > 0) ? 'active' : 'inactive'}"
                title="${isSeries ? `${collectionPct}% in library` : (inLibrary ? 'In collection' : 'Add to collection')}"
                style="${esc(collectStyle)}"
                class="relative flex flex-col items-center justify-center gap-1 py-2.5 transition-all cursor-pointer overflow-hidden hover:brightness-125 ${(inLibrary || collectionPct > 0) ? 'bg-purple-500/20 text-purple-400' : 'bg-zinc-900 text-zinc-400 hover:bg-purple-500/10 hover:text-purple-400'}">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="${collectedFill}" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"/>
                  <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
                  <path d="M15 22v-4a3 3 0 0 0-6 0v4"/>
                  <path d="M2 7h20"/>
                </svg>
                <span class="text-[8px] font-bold uppercase tracking-wider leading-none">${isSeries ? `${collectionPct}%` : 'Collected'}</span>
              </button>
            </div>
            <a href="${esc(href)}" class="block p-3 bg-gradient-to-b from-zinc-900 to-zinc-950 flex-1">
              <h3 class="text-sm font-bold text-zinc-100 truncate leading-tight mb-1">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  ${year ? `<span class="text-[11px] font-medium text-zinc-500 tracking-wide">${esc(year)}</span>` : ''}
                </div>
                <span class="text-[9px] font-black text-zinc-400 uppercase tracking-widest px-1.5 py-0.5 bg-zinc-800/50 rounded border border-zinc-800">${typeLabel}</span>
              </div>
            </a>
          </div>`;
        }

        function episodeCardHtml(item) {
          const isSeries = item.type === 'series';
          const href = item.show_tmdb_id && item.season_number != null && item.episode_number != null
            ? `/show/${item.show_tmdb_id}/season/${item.season_number}/${item.episode_number}`
            : isSeries
              ? `/show/${item.tmdb_id}`
              : `/media/${item.type}/${item.tmdb_id}`;
          const raw = isSeries ? (item.backdrop_path ?? item.poster_path) : item.poster_path;
          const imageUrl = tmdbImageUrl(raw, 'w780');
          const sxe = item.season_number != null && item.episode_number != null
            ? `S${String(item.season_number).padStart(2, '0')}E${String(item.episode_number).padStart(2, '0')}`
            : null;

          return `<a href="${esc(href)}" class="flex-shrink-0 w-56 relative block rounded-2xl overflow-hidden bg-zinc-900 border border-zinc-800 transition-all duration-300 active:scale-95 active:opacity-70">
            <div class="aspect-[3/2] bg-zinc-950 relative overflow-hidden ring-1 ring-white/5">
              ${imageUrl
                ? `<img src="${esc(imageUrl)}" alt="${esc(item.show_title ?? item.title)}" class="w-full h-full object-cover" loading="lazy" decoding="async" />`
                : `<div class="w-full h-full flex flex-col items-center justify-center p-4 text-center bg-[#18181b]"><span class="text-3xl mb-2 opacity-30">📺</span><span class="text-xs font-bold uppercase tracking-widest text-[#52525b]">${esc(item.show_title ?? item.title)}</span></div>`
              }
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
              ${sxe ? `<div class="absolute top-2 left-2 bg-blue-600/90 backdrop-blur-md text-white text-[10px] font-black px-2 py-0.5 rounded-full shadow-lg border border-blue-500/30">${esc(sxe)}</div>` : ''}
              <div class="absolute bottom-0 left-0 right-0 p-3">
                ${item.show_title ? `<p class="text-[11px] font-bold text-white/70 truncate leading-tight">${esc(item.show_title)}</p>` : ''}
                <h3 class="text-sm font-bold text-white truncate leading-tight">${esc(item.title)}</h3>
              </div>
            </div>
          </a>`;
        }

        async function loadSection(url, gridId, renderFn, limit) {
          const grid = document.getElementById(gridId);
          if (!grid) return;
          try {
            const res = await fetch(url, {
              headers: { 'Authorization': `Bearer ${token}` },
            });
            if (!res.ok) {
              grid.closest('section').remove();
              return;
            }
            const data = await res.json();
            const items = (data.results ?? []).slice(0, limit);
            if (items.length === 0) {
              grid.closest('section').remove();
              return;
            }
            grid.innerHTML = items.map(renderFn).join('');
          } catch {
            grid.closest('section').remove();
          }
        }

        loadSection('/api/proxy/media/trending/movies', 'grid-trending-movies', mediaCardHtml, 12);
        loadSection('/api/proxy/media/trending/shows', 'grid-trending-shows', mediaCardHtml, 12);
        const userTimezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
        loadSection(`/api/proxy/media/airing-today/collected?timezone=${encodeURIComponent(userTimezone)}`, 'grid-airing-today', episodeCardHtml, 12);

        // Continue watching dismiss
        document.addEventListener('click', async (e) => {
          const btn = e.target.closest('.dismiss-cw');
          if (!btn) return;
          e.preventDefault();
          e.stopPropagation();
          const mediaId = btn.dataset.mediaId;
          const card = btn.closest('.flex-shrink-0');
          if (card) card.style.opacity = '0.4';
          try {
            await fetch(`/api/proxy/history/continue-watching?media_id=${mediaId}`, {
              method: 'DELETE',
              headers: { 'Authorization': `Bearer ${token}` },
            });
            card?.remove();
            const section = document.getElementById('continue-watching-section');
            if (section && section.querySelectorAll('.dismiss-cw').length === 0) {
              section.remove();
            }
          } catch {
            if (card) card.style.opacity = '';
          }
        });
</script>      

<script>
  const row = document.getElementById('next-up-row');
  const prev = document.getElementById('next-up-prev') as HTMLButtonElement | null;
  const next = document.getElementById('next-up-next') as HTMLButtonElement | null;

  if (row && prev && next) {
    const arrows = prev.parentElement as HTMLElement;

    // Scroll by whole cards, leaving one card of overlap so you keep your place
    const step = () => {
      const first = row.firstElementChild as HTMLElement | null;
      const gap = parseFloat(getComputedStyle(row).columnGap) || 20;
      const cardWidth = (first?.getBoundingClientRect().width ?? 270) + gap;
      const cardsPerPage = Math.max(1, Math.floor(row.clientWidth / cardWidth) - 1);
      return cardsPerPage * cardWidth;
    };

    const update = () => {
      const max = row.scrollWidth - row.clientWidth;
      arrows.style.display = max > 2 ? '' : 'none';
      prev.disabled = row.scrollLeft <= 2;
      next.disabled = row.scrollLeft >= max - 2;
    };

    prev.addEventListener('click', () => row.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => row.scrollBy({ left: step(), behavior: 'smooth' }));
    row.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>
