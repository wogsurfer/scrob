---
import Base from "../layouts/Base.astro";
import HistoryCard from "../components/HistoryCard.astro";
import Pagination from "../components/Pagination.astro";
import { api, tmdbImageUrl, type WatchEvent } from "../lib/api";

const { token } = Astro.locals;
Astro.response.headers.set("Cache-Control", "private, no-cache");
const page = Number(Astro.url.searchParams.get("page") || 1);
const type = Astro.url.searchParams.get("type") || undefined;
const use24h = Astro.cookies.get("time_format_24h")?.value === "true";
const isShows = type === "show";

const history = await api.history.list({ page, page_size: 40, type } as any, token);

// Shows tab: one entry per show, already ordered by last watched
const shows: any[] = isShows ? history.results : [];

const fmtTime = (iso: string | null) =>
  iso
    ? new Date(iso + "Z").toLocaleTimeString("en-US", {
        hour: "2-digit",
        minute: "2-digit",
        hour12: !use24h,
      })
    : "";

// Shows tab: group by the day each show was last watched
const groupedShows: Record<string, any[]> = {};
for (const show of shows) {
  const dateStr = show.last_watched_at
    ? new Date(show.last_watched_at + "Z").toLocaleDateString("en-US", {
        weekday: "long",
        month: "long",
        day: "numeric",
        year: "numeric",
      })
    : "Date unknown";
  (groupedShows[dateStr] ??= []).push(show);
}
const showDates = Object.keys(groupedShows);

// Grouping logic (All / Movies / Episodes tabs)
const groupedHistory: Record<string, WatchEvent[]> = isShows
  ? {}
  : history.results.reduce<Record<string, WatchEvent[]>>((acc, event) => {
      const dateStr = event.watched_at
        ? new Date(event.watched_at + 'Z').toLocaleDateString('en-US', {
            weekday: 'long',
            month: 'long',
            day: 'numeric',
            year: 'numeric'
          })
        : 'Date unknown';

      if (!acc[dateStr]) {
        acc[dateStr] = [];
      }
      acc[dateStr].push(event);
      return acc;
    }, {});

const dates = Object.keys(groupedHistory);

const baseUrl = `/history${type ? `?type=${type}` : ""}`;

const tabClass = (active: boolean) =>
  `px-4 py-1.5 rounded-full text-sm font-medium transition active:scale-95 active:opacity-70 ${active ? 'bg-zinc-100 text-zinc-900' : 'bg-zinc-800 text-zinc-400 hover:text-zinc-100'}`;
---

<Base title="Watch History">
  <div>
    <h1 class="page-title mb-8">Watch History</h1>

    <div class="flex gap-3 mb-8">
      <a href="/history" class={tabClass(!type)}>All</a>
      <a href="/history?type=movie" class={tabClass(type === 'movie')}>Movies</a>
      <a href="/history?type=episode" class={tabClass(type === 'episode')}>Episodes</a>
      <a href="/history?type=show" class={tabClass(type === 'show')}>Shows</a>
    </div>

        {isShows ? (
          showDates.length === 0 ? (
            <div class="bg-zinc-900/50 rounded-2xl p-12 text-center">
              <div class="text-zinc-500 mb-2">No shows watched yet</div>
              <a href="/" class="text-blue-500 hover:text-blue-400 font-medium transition-colors">Go discover something</a>
            </div>
          ) : (
            <div class="space-y-10">
              {showDates.map((date) => (
                <div class="relative">
                  <h2 class="group-label mb-4 sticky-top-safe py-2 z-10 border-b border-zinc-800/50">
                    {date}
                  </h2>
                  <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-5 gap-x-5 gap-y-10 items-start">
                    {groupedShows[date].map((show) => (
                      <a
                        href={show.tmdb_id ? `/show/${show.tmdb_id}` : `/show/tvdb/${show.tvdb_id}`}
                        class="group block"
                      >
                        <div class="aspect-[2/3] rounded-2xl overflow-hidden bg-zinc-900 border border-zinc-800 ring-1 ring-white/5">
                          {show.poster_path ? (
                            <img
                              src={tmdbImageUrl(show.poster_path, "w342")}
                              alt={show.title}
                              class="w-full h-full object-cover transition duration-300 group-hover:scale-[1.03]"
                              loading="lazy"
                            />
                          ) : (
                            <div class="w-full h-full flex items-center justify-center p-4 text-center text-xs font-bold uppercase tracking-widest text-zinc-600">
                              {show.title}
                            </div>
                          )}
                        </div>
                        <div class="mt-3">
                          <div class="text-xs text-zinc-500 font-medium">{fmtTime(show.last_watched_at)}</div>
                          <h3 class="text-base font-bold text-zinc-100 truncate mt-0.5">{show.title}</h3>
                          <div class="text-sm text-zinc-400">
                            {show.episodes_watched} {show.episodes_watched === 1 ? "episode" : "episodes"} watched
                          </div>
                        </div>
                      </a>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          )
        ) : dates.length === 0 ? (
      <div class="bg-zinc-900/50 rounded-2xl p-12 text-center">
        <div class="text-zinc-500 mb-2">No history yet</div>
        <a href="/" class="text-blue-500 hover:text-blue-400 font-medium transition-colors">Go discover something</a>
      </div>
    ) : (
      <div class="space-y-10">
        {dates.map((date) => (
          <div class="relative">
            <h2 class="group-label mb-4 sticky-top-safe py-2 z-10 border-b border-zinc-800/50">
              {date}
            </h2>
            <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-5 gap-x-5 gap-y-10 items-start">
              {groupedHistory[date].map((event) => (
                <HistoryCard event={event} use24h={use24h} />
              ))}
            </div>
          </div>
        ))}
      </div>
    )}

    <Pagination currentPage={page} totalPages={history.total_pages} baseUrl={baseUrl} />
  </div>
</Base>

<script>
</script>