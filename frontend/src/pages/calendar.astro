---
import Base from "../layouts/Base.astro";
import { api } from "../lib/api";
import EpisodeBadge from "../components/EpisodeBadge.astro";
import watchdIconWhite from "../assets/watchd-icon-white.png";
import watchdIconRed from "../assets/watchd-icon-red.png";

const { token } = Astro.locals;

Astro.response.headers.set("Cache-Control", "private, no-cache");

const WEEKS = 5;
const DAY_MS = 86400000;

let data: Awaited<ReturnType<typeof api.calendar.upcoming>> = { days: 0, episodes: [] };
let error = "";

try {
  data = await api.calendar.upcoming(token, WEEKS * 7, true);
} catch (e: unknown) {
  error = e instanceof Error ? e.message : "Failed to load calendar";
}

// Dates are handled as UTC midnights of the calendar day the backend uses,
// so "today" matches the schedule's own day boundaries.
const iso = (d: Date) => d.toISOString().slice(0, 10);
const parse = (s: string) => new Date(`${s}T00:00:00Z`);
const today = parse(data.today ?? data.start_date ?? iso(new Date()));
const todayIso = iso(today);
const weekStart = new Date(today.getTime() - ((today.getUTCDay() + 6) % 7) * DAY_MS);

// One card per show per day: back-to-back episodes of the same season are
// grouped ("S01E05–06").
interface Card {
  showTitle: string;
  season: number;
  first: number;
  last: number;
  titles: string[];
  time: string | null;
  runtime: number | null;
  poster: string | null;
  badge: string | null;
  watched: boolean;
  href: string | null;
}

// Small TMDB posters for the thumbnails.
const thumb = (url: string | null | undefined) => (url ? url.replace("/t/p/w500/", "/t/p/w185/").replace("/t/p/original/", "/t/p/w185/") : null);

const byDay = new Map<string, Card[]>();
for (const ep of data.episodes ?? []) {
  if (ep.season == null || ep.episode == null) continue;
  const cards = byDay.get(ep.air_date) ?? [];
  const prev = cards.find((c) => c.showTitle === ep.show_title && c.season === ep.season && c.last === ep.episode! - 1);
  if (prev) {
    prev.last = ep.episode;
    prev.titles.push(ep.title ?? "");
    prev.watched = prev.watched && !!ep.watched;
    prev.badge = prev.badge ?? ep.badge ?? null;
    prev.href = ep.show_tmdb_id ? `/show/${ep.show_tmdb_id}/season/${ep.season}` : null;
  } else {
    cards.push({
      showTitle: ep.show_title ?? "Unknown show",
      season: ep.season,
      first: ep.episode,
      last: ep.episode,
      titles: [ep.title ?? ""],
      time: ep.air_time ?? null,
      runtime: ep.runtime,
      poster: thumb(ep.season_poster_path || ep.show_poster_path || ep.poster_path),
      badge: ep.badge ?? null,
      watched: !!ep.watched,
      href: ep.show_tmdb_id ? `/show/${ep.show_tmdb_id}/season/${ep.season}/${ep.episode}` : null,
    });
  }
  byDay.set(ep.air_date, cards);
}

// Film releases: one card per film, release kind and day.
type Release = NonNullable<typeof data.movies>[number];
const filmsByDay = new Map<string, Release[]>();
for (const m of data.movies ?? []) {
  filmsByDay.set(m.date, [...(filmsByDay.get(m.date) ?? []), m]);
}

const pad = (n: number) => String(n).padStart(2, "0");
const code = (c: Card) => `S${pad(c.season)}E${pad(c.first)}${c.last > c.first ? `–${pad(c.last)}` : ""}`;
const isTba = (t: string) => !t || /^(tba|tbd|episode \d+)$/i.test(t.trim());
const subtitle = (c: Card) => (c.last > c.first ? `${c.last - c.first + 1} episodes` : isTba(c.titles[0]) ? "Title TBA" : c.titles[0]);
const episodeCount = (c: Card) => c.last - c.first + 1;

const fmt = (d: Date, opts: Intl.DateTimeFormatOptions) => d.toLocaleDateString("en-GB", { timeZone: "UTC", ...opts });

const weeks = Array.from({ length: WEEKS }, (_, w) => {
  const start = new Date(weekStart.getTime() + w * 7 * DAY_MS);
  const days = Array.from({ length: 7 }, (_, d) => {
    const date = new Date(start.getTime() + d * DAY_MS);
    const key = iso(date);
    const cards = byDay.get(key) ?? [];
    const films = filmsByDay.get(key) ?? [];
    return { key, date, cards, films, empty: !cards.length && !films.length, past: key < todayIso, today: key === todayIso };
  });
  const end = days[6].date;
  const range = start.getUTCMonth() === end.getUTCMonth()
    ? `${start.getUTCDate()}–${fmt(end, { day: "numeric", month: "long" })}`
    : `${fmt(start, { day: "numeric", month: "short" })} – ${fmt(end, { day: "numeric", month: "short" })}`;
  const label = w === 0 ? "This week" : w === 1 ? "Next week" : `Week of ${fmt(start, { day: "numeric", month: "long" })}`;
  const count = days.reduce((n, d) => n + d.cards.reduce((m, c) => m + episodeCount(c), 0), 0);
  const filmCount = days.reduce((n, d) => n + d.films.length, 0);
  return { label, range, days, count, filmCount };
});

const total = weeks.reduce((n, w) => n + w.count, 0);
const filmTotal = weeks.reduce((n, w) => n + w.filmCount, 0);
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
const summary = (episodes: number, films: number) =>
  [episodes ? plural(episodes, "episode", "episodes") : null, films ? plural(films, "film release", "film releases") : null]
    .filter(Boolean).join(" · ");
---

<Base title="Calendar">
  <div class="cal">
    <header class="cal-head">
      <div>
        <h1 class="text-3xl font-black text-zinc-100 tracking-tighter uppercase">Calendar</h1>
        <p class="cal-sub">Episodes from shows you're watching, and release dates for films you follow</p>
      </div>
      {total + filmTotal > 0 && <p class="cal-total">{summary(total, filmTotal)} over {WEEKS} weeks</p>}
    </header>

    {error && <div class="cal-error">{error}</div>}

    {!error && total + filmTotal === 0 && (
      <div class="cal-empty">
        <p class="cal-empty-title">Nothing upcoming</p>
        <p>There are no episodes or film releases this week or in the next {WEEKS - 1} weeks.</p>
      </div>
    )}

    {total + filmTotal > 0 && weeks.map((week) => (
      <section class="cal-week">
        <div class="cal-week-head">
          <h2>{week.label}</h2>
          <span>{week.range}</span>
          <span class="cal-week-count">{summary(week.count, week.filmCount) || "Nothing scheduled"}</span>
        </div>

        <div class="cal-grid">
          {week.days.map((day) => (
            <div class:list={["cal-day", { past: day.past, today: day.today, empty: day.empty }]}>
              <div class="cal-day-head">
                <span class="cal-dow">{day.today ? "Today" : fmt(day.date, { weekday: "short" })}</span>
                <span class="cal-dom">{day.date.getUTCDate()}</span>
              </div>

              <div class="cal-day-cards">
                {day.cards.map((card) => {
                  const Tag = card.href ? "a" : "div";
                  return (
                    <Tag href={card.href ?? undefined} class:list={["cal-card", { watched: card.watched }]}>
                      <div class="cal-poster">
                        {card.poster ? <img src={card.poster} alt="" loading="lazy" decoding="async" /> : <span>{card.showTitle.slice(0, 1)}</span>}
                        <img
                          class="cal-w"
                          src={card.watched ? watchdIconRed.src : watchdIconWhite.src}
                          alt={card.watched ? "Watched" : "Not watched"}
                          title={card.watched ? "Watched" : "Not watched yet"}
                        />
                      </div>
                      <div class="cal-info">
                        <EpisodeBadge label={card.badge} class="cal-badge" />
                        <p class="cal-show" title={card.showTitle}>{card.showTitle}</p>
                        <p class="cal-ep" title={card.titles.filter((t) => !isTba(t)).join(" · ")}>
                          <span class="cal-code">{code(card)}</span>
                          <span class:list={["cal-title", { tba: episodeCount(card) === 1 && isTba(card.titles[0]) }]}>{subtitle(card)}</span>
                        </p>
                        <p class="cal-meta">
                          {[card.time, card.runtime ? `${card.runtime * episodeCount(card)} min` : null].filter(Boolean).join(" · ")}
                        </p>
                      </div>
                    </Tag>
                  );
                })}
                {day.films.map((film) => (
                  <a href={`/media/movie/${film.tmdb_id}`} class:list={["cal-card", "cal-film", { watched: film.watched }]}>
                    <div class="cal-poster">
                      {film.poster_path ? <img src={thumb(film.poster_path)} alt="" loading="lazy" decoding="async" /> : <span>{(film.title ?? "?").slice(0, 1)}</span>}
                      {film.watched && <img class="cal-w" src={watchdIconRed.src} alt="Watched" title="Watched" />}
                    </div>
                    <div class="cal-info">
                      <span class:list={["cal-release", `cal-release-${film.kind}`]}>{film.label}</span>
                      <p class="cal-show" title={film.title ?? ""}>{film.title}</p>
                      <p class="cal-meta">{["Film", film.country].filter(Boolean).join(" · ")}</p>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>

<style>
  .cal-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 8px 24px; margin-bottom: 2rem; }
  .cal-sub { margin-top: 4px; color: #a1a1aa; font-size: 14px; }
  .cal-total { color: #71717a; font-size: 13px; font-weight: 700; }
  .cal-error { padding: 16px; border: 1px solid rgba(239, 68, 68, .4); border-radius: 12px; color: #fca5a5; }
  .cal-empty { padding: 48px 16px; text-align: center; color: #71717a; border: 1px dashed #27272a; border-radius: 16px; }
  .cal-empty-title { color: #e4e4e7; font-weight: 800; font-size: 18px; margin-bottom: 4px; }

  .cal-week + .cal-week { margin-top: 3rem; }
  .cal-week-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; margin-bottom: 14px; }
  .cal-week-head h2 { font-size: 20px; font-weight: 900; letter-spacing: -.02em; color: #f4f4f5; text-transform: uppercase; }
  .cal-week-head span { color: #71717a; font-size: 13px; font-weight: 700; }
  .cal-week-count { margin-left: auto; }

  /* Monday to Sunday across the page. */
  .cal-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 8px; }
  .cal-day { min-height: 150px; padding: 8px; border-radius: 14px; background: #0a0a0a; border: 1px solid #1c1c1f; display: flex; flex-direction: column; gap: 6px; }
  /* Days already gone this week: the date fades, the episodes stay readable. */
  .cal-day.past .cal-day-head { opacity: .45; }
  .cal-day.past .cal-card { opacity: .75; }
  .cal-day.past.empty { opacity: .45; }
  .cal-day.today { border-color: rgba(229, 9, 20, .55); background: linear-gradient(180deg, rgba(229, 9, 20, .08), #0a0a0a 120px); }
  .cal-day-head { display: flex; align-items: baseline; justify-content: space-between; padding: 2px 4px 4px; }
  .cal-dow { font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #71717a; }
  .cal-dom { font-size: 18px; font-weight: 900; color: #d4d4d8; }
  .cal-day.today .cal-dow, .cal-day.today .cal-dom { color: #f87171; }
  .cal-day-cards { display: flex; flex-direction: column; gap: 6px; min-width: 0; }

  .cal-card { position: relative; display: flex; gap: 8px; padding: 6px; border-radius: 10px; background: #141416; border: 1px solid #222225; color: inherit; text-decoration: none; transition: border-color .15s, background .15s; }
  a.cal-card:hover { border-color: #3f3f46; background: #18181b; }
  .cal-card.watched .cal-poster > img:first-child { filter: grayscale(.6) brightness(.7); }
  .cal-poster { position: relative; flex: none; width: 40px; aspect-ratio: 2 / 3; border-radius: 6px; overflow: hidden; background: #27272a; display: grid; place-items: center; color: #71717a; font-weight: 900; }
  .cal-poster > img:first-child { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cal-info { min-width: 0; flex: 1; }
  .cal-info :global(.cal-badge) { margin-bottom: 3px; }
  .cal-show { font-size: 13px; font-weight: 800; color: #f4f4f5; line-height: 1.2; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .cal-ep { margin-top: 2px; font-size: 11.5px; line-height: 1.3; color: #a1a1aa; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .cal-code { font-weight: 800; color: #ef4444; margin-right: 4px; }
  .cal-title.tba { color: #52525b; font-style: italic; }
  .cal-meta { margin-top: 3px; font-size: 10.5px; font-weight: 700; color: #71717a; }
  .cal-w { position: absolute; right: 2px; bottom: 2px; width: 15px; height: 15px; object-fit: contain; filter: drop-shadow(0 1px 2px rgba(0, 0, 0, .9)); }

  /* Film releases: the kind of release as a tag, in colours apart from the
     episode labels. */
  .cal-release { display: inline-block; max-width: 100%; margin-bottom: 3px; padding: 1px 7px; border-radius: 4px; border: 1px solid; font-size: 9px; font-weight: 800; letter-spacing: .08em; line-height: 1.5; text-transform: uppercase; }
  .cal-release-disc { color: #f4f4f5; background: rgba(244, 244, 245, .12); border-color: rgba(244, 244, 245, .45); }
  .cal-release-cinema { color: #fb923c; background: rgba(249, 115, 22, .14); border-color: rgba(249, 115, 22, .5); }
  .cal-release-digital { color: #2dd4bf; background: rgba(20, 184, 166, .14); border-color: rgba(20, 184, 166, .5); }
  .cal-release-streaming { color: #a3e635; background: rgba(132, 204, 22, .13); border-color: rgba(132, 204, 22, .45); }
  :global(html.light) .cal-release-disc { color: #27272a; background: rgba(39, 39, 42, .06); border-color: rgba(39, 39, 42, .35); }
  :global(html.light) .cal-release-cinema { color: #c2410c; }
  :global(html.light) .cal-release-digital { color: #0f766e; }
  :global(html.light) .cal-release-streaming { color: #4d7c0f; }

  /* Narrower screens: one row per day, with past and empty days hidden. */
  @media (max-width: 1023px) {
    .cal-grid { grid-template-columns: minmax(0, 1fr); gap: 6px; }
    .cal-day { min-height: 0; flex-direction: row; align-items: flex-start; gap: 10px; }
    .cal-day.empty { display: none; }
    .cal-day-head { flex: none; width: 40px; flex-direction: column; align-items: center; gap: 2px; padding: 4px 0; }
    .cal-day-cards { flex: 1; }
  }

  :global(html.light) .cal-day { background: #fafafa; border-color: #e4e4e7; }
  :global(html.light) .cal-day.today { background: linear-gradient(180deg, rgba(229, 9, 20, .06), #fafafa 120px); }
  :global(html.light) .cal-card { background: #fff; border-color: #e4e4e7; }
  :global(html.light) .cal-show, :global(html.light) .cal-week-head h2 { color: #18181b; }
  :global(html.light) .cal-dom { color: #3f3f46; }
</style>
