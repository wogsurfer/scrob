---
import Base from "../../layouts/Base.astro";
import MediaRow from "../../components/MediaRow.astro";
import SeasonCard from "../../components/SeasonCard.astro";
import NetworkLogo from "../../components/NetworkLogo.astro";
import AwardsList from "../../components/AwardsList.astro";
import ActionStack from "../../components/ActionStack.astro";
import EpisodeOrderSelector from "../../components/EpisodeOrderSelector.astro";
import CrewSection from "../../components/CrewSection.astro";
import { api, type Show } from "../../lib/api";
export const prerender = false;

const { id } = Astro.params;
const { token } = Astro.locals;
Astro.response.headers.set("Cache-Control", "private, no-cache");

let show: Show | null = null;
let error = "";

try {
  show = await api.shows.get(Number(id), token);
} catch (e: any) {
  error = e.message;
}

let hasTvdbKey = false;
try {
  const settings = await api.auth.getSettings(token!);
  hasTvdbKey = !!settings?.has_effective_tvdb_key;
} catch {}

if (!show && !error) {
    return Astro.redirect("/404");
}

const seasons = Object.entries(show?.seasons ?? {}).sort(
  ([a], [b]) => Number(a.replace("season_", "")) - Number(b.replace("season_", ""))
);

const year = show?.first_air_date?.slice(0, 4) ?? null;
const isFinished = show?.status === "Ended" || show?.status === "Canceled";
const rating = show?.tmdb_rating ? show.tmdb_rating.toFixed(1) : null;
const fmtRating = (n: number) => (Number.isInteger(n) ? String(n) : n.toFixed(1));
const userRated = show?.user_rating != null;
const langNames = new Intl.DisplayNames(["en"], { type: "language" });
const originalLanguage = show?.original_language
  ? langNames.of(show.original_language) ?? show.original_language
  : null;
// Seasons grid: newest first, Specials last.
const seasonCards = [
  ...(show?.seasons_meta
    ?? seasons.map(([k]) => ({ season_number: Number(k.replace("season_", "")), name: `Season ${k.replace("season_", "")}`, overview: null, poster_path: null, episode_count: 0, air_date: null }))),
].sort((a, b) => (a.season_number === 0 ? 1 : b.season_number === 0 ? -1 : b.season_number - a.season_number));

const seasonCount =
  show?.seasons_meta?.filter((s) => s.season_number > 0).length || seasons.length;
const episodeCount =
  show?.seasons_meta
    ?.filter((s) => s.season_number > 0)
    .reduce((total, s) => total + (s.episode_count || 0), 0)
  || Object.values(show?.seasons ?? {}).reduce((total, episodes) => total + episodes.length, 0);
---

<Base title={show?.title || "Show Details"}>
  {error && !show && (
    <div class="max-w-md mx-auto mt-20 text-center">
        <div class="bg-red-500/10 border border-red-500/20 text-red-500 p-6 rounded-2xl mb-6">
            <p class="font-bold text-lg mb-2">Oops!</p>
            <p class="text-sm opacity-80">{error}</p>
        </div>
        <a href="/" class="text-blue-500 hover:underline">Return to Dashboard</a>
    </div>
  )}

  {show && (
    <div class="relative">
      <!-- Backdrop -->
      {show.backdrop_path && (
        <div class="absolute -top-8 left-1/2 -translate-x-1/2 w-screen h-[600px] overflow-hidden" data-adult-backdrop={show.adult ? "true" : undefined}>
          <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/40 to-transparent z-10"></div>
          <img
            src={show.backdrop_path}
            alt=""
            class="w-full h-full object-cover opacity-50 blur-[1px]"
            loading="eager"
            decoding="async"
          />
        </div>
      )}

      <div class="relative z-20">
        {show.id && (
                <div class="absolute top-0 right-0">
                  <button
                    id="refresh-metadata-btn"
                    class="flex items-center gap-2 px-4 py-2 text-sm font-bold text-zinc-400 hover:text-zinc-100 bg-zinc-900/60 hover:bg-zinc-800/80 border border-zinc-800 hover:border-zinc-700 rounded-xl transition-all duration-200 cursor-pointer"
                  >
                    <svg id="refresh-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
                      <path d="M21 3v5h-5"/>
                      <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
                      <path d="M8 16H3v5"/>
                    </svg>
                    <span id="refresh-label">Refresh Metadata</span>
                  </button>
                </div>
              )}
        <nav class="flex items-center gap-2 text-sm text-zinc-400 mb-8 overflow-hidden whitespace-nowrap">
          <a href="/shows" class="hover:text-zinc-100 transition shrink-0">Shows</a>
          <span class="text-zinc-700">/</span>
          <span class="text-zinc-100 font-bold truncate">{show.title}</span>
        </nav>

        <div class="flex flex-col md:flex-row gap-8 lg:gap-12">
          <!-- Poster -->
          <div class="w-64 shrink-0 mx-auto md:mx-0">
            <div class="aspect-[2/3] rounded-2xl overflow-hidden shadow-2xl border border-zinc-800 bg-zinc-900 ring-1 ring-white/10 relative" data-adult={show.adult ? "true" : undefined}>
              {show.poster_path ? (
                <button id="poster-zoom-btn" class="w-full h-full group/poster block cursor-zoom-in" aria-label={`Enlarge poster for ${show.title}`}>
                  <img
                    src={show.poster_path}
                    alt={show.title}
                    class="w-full h-full object-cover transition-transform duration-300 group-hover/poster:scale-105"
                    loading="eager"
                    decoding="async"
                  />

                  <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover/poster:opacity-100 transition-opacity duration-200 bg-black/30">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-8 h-8 text-white drop-shadow-lg">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607ZM10.5 7.5v6m3-3h-6" />
                    </svg>
                  </div>
                </button>
              ) : (
                <div class="w-full h-full flex flex-col items-center justify-center text-zinc-400 p-4 text-center">
                  <span class="text-4xl mb-2">📺</span>
                  <span class="text-sm font-medium">No Poster Available</span>
                </div>
              )}
            </div>
            {show.genres?.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-4 mb-4">
              {show.genres.map(g => (
                <span class="px-3 py-1.5 bg-zinc-900/40 border border-zinc-800/50 rounded-xl text-zinc-400 text-[11px] font-black uppercase tracking-widest text-center">
                  {g}
                </span>
              ))}
            </div>
          )}
        </div>

          <!-- Info -->
          <div class="flex-1 action-stack-host min-w-0 pt-2">
            <h1 class="text-4xl md:text-6xl font-black text-zinc-100 mb-3 tracking-tight leading-none">
              {show.title}
            </h1>

            {show.tagline && (
              <p class="text-xl italic text-zinc-400 mb-8 font-light leading-relaxed">"{show.tagline}"</p>
            )}

            <div class="flex flex-wrap items-center gap-3 mb-0">
              <div class="flex flex-wrap items-center gap-4 text-zinc-300 text-sm bg-zinc-900/40 p-3 rounded-xl border border-zinc-800/50 backdrop-blur-sm">
                {year && <span class="font-bold">{year}</span>}
                {rating && (
                  <span class="flex items-center gap-2 text-[#01b4e4] font-black">
                    <img
                      src="/logos/tmdb.svg"
                      alt="TMDB"
                      class="w-9 h-5 object-contain"
                    />
                    <span>{rating}</span>
                  </span>
                )}

                {show.imdb_rating != null && show.imdb_rating > 0 && (
                  <span class="flex items-center gap-2 text-[#f5c518] font-black">
                    <img
                      src="/logos/imdb.png"
                      alt="IMDb"
                      class="w-9 h-5 object-contain"
                    />
                    <span>{show.imdb_rating.toFixed(1)}</span>
                  </span>
                )}

                <span
                  data-card
                  data-tmdb-id={String(show.tmdb_id ?? id)}
                  data-media-type="series"
                  data-episode-order="tmdb"
                  class="contents"
                >
                  <button
                    type="button"
                    data-action="rate"
                    data-rating-style="pill"
                    data-user-rating={userRated ? String(show.user_rating) : ""}
                    title={userRated ? `Your rating: ${fmtRating(show.user_rating)}/10` : "Rate this"}
                    class={`flex items-center gap-1.5 font-black cursor-pointer transition-colors ${userRated ? "text-red-500" : "text-zinc-500 hover:text-red-400"}`}
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill={userRated ? "currentColor" : "none"} stroke="currentColor" stroke-width="2" stroke-linejoin="round" class="w-[18px] h-[18px]">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                    </svg>
                    <span data-rating-value>{userRated ? fmtRating(show.user_rating) : ""}</span>
                  </button>
                </span>

                <span class="font-medium text-zinc-400">
                  {seasonCount} {seasonCount === 1 ? "Season" : "Seasons"}
                </span>

                <span class="font-medium text-zinc-400">
                  {episodeCount} {episodeCount === 1 ? "Episode" : "Episodes"}
                </span>

                {show.age_rating && (
                  <span class="px-2 py-0.5 border border-zinc-600 rounded text-[10px] font-black text-zinc-400 tracking-widest">
                    {show.age_rating}
                  </span>
                )}
                {show.status && (
                  <span class="capitalize px-2 py-0.5 bg-zinc-800 border border-zinc-700 rounded text-[10px] font-black text-zinc-400 tracking-widest">
                    {show.status}
                  </span>
                )}
                {originalLanguage && (
                  <span class="flex items-center gap-1.5 font-medium text-zinc-400">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 text-zinc-500">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802" />
                    </svg>
                    {originalLanguage}
                  </span>
                )}
              </div>
              {(() => { const n = show.networks?.find(n => n.logo_path); return n ? <NetworkLogo src={n.logo_path!} name={n.name} /> : null; })()}
            </div>

            <!-- Show dates and countries -->
              {(show.first_air_date || show.last_air_date || show.production_countries?.length > 0) && (
                <div class="mb-2 flex items-center gap-4 text-sm text-zinc-400">
                  {show.first_air_date && (
                    <span class="flex items-center gap-1.5">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                        stroke-width="2" stroke="currentColor" class="w-4 h-4 text-zinc-500">
                        <path stroke-linecap="round" stroke-linejoin="round"
                          d="M6.75 3v2.25M17.25 3v2.25M3.75 9.75h16.5M5.25 4.5h13.5a1.5 1.5 0 0 1 1.5 1.5v13.5a1.5 1.5 0 0 1-1.5 1.5H5.25a1.5 1.5 0 0 1-1.5-1.5V6a1.5 1.5 0 0 1 1.5-1.5Z" />
                      </svg>
                      <span>Released {new Date(show.first_air_date).toLocaleDateString("en-US", {
                        month: "short",
                        day: "numeric",
                        year: "numeric",
                      })}</span>
                    </span>
                  )}

                  {isFinished && show.last_air_date && (
                    <span class="flex items-center gap-1.5">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                        stroke-width="2" stroke="currentColor" class="w-4 h-4 text-zinc-500">
                        <path stroke-linecap="round" stroke-linejoin="round"
                          d="M6.75 3v2.25M17.25 3v2.25M3.75 9.75h16.5M5.25 4.5h13.5a1.5 1.5 0 0 1 1.5 1.5v13.5a1.5 1.5 0 0 1-1.5 1.5H5.25a1.5 1.5 0 0 1-1.5-1.5V6a1.5 1.5 0 0 1 1.5-1.5Z" />
                      </svg>
                      <span>{show.status === "Canceled" ? "Canceled" : "Ended"} {new Date(show.last_air_date).toLocaleDateString("en-US", {
                        month: "short",
                        day: "numeric",
                        year: "numeric",
                        timeZone: "UTC",
                      })}</span>
                    </span>
                  )}

                  {show.production_countries?.length > 0 && (
                    <span class="flex items-center gap-1.5">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                        stroke-width="2" stroke="currentColor" class="w-4 h-4 text-zinc-500">
                        <circle cx="12" cy="12" r="9" />
                        <path stroke-linecap="round" stroke-linejoin="round"
                          d="M3 12h18M12 3c2.25 2.5 3.5 5.5 3.5 9s-1.25 6.5-3.5 9c-2.25-2.5-3.5-6.5-3.5-9S9.75 5.5 12 3Z" />
                      </svg>
                      {show.production_countries
                        .map((country: any) => country.name ?? country)
                        .join(" • ")}
                    </span>
                  )}

                  {show.production_companies?.length > 0 && (
                <span class="flex items-center gap-1.5">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    stroke="currentColor"
                    class="w-4 h-4 text-zinc-500"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M3 21h18M5 21V8l7-5 7 5v13M9 21v-5h6v5M9 10h.01M15 10h.01M9 13h.01M15 13h.01"
                    />
                  </svg>

                  {show.production_companies
                    .map((company) => company.name)
                    .join(" • ")}
                </span>
              )}
                </div>
              )}
    
            <div class="action-stack-slot">
              <ActionStack
                tmdbId={Number(id)}
                mediaType="series"
                watched={show.watched ?? false}
                inLists={show.in_lists ?? []}
                inLibrary={show.in_library ?? false}
                collectionPct={show.collection_pct ?? 0}
                watchPct={show.watch_pct ?? 0}
                showTmdbId={Number(id)}
                isMonitored={show.is_monitored ?? false}
                requestEnabled={show.request_enabled ?? false}
                requestStatus={show.request_status ?? null}
                userRating={show.user_rating ?? null}
                hideRate
              />
            </div>
            {show.tvdb_id && hasTvdbKey && (
              <div class="mb-6">
                <EpisodeOrderSelector
                  tmdbId={show.tmdb_id}
                  tvdbId={show.tvdb_id}
                  selected="tmdb"
                />
              </div>
            )}

            <div class="mb-10">
              <h2 class="text-xl font-black text-zinc-100 mb-4 flex items-center gap-2 uppercase tracking-tight">
              </h2>
              <p class="text-zinc-300 leading-relaxed text-lg max-w-4xl font-medium opacity-90">
                {show.overview}
              </p>

              <div class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-2 text-sm text-zinc-400">
                {show.watch_start_date && (
                  <span class="flex items-center gap-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                      stroke-width="2" stroke="currentColor" class="w-4 h-4 text-zinc-500">
                      <path stroke-linecap="round" stroke-linejoin="round"
                        d="M6.75 3v2.25M17.25 3v2.25M3.75 9.75h16.5M5.25 4.5h13.5a1.5 1.5 0 0 1 1.5 1.5V19.5A1.5 1.5 0 0 1 18.75 21H5.25a1.5 1.5 0 0 1-1.5-1.5V6a1.5 1.5 0 0 1 1.5-1.5Z" />
                    </svg>
                    <span>
                      Watched from {new Date(show.watch_start_date).toLocaleDateString("en-US")}
                      {show.watch_end_date && (
                        <> to {new Date(show.watch_end_date).toLocaleDateString("en-US")}</>
                      )}
                    </span>
                  </span>
                )}

                {show.watch_sources?.length > 0 && (
                  <span class="flex items-center gap-1.5">
                    <span class="text-zinc-500">•</span>
                    <span>{show.watch_sources.join(" • ")}</span>
                  </span>
                )}
              </div>
            </div>
          </div><!-- /Info column -->
        </div><!-- /Poster + Info row -->

<!-- Awards: filled from TVDB after load; hidden when there are none -->
{show?.tvdb_id && <AwardsList endpoint={`/api/proxy/shows/tvdb/${show.tvdb_id}/awards?tmdb_id=${show.tmdb_id}`} />}

        <!-- Seasons -->
        <div class="mt-12">
          <div class="flex items-center justify-between mb-10 border-b border-zinc-900 pb-6">
            <h2 class="text-3xl font-black text-zinc-100 tracking-tighter uppercase">Seasons</h2>
          </div>
          
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-x-6 gap-y-8">
            {seasonCards.map((s) => {
                const seasonNum = s.season_number;
                const episodes = show.seasons?.[`season_${seasonNum}`] || [];
                const seasonState = show.season_states?.[seasonNum] ?? { watched: false, in_library: episodes.length > 0, collection_pct: 0, watch_pct: 0, user_rating: null };
                return (
                  <SeasonCard
                    showTmdbId={show.tmdb_id}
                    season={s}
                    state={seasonState}
                    fallbackPoster={show.poster_path}
                    episodeCount={s.episode_count || episodes.length}
                  />
                );
            })}
          </div>
        </div>

        <!-- Cast / Guest Stars -->
        <div class="mt-2 border-zinc-900 pt-16">
          <div class="flex items-center gap-8 mb-10">
            <h2
              id="cast-tab"
              class="text-3xl font-black tracking-tighter uppercase text-red-500 cursor-pointer"
            >
              Cast
            </h2>

            <h2
              id="guest-stars-tab"
              class="text-3xl font-black tracking-tighter uppercase text-zinc-500 cursor-pointer"
            >
              Guest Stars
            </h2>
          </div>

          <!-- Cast -->
          <div id="cast-panel">
            {show.cast?.length > 0 && (
              <div class="flex gap-6 overflow-x-auto pb-4">
                {show.cast.slice(0, 12).map((person) => (
                  <a
                    href={`/person/${person.tmdb_id}`}
                    class="group/cast shrink-0 w-[240px] sm:w-[260px] bg-zinc-900/20 border border-zinc-800/40 p-4 rounded-3xl active:scale-95 active:opacity-70"
                  >
                    <div class="aspect-square w-full rounded-2xl overflow-hidden mb-5 ring-2 ring-zinc-800/50 shadow-lg">
                      {person.profile_path ? (
                        <img
                          src={person.profile_path}
                          alt={person.name}
                          class="w-full h-full object-cover"
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <div class="w-full h-full bg-zinc-800 flex items-center justify-center text-zinc-400 text-4xl">
                          👤
                        </div>
                      )}
                    </div>

                    <div class="space-y-1.5 text-center">
                      <p title={person.name} class="text-sm font-black text-zinc-100 line-clamp-1 leading-tight">
                        {person.name}
                      </p>
                      <p
                        class="text-[11px] text-zinc-500 font-bold uppercase tracking-wider line-clamp-1 opacity-80"
                        title={`${person.character} · ${person.episode_count} episodes`}
                      >
                        {person.character} · {person.episode_count} episodes
                      </p>
                    </div>
                  </a>
                ))}
              </div>
            )}
          </div>

          <!-- Guest Stars -->
          <div id="guest-stars-panel" class="hidden">
            {show.guest_stars?.length > 0 && (
              <div class="flex gap-6 overflow-x-auto pb-4">
                {show.guest_stars.map((person) => (
                  <a
                    href={`/person/${person.tmdb_id}`}
                    class="group/cast shrink-0 w-[240px] sm:w-[260px] bg-zinc-900/20 border border-zinc-800/40 p-4 rounded-3xl active:scale-95 active:opacity-70"
                  >
                    <div class="aspect-square w-full rounded-2xl overflow-hidden mb-5 ring-2 ring-zinc-800/50 shadow-lg">
                      {person.profile_path ? (
                        <img
                          src={person.profile_path}
                          alt={person.name}
                          class="w-full h-full object-cover"
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <div class="w-full h-full bg-zinc-800 flex items-center justify-center text-zinc-400 text-4xl">
                          👤
                        </div>
                      )}
                    </div>

                    <div class="space-y-1.5 text-center">
                      <p title={person.name} class="text-sm font-black text-zinc-100 line-clamp-1 leading-tight">
                        {person.name}
                      </p>
                      <p
                        class="text-[11px] text-zinc-500 font-bold uppercase tracking-wider line-clamp-1 opacity-80"
                        title={`${person.character} · ${person.episode_count} episodes`}
                      >
                        {person.character} · {person.episode_count} episodes
                      </p>
                    </div>
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>

        <CrewSection crew={show.crew} showEpisodeCounts />

        <div id="recommendations-container" data-type="series" data-id={show.tmdb_id}></div>
      </div>
    </div>
  )}
</Base>

{show?.poster_path && (
  <div id="poster-modal" class="fixed inset-0 z-[999] flex items-center justify-center hidden" role="dialog" aria-modal="true">
    <div id="poster-modal-backdrop" class="absolute inset-0 bg-black/90 backdrop-blur-sm cursor-pointer"></div>
    <img
      src={show.poster_path}
      alt={show.title}
      class="relative max-h-[90vh] max-w-[85vw] md:max-w-[50vw] object-contain rounded-2xl shadow-2xl ring-1 ring-white/10"
    />
    <button
      id="poster-modal-close"
      class="absolute top-4 right-4 p-2 rounded-full bg-black/60 hover:bg-black/80 text-white/70 hover:text-white transition-all duration-200 cursor-pointer"
      aria-label="Close"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
)}

<style>
  .character-hover {
    position: relative;
  }

  .character-short {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-align: center;
  }

  .character-full {
    display: none;
    position: absolute;
    left: 50%;
    bottom: 100%;
    transform: translateX(-50%);
    z-index: 50;
    width: max-content;
    max-width: 240px;
    padding: 8px 10px;
    border-radius: 8px;
    background: #18181b;
    border: 1px solid #3f3f46;
    color: #f4f4f5;
    font-size: 11px;
    font-weight: 700;
    text-align: center;
  }

  .character-hover:hover .character-full {
    display: block;
  }
</style>

<script>
  const zoomBtn = document.getElementById('poster-zoom-btn');
  const modal = document.getElementById('poster-modal');
  const backdrop = document.getElementById('poster-modal-backdrop');
  const closeBtn = document.getElementById('poster-modal-close');
  if (zoomBtn && modal) {
    function openModal() { modal.classList.remove('hidden'); document.body.style.overflow = 'hidden'; }
    function closeModal() { modal.classList.add('hidden'); document.body.style.overflow = ''; }
    zoomBtn.addEventListener('click', openModal);
    backdrop?.addEventListener('click', closeModal);
    closeBtn?.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });
  }
</script>

<script>
  // Async load recommendations
  const container = document.getElementById('recommendations-container');
  if (container) {
    const { type, id } = container.dataset;
    fetch(`/partials/recommendations?type=${type}&id=${id}`)
      .then(res => {
        if (res.status === 200) return res.text();
        return null;
      })
      .then(html => {
        // Safe: html is a server-rendered Astro partial; Astro auto-escapes all values.
        // Do NOT add raw user data to this partial without going through Astro templates.
        if (html) container.innerHTML = html;
      })
      .catch(err => console.error('Failed to load recommendations', err));
  }
</script>

<script define:vars={{ showId: id }}>
  const btn = document.getElementById('refresh-metadata-btn');
  if (btn) {
    btn.addEventListener('click', async () => {
      const icon = document.getElementById('refresh-icon');
      const label = document.getElementById('refresh-label');
      if (!label || !icon) return;

      btn.setAttribute('disabled', 'true');
      btn.classList.add('opacity-60', 'cursor-not-allowed');
      icon.classList.add('animate-spin');
      label.textContent = 'Refreshing...';

      try {
        const res = await fetch(`/api/proxy/shows/${showId}/refresh`, {
          method: 'POST',
        });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.detail || 'Refresh failed');
        }
        label.textContent = 'Done!';
        icon.classList.remove('animate-spin');
        setTimeout(() => { window.location.reload(); }, 800);
      } catch (err) {
        icon.classList.remove('animate-spin');
        label.textContent = 'Refresh failed';
        btn.removeAttribute('disabled');
        btn.classList.remove('opacity-60', 'cursor-not-allowed');
        setTimeout(() => { label.textContent = 'Refresh Metadata'; }, 3000);
      }
    });
  }
</script>

<script>
  const castTab = document.getElementById('cast-tab');
  const guestStarsTab = document.getElementById('guest-stars-tab');
  const castPanel = document.getElementById('cast-panel');
  const guestStarsPanel = document.getElementById('guest-stars-panel');

  castTab?.addEventListener('click', () => {
    castPanel?.classList.remove('hidden');
    guestStarsPanel?.classList.add('hidden');

    castTab.classList.remove('text-zinc-500');
    castTab.classList.add('text-red-500');

    guestStarsTab?.classList.remove('text-red-500');
    guestStarsTab?.classList.add('text-zinc-500');
  });

  guestStarsTab?.addEventListener('click', () => {
    guestStarsPanel?.classList.remove('hidden');
    castPanel?.classList.add('hidden');

    guestStarsTab.classList.remove('text-zinc-500');
    guestStarsTab.classList.add('text-red-500');

    castTab?.classList.remove('text-red-500');
    castTab?.classList.add('text-zinc-500');
  });
</script>
