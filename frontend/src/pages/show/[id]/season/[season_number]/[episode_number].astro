---
import Base from "../../../../../layouts/Base.astro";
import ActionBar from "../../../../../components/ActionBar.astro";
import VideoPlayer from "../../../../../components/VideoPlayer.astro";
import CrewSection from "../../../../../components/CrewSection.astro";
import { api, type EpisodeDetail } from "../../../../../lib/api";

export const prerender = false;

const { id, season_number, episode_number } = Astro.params;
const { token } = Astro.locals;
Astro.response.headers.set("Cache-Control", "no-store");

let episode: EpisodeDetail | null = null;
let error = "";

try {
  episode = await api.shows.getEpisode(Number(id), Number(season_number), Number(episode_number), token);
} catch (e: any) {
  error = e.message;
}

if (!episode && !error) {
  return Astro.redirect("/404");
}

const show = episode?.show;
const rating = episode?.tmdb_rating ? episode.tmdb_rating.toFixed(1) : null;
const thumbnail = episode?.still_path || show?.poster_path || null;
---

<Base title={episode ? `${show?.title} — ${episode.title}` : "Episode Details"}>
  {error && !episode && (
    <div class="max-w-md mx-auto mt-20 text-center">
      <div class="text-red-500 p-6 rounded-2xl mb-6">
        <p class="font-bold text-lg mb-2">Oops!</p>
        <p class="text-sm opacity-80">{error}</p>
      </div>
      <a href="/" class="text-blue-500 hover:underline">Return to Dashboard</a>
    </div>
  )}

  {episode && (
    <div class="relative">
      <!-- Backdrop from show -->
      {show?.backdrop_path && (
        <div class="absolute -top-8 left-1/2 -translate-x-1/2 w-screen h-[500px] overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/60 to-transparent z-10"></div>
          <img src={show.backdrop_path} alt="" class="w-full h-full object-cover opacity-30 blur-[1px]" />
        </div>
      )}

      <div class="relative z-20">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-sm text-zinc-400 mb-8 overflow-hidden whitespace-nowrap">
          <a href="/shows" class="hover:text-zinc-100 transition shrink-0">Shows</a>
          <span class="text-zinc-700">/</span>
          <a href={`/show/${id}`} class="hover:text-zinc-100 transition truncate">{show?.title}</a>
          <span class="text-zinc-700 shrink-0">/</span>
          <a href={`/show/${id}/season/${season_number}`} class="hover:text-zinc-100 transition shrink-0">Season {season_number}</a>
          <span class="text-zinc-700 shrink-0">/</span>
          <span class="text-zinc-100 font-bold shrink-0">Episode {episode_number}</span>
        </nav>

        <div class="flex flex-col md:flex-row gap-8 lg:gap-12 mb-16">
          <!-- Thumbnail -->
          <div class="w-full md:w-80 shrink-0">
            <div class="aspect-video rounded-2xl overflow-hidden shadow-2xl border border-zinc-800 bg-zinc-900 ring-1 ring-white/10 relative">
              {thumbnail ? (
                <button id="poster-zoom-btn" class="w-full h-full group/poster block cursor-zoom-in" aria-label={`Enlarge thumbnail for ${episode.title}`}>
                  <img
                    src={thumbnail}
                    alt={episode.title}
                    class="w-full h-full object-cover transition-transform duration-300 group-hover/poster:scale-105"
                    loading="eager"
                    decoding="async"
                  />
                  <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover/poster:opacity-100 transition-opacity duration-200 bg-black/30">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-8 h-8 text-white drop-shadow-lg">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607ZM10.5 7.5v6m3-3h-6" />
                    </svg>
                  </div>
                </button>
              ) : (
                <div class="w-full h-full flex flex-col items-center justify-center text-zinc-400 p-4 text-center">
                  <span class="text-4xl mb-2">📺</span>
                  <span class="text-sm font-medium">No Thumbnail</span>
                </div>
              )}
            </div>
            <div class="mt-2">
              <ActionBar
                tmdbId={episode.tmdb_id}
                mediaType="episode"
                watched={episode.watched ?? false}
                inLists={episode.in_lists ?? []}
                inLibrary={episode.in_library ?? false}
                collectionPct={episode.collection_pct ?? (episode.in_library ? 100 : 0)}
                showTmdbId={Number(id)}
                seasonNumber={Number(season_number)}
                episodeNumber={Number(episode_number)}
                mediaId={episode.id ?? null}
                userRating={episode.user_rating ?? null}
              />
            </div>

            {episode.show.genres?.length > 0 && (
                  <div class="flex flex-wrap gap-2 mt-3">
                    {episode.show.genres.map((genre) => (
                      <span class="px-3 py-1.5 bg-zinc-900/40 border border-zinc-800/50 rounded-xl text-zinc-400 text-xs font-black uppercase tracking-widest">
                        {genre}
                      </span>
                    ))}
                  </div>
                )}

          </div>

          <!-- Info -->
          <div class="flex-1 min-w-0 pt-2">
            <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-2">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-3 mb-2">
                  <span class="text-red-500 text-3xl md:text-5xl font-black tracking-tight leading-tight">
                    {String(season_number).padStart(2, '0')}x{String(episode_number).padStart(2, '0')}
                  </span>

                  <h1 class="text-3xl md:text-5xl font-black text-zinc-100 tracking-tight leading-tight">
                    {episode.title}
                  </h1>
                </div>

                <div class="flex flex-wrap items-center gap-3">
                  <p class="text-lg text-red-500 font-bold tracking-wide uppercase">
                    {show?.title}
                  </p>
                </div>
              </div>
              
              {episode.episodes && episode.episodes.length > 1 && (
                <div class="flex items-center gap-2 shrink-0">
                  {(() => {
                    const currentEpisode = Number(episode_number);
                    const episodes = episode.episodes
                      .sort((a, b) => a.episode_number - b.episode_number);
                    const currentIndex = episodes.findIndex((e) => e.episode_number === currentEpisode);
                    const prevEp = currentIndex > 0 ? episodes[currentIndex - 1] : null;
                    const nextEp = currentIndex < episodes.length - 1 ? episodes[currentIndex + 1] : null;
                    
                    return (
                      <>
                        {prevEp && (
                          <a href={`/show/${id}/season/${season_number}/${prevEp.episode_number}`} class="flex items-center gap-1.5 px-3 py-2 bg-zinc-900/60 border border-zinc-800/50 rounded-xl text-zinc-400 hover:text-zinc-100 hover:border-blue-500/50 hover:bg-zinc-800/60 active:scale-95 active:opacity-70 transition-all text-sm font-bold">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12 15.75 4.5" />
                            </svg>
                            <span class="hidden sm:inline">E{prevEp.episode_number}</span>
                          </a>
                        )}
                        
                        <span class="px-3 py-2 rounded-xl text-red-500 text-sm font-black">
                          E{currentEpisode}
                        </span>
                        
                        {nextEp && (
                          <a href={`/show/${id}/season/${season_number}/${nextEp.episode_number}`} class="flex items-center gap-1.5 px-3 py-2 bg-zinc-900/60 border border-zinc-800/50 rounded-xl text-zinc-400 hover:text-zinc-100 hover:border-blue-500/50 hover:bg-zinc-800/60 active:scale-95 active:opacity-70 transition-all text-sm font-bold">
                            <span class="hidden sm:inline">E{nextEp.episode_number}</span>
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                              <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                            </svg>
                          </a>
                        )}
                      </>
                    );
                  })()}
                </div>
              )}
            </div>

          <div class="flex items-start gap-4 mb10">
            <div class="flex flex-wrap items-center gap-4 text-zinc-300 text-sm mb-2 bg-zinc-900/40 p-3 rounded-xl border border-zinc-800/50 backdrop-blur-sm inline-flex">
              {episode.air_date && (
                <span class="font-bold">
                  {new Date(episode.air_date).toLocaleDateString(undefined, {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </span>
              )}

              {episode.show.age_rating && (
                <span
                  class="inline-flex items-center justify-center min-w-[52px] h-7 px-2 border-2 border-zinc-400 text-zinc-200 font-black text-xs tracking-tight rounded-sm"
                  title={`Content rating: ${episode.show.age_rating}`}
                >
                  {episode.show.age_rating}
                </span>
              )}

              {rating && (
                <a
                  href={`https://www.themoviedb.org/tv/${episode.show.tmdb_id}/season/${season_number}/episode/${episode_number}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 text-[#01b4e4] font-black hover:opacity-80 transition-opacity"
                  title="View on TMDB"
                >
                  <img
                    src="/logos/tmdb.svg"
                    alt="TMDB"
                    class="w-9 h-5 object-contain"
                  />
                  <span>{rating}</span>
                </a>
              )}

              {episode.imdb_id && (
                <a
                  href={`https://www.imdb.com/title/${episode.imdb_id}/`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 text-[#f5c518] font-black hover:opacity-80 transition-opacity"
                  title="View on IMDb"
                >
                  <img
                    src="/logos/imdb.svg"
                    alt="IMDb"
                    class="w-9 h-5 object-contain"
                  />
                  <span>{episode.imdb_rating != null ? episode.imdb_rating.toFixed(1) : "—"}</span>
                </a>
              )}

              {episode.runtime && (
                <span class="flex items-center gap-1.5 font-medium">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 text-zinc-500">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 2a10 10 0 1 0 0 20 10 10 0 1 0 0-20Zm0 4v6l4 2" />
                  </svg>
                  {episode.runtime} min
                </span>
              )}
            </div>

              {(() => {
                const n = episode.show.networks?.find(n => n.logo_path);
                return n ? (
                  <div class="bg-zinc-900/40 p-3 rounded-xl border border-zinc-800/50 backdrop-blur-sm flex items-center">
                    <img
                      src={n.logo_path!}
                      alt={n.name}
                      title={n.name}
                      class:list={[
                        "h-5 max-w-[80px] object-contain",
                        [
                          "FOX",
                          "Apple TV",
                          "HBO",
                          "FX",
                          "CBS",
                          "Nine Network",
                          "The WB",
                          "UPN",
                          "FXX",
                          "Citytv",
                          "AMC",
                          "Syfy",
                          "CBS All Access",
                          "TNT",
                          "Spike",
                          "Audience",
                          "Cartoon Network",
                          "TBS",
                          "Adult Swim",
                          "Amazon Freevee",
                          "Rooster Teeth",
                        ].includes(n.name) && "brightness-0 invert"
                      ]}
                      loading="lazy"
                    />
                  </div>
                ) : null;
              })()}
            </div>

            

            <!-- Library info -->
            {episode.library && (
              <div class="mb-4 flex flex-wrap gap-2">
                {!!episode.play_count && (
                  <span class="inline-flex items-center px-3 py-1.5 bg-zinc-900 border border-zinc-800 text-zinc-400 text-xs rounded-lg font-bold">
                    {episode.play_count} {episode.play_count === 1 ? 'Play' : 'Plays'}
                  </span>
                )}
                {[
                  episode.library.resolution,
                  episode.library.video_codec,
                  episode.library.audio_codec,
                  episode.library.audio_channels,
                ].filter(Boolean).map(tag => (
                  <span class="px-3 py-1.5 bg-zinc-900 border border-zinc-800 text-zinc-400 text-xs rounded-lg font-mono font-bold">
                    {tag}
                  </span>
                ))}
                {episode.library.audio_languages?.map((lang: string) => (
                  <span class="px-3 py-1.5 bg-zinc-900 border border-zinc-800 text-zinc-400 text-xs rounded-lg font-mono font-bold flex items-center gap-1.5">
                    <span class="opacity-50">🔊</span> {lang}
                  </span>
                ))}
                {episode.library.subtitle_languages?.map((lang: string) => (
                  <span class="px-3 py-1.5 bg-zinc-900 border border-zinc-800 text-zinc-400 text-xs rounded-lg font-mono font-bold flex items-center gap-1.5">
                    <span class="opacity-50">💬</span> {lang}
                  </span>
                ))}
              </div>
            )}

            {episode.in_library && (
              <div class="mb-8 flex flex-wrap gap-3 items-start">
                <button
                  id="refresh-metadata-btn"
                  class="flex items-center gap-2 px-4 py-2 text-sm font-bold leading-none text-zinc-300 bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 rounded-lg transition-colors cursor-pointer"
                >
                  <svg id="refresh-icon" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
                    <path d="M21 3v5h-5"/>
                    <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
                    <path d="M8 16H3v5"/>
                  </svg>
                  <span id="refresh-label">Refresh Metadata</span>
                </button>
                <VideoPlayer
                  tmdbId={episode.tmdb_id}
                  mediaType="episode"
                  inLibrary={episode.in_library ?? false}
                  title={`${show?.title} — ${episode.title}`}
                  token={token}
                  secondary
                />
              </div>
            )}

            {episode.overview && (
              <div>
                <p class="text-zinc-300 leading-relaxed text-lg max-w-3xl font-medium opacity-90">
                  {episode.overview}
                </p>
              </div>
            )}

            {episode.watch_history?.length > 0 && (
              <div class="mt-4">
                <div class="flex flex-col gap-2">
                  {episode.watch_history.map((watch) => (
                    <div class="flex items-center gap-3 text-sm text-zinc-400 whitespace-nowrap">
                      <span class="font-bold text-zinc-300">Watched</span>

                      {watch.watched_at && (
                        <>
                          <span class="flex items-center gap-1.5">
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              fill="none"
                              viewBox="0 0 24 24"
                              stroke-width="2"
                              stroke="currentColor"
                              class="w-4 h-4 text-zinc-500"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M6.75 3v2.25M17.25 3v2.25M3.75 9.75h16.5M5.25 4.5h13.5a1.5 1.5 0 0 1 1.5 1.5V19.5A1.5 1.5 0 0 1 18.75 21H5.25a1.5 1.5 0 0 1-1.5-1.5V6a1.5 1.5 0 0 1 1.5-1.5Z"
                              />
                            </svg>

                            {new Date(watch.watched_at).toLocaleDateString("en-US", {
                              month: "short",
                              day: "numeric",
                              year: "numeric",
                            })}
                          </span>

                          <span class="flex items-center gap-1.5">
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              fill="none"
                              viewBox="0 0 24 24"
                              stroke-width="2"
                              stroke="currentColor"
                              class="w-4 h-4 text-zinc-500"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 6v6l4 2"
                              />
                              <circle cx="12" cy="12" r="9" />
                            </svg>

                            {new Date(watch.watched_at).toLocaleTimeString("en-US", {
                              hour: "numeric",
                              minute: "2-digit",
                            })}
                          </span>
                        </>
                      )}

                      {watch.watch_source && (
                        <span class="text-zinc-400">
                          {watch.watch_source}
                        </span>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>

        <div class="flex items-center gap-8 mb10">
          <h2 id="cast-tab" class="text-3xl font-black tracking-tighter uppercase text-red-500 cursor-pointer">Cast</h2>
          <h2 id="guest-stars-tab" class="text-3xl font-black tracking-tighter uppercase text-zinc-500 cursor-pointer">Guest Stars</h2>
        </div>

        <!-- Cast -->
        {episode.cast?.length > 0 && (
          <div id="cast-panel" class="border-t border-zinc-900 pt-8">
            <div class="flex gap-6 overflow-x-auto pb-4">
              {episode.cast.map((person) => (
                <a href={`/person/${person.tmdb_id}`} class="group/cast shrink-0 w-[240px] sm:w-[260px] bg-zinc-900/20 border border-zinc-800/40 p-4 rounded-3xl active:scale-95 active:opacity-70">
                  <div class="aspect-square w-full rounded-2xl overflow-hidden mb-5 ring-2 ring-zinc-800/50 group-transition-all duration-500 shadow-lg">
                    {person.profile_path ? (
                      <img
                        src={person.profile_path}
                        alt={person.name}
                        class="w-full h-full object-cover transition-transform duration-700"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <div class="w-full h-full bg-zinc-800 flex items-center justify-center text-zinc-400 text-4xl">👤</div>
                    )}
                  </div>
                  <div class="space-y-1.5 text-center">
                    <p title={person.name} class="text-sm font-black text-zinc-100 group-transition-colors line-clamp-1 leading-tight">{person.name}</p>
                    <p title={person.character} class="text-[11px] text-zinc-500 font-bold uppercase tracking-wider line-clamp-1 opacity-80">{person.character}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Guest Stars -->
        {episode.guest_stars?.length > 0 && (
          <div id="guest-stars-panel" class="border-t border-zinc-900 pt-8 hidden">
            <h2 class="hidden">Guest Stars</h2>
            <div class="flex gap-6 overflow-x-auto pb-4">
              {episode.guest_stars.map((person) => (
                <a href={`/person/${person.tmdb_id}`} class="group/cast shrink-0 w-[240px] sm:w-[260px] bg-zinc-900/20 border border-zinc-800/40 p-4 rounded-3xl active:scale-95 active:opacity-70">
                  <div class="aspect-square w-full rounded-2xl overflow-hidden mb-5 ring-2 ring-zinc-800/50 group-transition-all duration-500 shadow-lg">
                    {person.profile_path ? (
                      <img
                        src={person.profile_path}
                        alt={person.name}
                        class="w-full h-full object-cover transition-transform duration-700"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <div class="w-full h-full bg-zinc-800 flex items-center justify-center text-zinc-400 text-4xl">👤</div>
                    )}
                  </div>
                  <div class="space-y-1.5 text-center">
                    <p title={person.name} class="text-sm font-black text-zinc-100 group-transition-colors line-clamp-1 leading-tight">{person.name}</p>
                    <p title={person.character} class="text-[11px] text-zinc-500 font-bold uppercase tracking-wider line-clamp-1 opacity-80">{person.character}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

      </div>
    </div>
  )}

        <CrewSection crew={episode?.crew} title="Episode Crew" />

</Base>

{thumbnail && (
  <div id="poster-modal" class="fixed inset-0 z-[999] flex items-center justify-center hidden" role="dialog" aria-modal="true">
    <div id="poster-modal-backdrop" class="absolute inset-0 bg-black/90 backdrop-blur-sm cursor-pointer"></div>
    <img
      src={thumbnail}
      alt={episode?.title}
      class="relative max-h-[90vh] max-w-[90vw] md:max-w-[70vw] object-contain rounded-2xl shadow-2xl ring-1 ring-white/10"
    />
    <button
      id="poster-modal-close"
      class="absolute top-4 right-4 p-2 rounded-full bg-black/60 hover:bg-black/80 text-white/70 hover:text-white transition-all duration-200 cursor-pointer"
      aria-label="Close"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
)}

<script>
  const zoomBtn = document.getElementById('poster-zoom-btn');
  const modal = document.getElementById('poster-modal');
  const backdrop = document.getElementById('poster-modal-backdrop');
  const closeBtn = document.getElementById('poster-modal-close');
  if (zoomBtn && modal) {
    function openModal() { modal.classList.remove('hidden'); document.body.style.overflow = 'hidden'; }
    function closeModal() { modal.classList.add('hidden'); document.body.style.overflow = ''; }
    zoomBtn.addEventListener('click', openModal);
    backdrop?.addEventListener('click', closeModal);
    closeBtn?.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });
  }
</script>

<script define:vars={{ showId: id, token: Astro.locals.token }}>
  const btn = document.getElementById('refresh-metadata-btn');
  if (btn) {
    btn.addEventListener('click', async () => {
      const icon = document.getElementById('refresh-icon');
      const label = document.getElementById('refresh-label');
      if (!label || !icon) return;

      btn.setAttribute('disabled', 'true');
      btn.classList.add('opacity-60', 'cursor-not-allowed');
      icon.classList.add('animate-spin');
      label.textContent = 'Refreshing...';

      try {
        const res = await fetch(`/api/proxy/shows/${showId}/refresh`, {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}` },
        });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.detail || 'Refresh failed');
        }
        label.textContent = 'Done!';
        icon.classList.remove('animate-spin');
        setTimeout(() => { window.location.reload(); }, 800);
      } catch (err) {
        icon.classList.remove('animate-spin');
        label.textContent = 'Refresh failed';
        btn.removeAttribute('disabled');
        btn.classList.remove('opacity-60', 'cursor-not-allowed');
        setTimeout(() => { label.textContent = 'Refresh Metadata'; }, 3000);
      }
    });
  }
</script>

<script>
  const castTab = document.getElementById('cast-tab');
  const guestStarsTab = document.getElementById('guest-stars-tab');
  const castPanel = document.getElementById('cast-panel');
  const guestStarsPanel = document.getElementById('guest-stars-panel');

  castTab?.addEventListener('click', () => {
    castPanel?.classList.remove('hidden');
    guestStarsPanel?.classList.add('hidden');

    castTab.classList.remove('text-zinc-500');
    castTab.classList.add('text-red-500');

    guestStarsTab?.classList.remove('text-red-500');
    guestStarsTab?.classList.add('text-zinc-500');
  });

  guestStarsTab?.addEventListener('click', () => {
    guestStarsPanel?.classList.remove('hidden');
    castPanel?.classList.add('hidden');

    guestStarsTab.classList.remove('text-zinc-500');
    guestStarsTab.classList.add('text-red-500');

    castTab?.classList.remove('text-red-500');
    castTab?.classList.add('text-zinc-500');
  });
</script>
