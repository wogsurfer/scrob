---
import Base from "../../../../layouts/Base.astro";
import ActionStack from "../../../../components/ActionStack.astro";
import EpisodeBadge from "../../../../components/EpisodeBadge.astro";
import watchdIconWhite from "../../../../assets/watchd-icon-white.png";
import watchdIconRed from "../../../../assets/watchd-icon-red.png";
import { api, type Season } from "../../../../lib/api";
export const prerender = false;

const { id, season_number } = Astro.params;
const { token } = Astro.locals;
Astro.response.headers.set("Cache-Control", "private, no-cache");

let season: Season | null = null;
let error = "";

try {
  season = await api.shows.getSeason(Number(id), Number(season_number), token);
} catch (e: any) {
  error = e.message;
}

if (!season && !error) {
  return Astro.redirect("/404");
}

const show = season?.show;

// Episode list: progress counts aired episodes only, so a season still airing
// isn't stuck below 100%.
const today = new Date().toISOString().slice(0, 10);
const isAired = (date?: string | null) => !!date && date.slice(0, 10) <= today;
const fmtDate = (date: string) =>
  new Date(date).toLocaleDateString(undefined, { year: "numeric", month: "short", day: "numeric" });
const airedEpisodes = (season?.episodes ?? []).filter((ep) => isAired(ep.air_date));
const airedCount = airedEpisodes.length;
const watchedCount = airedEpisodes.filter((ep) => ep.watched).length;
const progressPct = airedCount ? Math.round((watchedCount / airedCount) * 100) : 0;
const seasonAllWatched = airedCount > 0 && watchedCount === airedCount;
---

<Base title={season ? `${show?.title} — ${season.name}` : "Season Details"}>
  {error && !season && (
    <div class="max-w-md mx-auto mt-20 text-center">
      <div class="bg-red-500/10 border border-red-500/20 text-red-500 p-6 rounded-2xl mb-6">
        <p class="font-bold text-lg mb-2">Oops!</p>
        <p class="text-sm opacity-80">{error}</p>
      </div>
      <a href="/" class="text-blue-500 hover:underline">Return to Dashboard</a>
    </div>
  )}

  {season && (
    <div class="relative">
      <!-- Backdrop -->
      {(season.backdrop_path || show?.backdrop_path) && (
        <div class="absolute -top-8 left-1/2 -translate-x-1/2 w-screen h-[500px] overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/80 to-transparent z-10"></div>
          <img src={season.backdrop_path || show.backdrop_path} alt="" class="w-full h-full object-cover opacity-30 blur-[1px]" />
        </div>
      )}

      <div class="relative z-20">
        <nav class="flex items-center gap-2 text-sm text-zinc-400 mb-8 overflow-hidden whitespace-nowrap">
          <a href="/shows" class="hover:text-zinc-100 transition">Shows</a>
          <span class="text-zinc-700">/</span>
          <a href={`/show/${id}`} class="hover:text-zinc-100 transition truncate">{show?.title}</a>
          <span class="text-zinc-700">/</span>
          <span class="text-zinc-100 font-bold">{season.name}</span>
        </nav>

        <div class="flex flex-col md:flex-row gap-8 lg:gap-12 mb-16">
          <div class="w-56 shrink-0 mx-auto md:mx-0">
            <div class="aspect-[2/3] rounded-2xl overflow-hidden shadow-2xl border border-zinc-800 bg-zinc-900 ring-1 ring-white/10 relative">
              {(season.poster_path || show?.poster_path) ? (
                <button id="poster-zoom-btn" class="w-full h-full group/poster block cursor-zoom-in" aria-label={`Enlarge poster for ${season.name}`}>
                  <img src={season.poster_path || show?.poster_path} alt={season.name} class="w-full h-full object-cover transition-transform duration-300 group-hover/poster:scale-105" />
                  <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover/poster:opacity-100 transition-opacity duration-200 bg-black/30">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-8 h-8 text-white drop-shadow-lg">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607ZM10.5 7.5v6m3-3h-6" />
                    </svg>
                  </div>
                </button>
              ) : (
                <div class="w-full h-full flex flex-col items-center justify-center text-zinc-400 p-4 text-center">
                  <span class="text-4xl mb-2">📺</span>
                  <span class="text-sm font-medium">No Poster Available</span>
                </div>
              )}
            </div>
          </div>

          <div class="flex-1 min-w-0 pt-4 action-stack-host text-center md:text-left">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-2">
              <h1 class="text-4xl md:text-5xl font-black text-zinc-100 tracking-tight">{season.name}</h1>
              
            </div>
            
            <p class="text-lg text-red-500 font-bold mb-6 tracking-wide uppercase">{show?.title}</p>
            
            <div class="flex flex-wrap justify-center md:justify-start items-center gap-4 text-zinc-400 text-sm mb-8 bg-zinc-900/40 p-3 rounded-xl border border-zinc-800/50 backdrop-blur-sm inline-flex">
              <span class="font-bold text-zinc-300">{season.episodes?.length || 0} Episodes</span>
              {season.tmdb_rating != null && season.tmdb_rating > 0 && (
            <span class="flex items-center gap-2 text-[#01b4e4] font-black">
              <img
                src="/logos/tmdb.svg"
                alt="TMDB"
                class="w-9 h-5 object-contain"
              />
              <span>{season.tmdb_rating.toFixed(1)}</span>
            </span>
          )}

          {season.imdb_rating != null && season.imdb_rating > 0 && (
            <span class="flex items-center gap-2 text-[#f5c518] font-black">
              <img
                src="/logos/imdb.png"
                alt="IMDb"
                class="w-9 h-5 object-contain"
              />
              <span>{season.imdb_rating.toFixed(1)}</span>
            </span>
          )}
              {season.air_date && (
                <>
                  <span>Premiered {new Date(season.air_date).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })}</span>
                </>
              )}
            </div>

            <div class="action-stack-slot">
                  {show?.seasons_meta && show.seasons_meta.length > 1 && (
                    <div class="flex items-center justify-center md:justify-end gap-2 mb-3">
                      {(() => {
                        const currentSeason = Number(season_number);
                        const validSeasons = show.seasons_meta
                          .filter((s) => s.season_number > 0)
                          .sort((a, b) => a.season_number - b.season_number);
                        const currentIndex = validSeasons.findIndex((s) => s.season_number === currentSeason);
                        const prevSeason = currentIndex > 0 ? validSeasons[currentIndex - 1] : null;
                        const nextSeason = currentIndex < validSeasons.length - 1 ? validSeasons[currentIndex + 1] : null;
                        
                        return (
                          <>
                            {prevSeason && (
                              <a href={`/show/${id}/season/${prevSeason.season_number}`} class="flex items-center gap-1.5 px-3 py-2 bg-zinc-900/60 border border-zinc-800/50 rounded-xl text-zinc-400 hover:text-zinc-100 hover:border-blue-500/50 hover:bg-zinc-800/60 active:scale-95 active:opacity-70 transition-all text-sm font-bold">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12 15.75 4.5" />
                                </svg>
                                <span class="hidden sm:inline">S{prevSeason.season_number}</span>
                              </a>
                            )}
                            
                            <span class="px-3 py-2 bg-zinc-900/60 border border-zinc-800/50 rounded-xl text-red-500 text-sm font-black">
                              S{currentSeason}
                            </span>
                            
                            {nextSeason && (
                              <a href={`/show/${id}/season/${nextSeason.season_number}`} class="flex items-center gap-1.5 px-3 py-2 bg-zinc-900/60 border border-zinc-800/50 rounded-xl text-zinc-400 hover:text-zinc-100 hover:border-blue-500/50 hover:bg-zinc-800/60 active:scale-95 active:opacity-70 transition-all text-sm font-bold">
                                <span class="hidden sm:inline">S{nextSeason.season_number}</span>
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                                  <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                                </svg>
                              </a>
                            )}
                          </>
                        );
                      })()}
                    </div>
                  )}
              <ActionStack
                hideRate
                tmdbId={Number(id)}
                mediaType="series"
                watched={season.season_watched ?? false}
                inLists={[]}
                inLibrary={season.season_in_library ?? season.show_in_library ?? false}
                collectionPct={season.season_collection_pct ?? season.show_collection_pct ?? 0}
                discId={season.season_disc_id ?? null}
                watchPct={season.season_watched ? 100 : 0}
                seasonNumber={Number(season_number)}
                isMonitored={season.show_is_monitored ?? false}
                requestEnabled={false}
                hideLists={true}
                userRating={season.season_user_rating ?? null}
              />
            </div>

            {season.show_in_library && (
              <div class="mb-6">
                <button
                  id="refresh-metadata-btn"
                  class="flex items-center gap-2 px-4 py-2 text-sm font-bold text-zinc-400 hover:text-zinc-100 bg-zinc-900/60 hover:bg-zinc-800/80 border border-zinc-800 hover:border-zinc-700 rounded-xl transition-all duration-200 cursor-pointer"
                >
                  <svg id="refresh-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
                    <path d="M21 3v5h-5"/>
                    <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
                    <path d="M8 16H3v5"/>
                  </svg>
                  <span id="refresh-label">Refresh Metadata</span>
                </button>
              </div>
            )}

            {season.overview && (
              <div class="max-w-3xl">
                <h2 class="text-xl font-black text-zinc-100 mb-3 flex items-center gap-2 uppercase tracking-tight">
                  <span class="w-2 h-2 bg-blue-500 rounded-full"></span>
                  Season Overview
                </h2>
                <p class="text-zinc-300 leading-relaxed text-lg opacity-90">{season.overview}</p>
              </div>
            )}
          </div>
        </div>

        <section id="episodes" class="page-section">
          <h2 class="text-3xl font-black text-zinc-100 tracking-tighter uppercase page-section-head">Episodes</h2>

          <!-- Season progress: aired episodes watched; kept current by the script below -->
          <div class="flex flex-col sm:flex-row sm:items-center gap-4 mb-4">
            <div class="flex-1 min-w-0">
              <div class="flex justify-between text-sm font-bold text-zinc-400 mb-2">
                <span id="season-progress-label">{watchedCount} of {airedCount} watched</span>
                <span id="season-progress-pct">{progressPct}%</span>
              </div>
              <div class="h-1.5 rounded-full bg-zinc-800 overflow-hidden">
                <div id="season-progress-bar" class="h-full bg-red-500 rounded-full transition-[width] duration-300" style={`width:${progressPct}%`}></div>
              </div>
            </div>
            <div
              data-card
              data-tmdb-id={String(id)}
              data-media-type="series"
              data-show-tmdb-id={String(id)}
              data-season={String(season_number)}
            >
              <button
                id="season-mark"
                data-action="watched"
                data-watched={String(seasonAllWatched)}
                data-state={seasonAllWatched ? "active" : "inactive"}
                class="season-mark flex items-center gap-2 px-4 py-2 text-sm font-bold rounded-xl border border-zinc-800 cursor-pointer transition-colors"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 7 17l-5-5"/><path d="m22 10-7.5 7.5L13 16"/></svg>
                <em class="season-mark-on not-italic">Season watched</em>
                <em class="season-mark-off not-italic">Mark season watched</em>
              </button>
            </div>
          </div>

          <ul class="border-t border-zinc-800/70">
            {season.episodes?.map((ep) => {
              const href = `/show/${id}/season/${season_number}/${ep.episode_number}`;
              const aired = isAired(ep.air_date);
              const code = `${season_number}x${String(ep.episode_number).padStart(2, "0")}`;
              return (
                <li
                  class="ep-row border-b border-zinc-800/70"
                  data-card
                  data-tmdb-id={String(ep.tmdb_id)}
                  data-media-type="episode"
                  data-show-tmdb-id={String(id)}
                  data-season={String(season_number)}
                  data-episode-number={String(ep.episode_number)}
                  data-aired={String(aired)}
                >
                  <!-- As Trakt laid them out: the still with its buttons, then the episode beside it. -->
                  <div class="ep-main grid md:grid-cols-[minmax(0,420px)_1fr] gap-4 md:gap-6 py-5">
                    <div class="ep-still rounded-2xl overflow-hidden bg-zinc-900 border border-zinc-800/70">
                      <a href={href} class="block aspect-video bg-zinc-900" tabindex="-1">
                        {ep.poster_path ? (
                          <img src={ep.poster_path} alt="" class="w-full h-full object-cover" loading="lazy" decoding="async" />
                        ) : (
                          <span class="w-full h-full flex items-center justify-center text-zinc-700 text-4xl font-black">{ep.episode_number}</span>
                        )}
                      </a>
                      <div class="flex items-center gap-1 px-2 h-14">
                        <button
                          data-action="watched"
                          data-watched={String(ep.watched)}
                          data-state={ep.watched ? "active" : "inactive"}
                          title={ep.watched ? "Mark as unwatched" : "Mark as watched"}
                          aria-label={`Watched: ${ep.title}`}
                          class="ep-check shrink-0 w-10 h-10 flex items-center justify-center cursor-pointer"
                        >
                          <img
                            src={ep.watched ? watchdIconRed.src : watchdIconWhite.src}
                            alt=""
                            class="w-7 h-7 object-contain"
                            data-watchd-red={watchdIconRed.src}
                            data-watchd-white={watchdIconWhite.src}
                          />
                        </button>
                        <button
                          data-action="list"
                          data-in-lists={JSON.stringify(ep.in_lists ?? [])}
                          data-state={(ep.in_lists ?? []).length > 0 ? "active" : "inactive"}
                          title="Add to list"
                          class="ep-icon ep-icon-list flex items-center justify-center w-10 h-10 rounded-lg cursor-pointer"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                        </button>
                        <button
                          data-action="collected"
                          data-in-library={String(ep.in_library)}
                          data-state={ep.in_library ? "active" : "inactive"}
                          title={ep.in_library ? "In collection" : "Add to collection"}
                          class="ep-icon ep-icon-collected flex items-center justify-center w-10 h-10 rounded-lg cursor-pointer"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"/><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="M15 22v-4a3 3 0 0 0-6 0v4"/><path d="M2 7h20"/></svg>
                        </button>
                        <button
                          data-action="rate"
                          data-rating-style="pill"
                          data-user-rating={ep.user_rating != null ? String(ep.user_rating) : ""}
                          data-state={ep.user_rating != null ? "active" : "inactive"}
                          title={ep.user_rating != null ? `Your rating: ${ep.user_rating}/10` : "Rate this"}
                          class={`flex items-center gap-1.5 h-10 px-2 rounded-lg text-sm font-black cursor-pointer ${ep.user_rating != null ? "text-red-500" : "text-zinc-500 hover:text-red-400"}`}
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill={ep.user_rating != null ? "currentColor" : "none"} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                          <span data-rating-value>{ep.user_rating != null ? ep.user_rating : ""}</span>
                          <span class="sr-only">Rate</span>
                        </button>
                        {ep.imdb_rating != null && ep.imdb_rating > 0 && (
                          <span class="ml-auto flex items-center gap-1.5 pr-2 font-black"><span class="px-1.5 rounded bg-[#f5c518] text-black text-[11px]">IMDb</span><span class="text-[#f5c518] text-xl">{ep.imdb_rating.toFixed(1)}</span></span>
                        )}
                      </div>
                    </div>

                    <div class="min-w-0">
                      <a href={href} class="block text-2xl font-black text-zinc-100 hover:text-red-400 transition-colors leading-tight">
                        <span class="text-red-500">{code}</span> {ep.title}
                      </a>
                      <div class="flex flex-wrap items-center gap-2 mt-2">
                        {ep.air_date && (
                          <span class="px-2.5 py-1 rounded-md bg-red-600 text-white text-xs font-black">{aired ? "" : "Airs "}{fmtDate(ep.air_date)}</span>
                        )}
                        {ep.runtime ? <span class="px-2.5 py-1 rounded-md bg-zinc-800 text-zinc-300 text-xs font-black">{ep.runtime}m</span> : null}
                        {ep.badge && <EpisodeBadge label={ep.badge} class="shrink-0" />}
                        <span class="ep-next hidden shrink-0 text-[10px] font-black uppercase tracking-wider text-red-400 bg-red-500/15 px-2 py-1 rounded-md">Up next</span>
                      </div>
                      <p class="mt-3 text-base text-zinc-300 leading-relaxed max-w-4xl">{ep.overview || "No overview available for this episode."}</p>
                      <div class="flex flex-wrap items-center gap-2 mt-4">
                        {ep.tmdb_rating != null && ep.tmdb_rating > 0 && (
                          <span class="flex items-center gap-2 h-10 px-3 rounded-xl bg-zinc-900 border border-zinc-800 text-sm font-black text-[#01b4e4]"><img src="/logos/tmdb.svg" alt="TMDB" class="w-8 h-4 object-contain" />{ep.tmdb_rating.toFixed(1)}</span>
                        )}
                        <a href={href} class="flex items-center h-10 px-3 rounded-xl bg-zinc-900 border border-zinc-800 text-xs font-black uppercase tracking-wider text-zinc-400 hover:text-red-400 transition-colors">View episode →</a>
                      </div>
                    </div>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      </div>
    </div>
  )}
</Base>

{(season?.poster_path || show?.poster_path) && (
  <div id="poster-modal" class="fixed inset-0 z-[999] flex items-center justify-center hidden" role="dialog" aria-modal="true">
    <div id="poster-modal-backdrop" class="absolute inset-0 bg-black/90 backdrop-blur-sm cursor-pointer"></div>
    <img
      src={season.poster_path || show?.poster_path}
      alt={season.name}
      class="relative max-h-[90vh] max-w-[85vw] md:max-w-[50vw] object-contain rounded-2xl shadow-2xl ring-1 ring-white/10"
    />
    <button
      id="poster-modal-close"
      class="absolute top-4 right-4 p-2 rounded-full bg-black/60 hover:bg-black/80 text-white/70 hover:text-white transition-all duration-200 cursor-pointer"
      aria-label="Close"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
)}

<script>
  const zoomBtn = document.getElementById('poster-zoom-btn');
  const modal = document.getElementById('poster-modal');
  const backdrop = document.getElementById('poster-modal-backdrop');
  const closeBtn = document.getElementById('poster-modal-close');
  if (zoomBtn && modal) {
    function openModal() { modal.classList.remove('hidden'); document.body.style.overflow = 'hidden'; }
    function closeModal() { modal.classList.add('hidden'); document.body.style.overflow = ''; }
    zoomBtn.addEventListener('click', openModal);
    backdrop?.addEventListener('click', closeModal);
    closeBtn?.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });
  }
</script>

<script define:vars={{ showId: id }}>
  const btn = document.getElementById('refresh-metadata-btn');
  if (btn) {
    btn.addEventListener('click', async () => {
      const icon = document.getElementById('refresh-icon');
      const label = document.getElementById('refresh-label');
      if (!label || !icon) return;

      btn.setAttribute('disabled', 'true');
      btn.classList.add('opacity-60', 'cursor-not-allowed');
      icon.classList.add('animate-spin');
      label.textContent = 'Refreshing...';

      try {
        const res = await fetch(`/api/proxy/shows/${showId}/refresh`, {
          method: 'POST',
        });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.detail || 'Refresh failed');
        }
        label.textContent = 'Done!';
        icon.classList.remove('animate-spin');
        setTimeout(() => { window.location.reload(); }, 800);
      } catch (err) {
        icon.classList.remove('animate-spin');
        label.textContent = 'Refresh failed';
        btn.removeAttribute('disabled');
        btn.classList.remove('opacity-60', 'cursor-not-allowed');
        setTimeout(() => { label.textContent = 'Refresh Metadata'; }, 3000);
      }
    });
  }
</script>

<style>
  /* Watched checks and icon buttons take their look from data-state, which the
     shared handlers in Base.astro keep current (their colour classes are
     overridden here). */
  /* Just the Watchd W: white when unwatched, red when watched (Base.astro
     swaps the logo). The shared handler adds colour classes; clear them. */
  .ep-check, .ep-check:hover { background: transparent !important; border: 0; padding: 0; }
  .ep-check img { transition: transform .15s; }
  .ep-check:hover img { transform: scale(1.12); }
  .ep-row[data-aired="false"] .ep-main { opacity: .6; }
  .ep-row[data-aired="false"] .ep-check { visibility: hidden; }
  .ep-row.is-next .ep-next { display: inline-block; }

  .ep-icon { background: #18181b; color: #71717a; }
  .ep-icon:hover { color: #e4e4e7; }
  .ep-icon-list[data-state="active"] { background: rgb(14 165 233 / .5); color: #7dd3fc; }
  .ep-icon-collected[data-state="active"] { background: rgb(168 85 247 / .5); color: #d8b4fe; }

  .season-mark { background: #18181b; color: #a1a1aa; }
  .season-mark:hover { color: #f4f4f5; border-color: #3f3f46; }
  .season-mark[data-state="active"] { background: rgb(239 68 68 / .2); color: #fca5a5; border-color: rgb(239 68 68 / .4); }
  .season-mark .season-mark-on,
  .season-mark[data-state="active"] .season-mark-off { display: none; }
  .season-mark[data-state="active"] .season-mark-on { display: inline; }
</style>

<script>
  // Episode rows: the progress bar, "Up next" tag and season button
  // follow the watched checks, which the shared handlers update in place.
  const episodes = document.getElementById('episodes');
  if (episodes) {
    const rows = [...episodes.querySelectorAll<HTMLElement>('.ep-row')];

    const refresh = () => {
      const aired = rows.filter((r) => r.dataset.aired === 'true');
      const isWatched = (r: HTMLElement) =>
        r.querySelector<HTMLElement>('.ep-check')?.dataset.state === 'active';
      const watched = aired.filter(isWatched).length;
      const pct = aired.length ? Math.round((watched / aired.length) * 100) : 0;
      document.getElementById('season-progress-label')!.textContent = `${watched} of ${aired.length} watched`;
      document.getElementById('season-progress-pct')!.textContent = `${pct}%`;
      document.getElementById('season-progress-bar')!.style.width = `${pct}%`;

      const next = aired.find((r) => !isWatched(r));
      rows.forEach((r) => r.classList.toggle('is-next', r === next && watched > 0));

      const mark = document.getElementById('season-mark');
      if (mark) {
        const all = aired.length > 0 && watched === aired.length;
        // Only write on change: this attribute is itself observed.
        if (mark.dataset.watched !== String(all)) {
          mark.dataset.state = all ? 'active' : 'inactive';
          mark.dataset.watched = String(all);
        }
      }
    };

    new MutationObserver(refresh).observe(episodes, {
      subtree: true,
      attributes: true,
      attributeFilter: ['data-state'],
    });
    refresh();
  }
</script>
