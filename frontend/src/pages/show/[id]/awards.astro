---
import Base from "../../../layouts/Base.astro";
import { api, type Show } from "../../../lib/api";

export const prerender = false;

const { id } = Astro.params;
const { token } = Astro.locals;

let show: Show | null = null;
let error = "";

try {
  show = await api.shows.get(Number(id), token);
} catch (e: any) {
  error = e.message;
}

if (!show && !error) {
  return Astro.redirect("/404");
}
---

<Base title={`${show?.title ?? "Show"} — Awards`}>
  {show && (
    <div class="max-w-6xl mx-auto">

      <!-- Header -->
      <div class="mb-10">
        <a
          href={`/show/${show.tmdb_id}`}
          class="text-sm font-bold text-zinc-500 hover:text-zinc-100 transition-colors"
        >
          ← {show.title}
        </a>

        <h1 class="mt-6 text-4xl md:text-5xl font-black text-zinc-100 tracking-tight">
          Awards
        </h1>

        <p id="awards-count" class="mt-2 text-zinc-500 font-medium">
          Loading awards...
        </p>
      </div>

      <!-- Awards -->
        <div id="awards-list" class="space-y-8">
           <div class="py-20 text-center text-zinc-500">
              Loading awards...
            </div>
           </div>

        </div>
      )}
    </Base>

<script define:vars={{ tvdbId: show?.tvdb_id }}>
  const count = document.getElementById('awards-count');
  const list = document.getElementById('awards-list');

  if (count && list && tvdbId) {
    fetch(`/api/proxy/shows/tvdb/${tvdbId}/awards`)
      .then(async (res) => {
        if (!res.ok) {
          throw new Error(`Awards request failed: ${res.status}`);
        }
        return res.json();
      })
            .then((data) => {
                const awards = data.awards ?? [];
                const wins = awards.filter((a) => a.is_winner).length;

                count.textContent =
                `${wins} Wins | ${awards.length} Nominations`;

                if (!awards.length) {
                list.innerHTML = `
                    <div class="py-20 text-center text-zinc-500">
                    No awards information available.
                    </div>
                `;
                return;
                }

                const grouped = awards.reduce((groups, award) => {
                const name = award.award_name ?? "Other Awards";

                if (!groups[name]) {
                    groups[name] = [];
                }

                groups[name].push(award);
                return groups;
                });

                list.innerHTML = Object.entries(grouped).map(([awardName, items]) => `
                <section class="mb-12">

                    <h2 class="text-2xl font-black text-zinc-100 tracking-tight mb-5">
                    ${awardName}
                    </h2>

                    <div class="border-t border-zinc-800">
                    ${items.map((award) => `
                        <div class="py-6 border-b border-zinc-800">

                        <div class="flex items-start justify-between gap-6">

                            <div class="min-w-0">
                            <p class="text-base font-bold text-zinc-200">
                                ${award.category_name ?? ""}
                            </p>

                            ${award.is_winner ? `
                                <div class="mt-3 inline-flex px-2.5 py-1 rounded-lg bg-red-500/10 border border-red-500/20 text-xs font-black uppercase tracking-wider text-red-500">
                                Winner
                                </div>
                            ` : ""}

                            ${award.details ? `
                                <p class="mt-3 text-sm text-zinc-500 leading-relaxed">
                                ${award.details}
                                </p>
                            ` : ""}
                            </div>

                            <div class="shrink-0 text-sm font-bold text-zinc-500">
                            ${award.year ?? ""}
                            </div>

                        </div>

                        </div>
                    `).join("")}
                    </div>

                </section>
                `).join("");
            })
            .catch((err) => {
                console.error("Failed to load awards:", err);

                count.textContent = "Awards unavailable";

                list.innerHTML = `
                <div class="py-20 text-center text-zinc-500">
                    Unable to load awards information.
                </div>
                `;
            });
  }
</script>