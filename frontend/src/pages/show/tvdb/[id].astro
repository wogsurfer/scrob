---
// A TVDB-linked show opens its TMDB page; TVDB-only shows have no page.
import { api, type TvdbShow } from "../../../lib/api";

export const prerender = false;

const { id } = Astro.params;
const { token } = Astro.locals;

Astro.response.headers.set("Cache-Control", "private, no-cache");

let show: TvdbShow | null = null;

try {
  show = await api.shows.getTvdb(Number(id), token);
} catch {}

if (!show) {
  return Astro.redirect("/404");
}

const tmdbShowId = show.tmdb_id_cross ?? null;

if (!tmdbShowId) {
  return Astro.redirect("/404");
}

return Astro.redirect(`/show/${tmdbShowId}`);
---
