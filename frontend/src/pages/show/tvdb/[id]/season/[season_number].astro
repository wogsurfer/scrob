---
// A TVDB-linked season opens its TMDB season page; TVDB-only shows have no page.
import { api, type TvdbSeasonDetail } from "../../../../../lib/api";

export const prerender = false;

const { id, season_number } = Astro.params;
const { token } = Astro.locals;

Astro.response.headers.set("Cache-Control", "private, no-cache");

let season: TvdbSeasonDetail | null = null;

try {
  season = await api.shows.getTvdbSeason(
    Number(id),
    Number(season_number),
    token
  );
} catch {}

if (!season) {
  return Astro.redirect("/404");
}

const tmdbShowId = season.show?.tmdb_id ?? null;

if (!tmdbShowId) {
  return Astro.redirect("/404");
}

return Astro.redirect(
  `/show/${tmdbShowId}/season/${season_number}`
);
---
