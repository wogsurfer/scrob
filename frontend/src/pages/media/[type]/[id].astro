<script>
  const zoomBtn = document.getElementById('poster-zoom-btn');
  const modal = document.getElementById('poster-modal');
  const backdrop = document.getElementById('poster-modal-backdrop');
  const closeBtn = document.getElementById('poster-modal-close');

  if (zoomBtn && modal) {
    function openModal() {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
    function closeModal() {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }

    zoomBtn.addEventListener('click', openModal);
    backdrop?.addEventListener('click', closeModal);
    closeBtn?.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });
  }
</script>

<script define:vars={{ refreshUrl, showRefreshBtn }}>
  if (showRefreshBtn) {
    const btn = document.getElementById('refresh-metadata-btn');
    if (btn) {
      btn.addEventListener('click', async () => {
        const icon = document.getElementById('refresh-icon');
        const label = document.getElementById('refresh-label');
        if (!label || !icon) return;

        btn.setAttribute('disabled', 'true');
        btn.classList.add('opacity-60', 'cursor-not-allowed');
        icon.classList.add('animate-spin');
        label.textContent = 'Refreshing...';

        try {
          const res = await fetch(refreshUrl, {
            method: 'POST',
          });
          if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            throw new Error(data.detail || 'Refresh failed');
          }
          label.textContent = 'Done!';
          icon.classList.remove('animate-spin');
          setTimeout(() => { window.location.reload(); }, 800);
        } catch (err) {
          icon.classList.remove('animate-spin');
          label.textContent = 'Refresh failed';
          btn.removeAttribute('disabled');
          btn.classList.remove('opacity-60', 'cursor-not-allowed');
          setTimeout(() => { label.textContent = 'Refresh Metadata'; }, 3000);
        }
      });
    }
  }

</script>

<script>
  const releaseBtn = document.getElementById('release-schedule-btn');
  const releasePopover = document.getElementById('release-schedule-popover');

  if (releaseBtn && releasePopover) {
    releaseBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const hidden = releasePopover.classList.toggle('hidden');
      if (!hidden) {
        const rect = releaseBtn.getBoundingClientRect();
        const popW = releasePopover.offsetWidth;
        const left = Math.min(rect.left + window.scrollX, window.innerWidth - popW - 8);
        releasePopover.style.left = `${Math.max(8, left)}px`;
        releasePopover.style.top = `${rect.bottom + window.scrollY + 6}px`;
      }
    });
    document.addEventListener('click', (e) => {
      if (!releasePopover.classList.contains('hidden') && !releasePopover.contains(e.target as Node)) {
        releasePopover.classList.add('hidden');
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') releasePopover.classList.add('hidden');
    });
  }
</script>
