---
import type { CrewCredit } from "../lib/api";
import CrewCard from "./CrewCard.astro";

interface Props {
  crew?: CrewCredit[] | null;
  title?: string;
  showEpisodeCounts?: boolean;
}

const { crew = [], title = "Crew", showEpisodeCounts = false } = Astro.props;

// Key roles each get their own group; everyone else is under "Show all crew".
const crewGroups = [
  { title: "Director", jobs: ["Director"] },
  { title: "TV Series Creators", jobs: ["Creator"] },
  { title: "Writers", jobs: ["Writer", "Staff Writer", "Head Writer", "Screenplay", "Story", "Screenstory", "Teleplay", "Adaptation", "Series Composition"] },
  { title: "Original Work", jobs: ["Based On", "Novel", "Book", "Comic Book", "Original Story", "Original Material By", "Characters"] },
  { title: "Executive producers", jobs: ["Executive Producer"] },
  { title: "Producers", jobs: ["Producer", "Supervising Producer", "Line Producer", "Associate Producer"] },
  { title: "Co-producers", jobs: ["Co-Producer"] },
  { title: "Composer", jobs: ["Original Music Composer", "Composer", "Music"] },
  { title: "Cinematographer", jobs: ["Director of Photography", "Cinematography"] },
];

const knownJobs = crewGroups.flatMap((group) => group.jobs);

const uniqueCredits = (people: CrewCredit[]) => people.filter((person, index, list) => list.findIndex(
  (candidate) => candidate.tmdb_id === person.tmdb_id && candidate.job === person.job,
) === index);

// "Based On" credits come from Wikipedia (backend core/source_work.py). When a
// title has them they are its Original Work, and TMDB's own source-type
// credits (often a single episode's "Characters") move to "Show all crew".
const sourceJobs = crewGroups.find((group) => group.title === "Original Work")!.jobs;
const hasBasedOn = (crew ?? []).some((person) => person.job === "Based On");
const demoted = (person: CrewCredit) =>
  hasBasedOn && sourceJobs.includes(person.job) && person.job !== "Based On";

const groups = crewGroups
  .map(({ title: groupTitle, jobs }) => ({
    title: groupTitle,
    members: uniqueCredits((crew ?? []).filter((person) => jobs.includes(person.job) && !demoted(person))),
  }))
  .filter((group) => group.members.length > 0);
const otherCrew = uniqueCredits((crew ?? []).filter((person) => !knownJobs.includes(person.job) || demoted(person)));

const roleOf = (person: CrewCredit) =>
  `${person.job}${showEpisodeCounts && person.episode_count ? ` · ${person.episode_count} episodes` : ""}`;
---

{crew && crew.length > 0 && (
  <section class="page-section">
    <h2 class="text-3xl font-black text-zinc-100 tracking-tighter uppercase page-section-head">{title}</h2>
    <!-- Groups sit side by side; a group too wide for the row scrolls on its own. -->
    <div class="flex flex-wrap gap-x-12 gap-y-10">
      {groups.map(({ title: groupTitle, members }) => (
        <section class="min-w-0 max-w-full">
          <h3 class="text-lg font-black text-zinc-200 tracking-tight uppercase mb-4">{groupTitle}</h3>
          <div class="crew-row flex gap-4 overflow-x-auto pb-3">
            {members.map((person) => <CrewCard person={person} role={roleOf(person)} />)}
          </div>
        </section>
      ))}
    </div>
    {otherCrew.length > 0 && (
      <details class="crew-more mt-10">
        <summary class="inline-flex cursor-pointer list-none text-sm font-bold text-zinc-400 hover:text-zinc-100 transition-colors">
          <span class="crew-more-show">Show all crew ({otherCrew.length})</span>
          <span class="crew-more-hide">Hide other crew</span>
        </summary>
        <div class="mt-6 grid grid-cols-[repeat(auto-fill,minmax(150px,1fr))] gap-4">
          {otherCrew.map((person) => <CrewCard person={person} role={roleOf(person)} />)}
        </div>
      </details>
    )}
  </section>
)}

<style>
  .crew-more summary::-webkit-details-marker { display: none; }
  .crew-more .crew-more-hide,
  .crew-more[open] .crew-more-show { display: none; }
  .crew-more[open] .crew-more-hide { display: inline; }
</style>
