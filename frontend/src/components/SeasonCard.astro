---
import type { SeasonMeta, SeasonState } from "../lib/api";

import wRed from "../assets/watchd-w-red.png";
import wWhite from "../assets/watchd-w-white.png";

// Season card for a show page's Seasons grid, in the same style as PosterCard
// (styles/poster-card.css). Seasons are not rated or listed, so the strip has
// Watched and Collection, with the season's TMDB score where PosterCard shows
// IMDb. The data-card attributes match ActionBar's season mode, so Base.astro's
// shared handlers mark or collect the whole season.
interface Props {
    showTmdbId: number;
    season: SeasonMeta;
    state: SeasonState;
    fallbackPoster?: string | null;
    episodeCount: number;
}

const { showTmdbId, season, state, fallbackPoster = null, episodeCount } = Astro.props;

const num = season.season_number;
const href = `/show/${showTmdbId}/season/${num}`;
const poster = season.poster_path || fallbackPoster;
const title = season.name || (num === 0 ? "Specials" : `Season ${num}`);
const year = season.air_date?.slice(0, 4) ?? null;

const watchPct = state.watch_pct ?? 0;
const watched = state.watched;
const collectionPct = state.collection_pct ?? 0;
const inLibrary = state.in_library;

// Progress counts aired episodes (state.episode_count); the footer shows the
// season's full episode count.
const total = state.episode_count ?? episodeCount;
const done = state.watched_count ?? null;
const progress = watchPct > 0 ? Math.max(0, Math.min(100, Number(watchPct))) : null;
const progressTip =
    progress === null
        ? ""
        : done !== null && total
            ? `${done} of ${total} episodes watched · ${progress}%`
            : `${progress}% watched`;

const score = season.tmdb_rating != null && season.tmdb_rating > 0 ? season.tmdb_rating.toFixed(1) : null;
---

<div
    class="wd-poster-card"
    data-card
    data-tmdb-id={String(showTmdbId)}
    data-media-type="series"
    data-season={String(num)}
>

    <div class="wd-panel">

        <a href={href} class="wd-poster-link">
            {poster ? (
                <img src={poster} alt={title} class="wd-poster" loading="lazy" />
            ) : (
                <div class="wd-poster-empty">
                    <span>{title}</span>
                </div>
            )}
        </a>

        <div class="wd-strip">

            <div class="wd-actions">

                <button
                    type="button"
                    class="wd-btn"
                    data-action="watched"
                    data-watched={String(watched)}
                    data-watch-pct={String(watchPct)}
                    data-state={watchPct >= 100 ? "active" : "inactive"}
                    title={`${watchPct}% watched`}
                    aria-label={watched ? "Mark season as unwatched" : "Mark season as watched"}
                >
                    <img
                        src={watchPct >= 100 ? wRed.src : wWhite.src}
                        data-watchd-red={wRed.src}
                        data-watchd-white={wWhite.src}
                        alt=""
                        width="25"
                        height="22"
                        class="wd-w"
                    />
                </button>

                <button
                    type="button"
                    class="wd-btn"
                    data-action="collected"
                    data-in-library={String(inLibrary)}
                    data-collection-pct={String(collectionPct)}
                    data-disc-id={state.disc_id ? String(state.disc_id) : undefined}
                    data-state={collectionPct > 0 ? "active" : "inactive"}
                    title={state.disc_id ? "Open your disc" : "Add a disc"}
                    aria-label={inLibrary ? "Remove season from collection" : "Add season to collection"}
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"/>
                        <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
                        <path d="M15 22v-4a3 3 0 0 0-6 0v4"/>
                        <path d="M2 7h20"/>
                    </svg>
                </button>

            </div>

            <div class="wd-rating" title={score ? `TMDB ${score}` : "No TMDB rating"}>
                <span class="wd-tmdb">TMDB</span>
                <span class:list={["wd-score wd-score--tmdb", { "wd-score--none": !score }]}>{score ?? "—"}</span>
            </div>

        </div>

        {progress !== null && (
            <div class="wd-progress" tabindex="0" role="img" aria-label={progressTip}>
                <div class="wd-progress-fill" style={`width:${progress}%`}></div>
            </div>
        )}

    </div>

    <a href={href} class="wd-meta">
        <div class="wd-title">{title}</div>
        {progress !== null && <div class="wd-tip">{progressTip}</div>}
        <div class="wd-year">
            {episodeCount} {episodeCount === 1 ? "episode" : "episodes"}{year && ` · ${year}`}
        </div>
    </a>

</div>
