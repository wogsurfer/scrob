---
// The add/edit form for a release in the physical collection, with every
// Collectorz field. Pick-list fields drop down the values already used (or
// take a new one); list fields (audio, subtitles...) are tick lists.
import type { PhysicalDetail } from "../lib/api";

interface Props {
  item?: Partial<PhysicalDetail> | null;
  options: Record<string, string[]>;
  /** Suggested cover for a new release (a TMDB poster or shop photo). */
  coverUrl?: string | null;
}

const { item, options, coverUrl } = Astro.props;
const s: Record<string, any> = item?.specs ?? {};
const v = (x: unknown) => (x == null ? "" : String(x));
// A tick list's entries: the release's own values first (in their order),
// then every other value used across the collection.
const ticks = (key: string) => {
  const mine: string[] = s[key] ?? [];
  return [...mine.map((o) => ({ o, on: true })), ...(options[key] ?? []).filter((o) => !mine.includes(o)).map((o) => ({ o, on: false }))];
};
const isEdit = !!item?.id;
const lists: { key: string; label: string; hint: string }[] = [
  { key: "regions", label: "Regions", hint: "Region A" },
  { key: "ratios", label: "Aspect ratios", hint: "Widescreen (2.39:1)" },
  { key: "audio", label: "Audio tracks", hint: "DTS-HD Master Audio 5.1 [English]" },
  { key: "subtitles", label: "Subtitles", hint: "English (SDH)" },
  { key: "features", label: "On the disc", hint: "Feature Film" },
  { key: "extras", label: "In the box", hint: "Booklet" },
];
---

<form id="phys-form" class="pf" data-id={item?.id ?? ""} novalidate>
  {["format", "edition", "package", "distributor", "store", "condition", "location", "owner", "series", "in_set", "audience_rating", "adaptation_of", "layers", "hdr", "color"].map((k) => (
    <datalist id={`pf-${k}`}>{(options[k] ?? []).map((o) => <option value={o} />)}</datalist>
  ))}

  <section class="pf-card">
    <h2>Main</h2>
    <div class="pf-grid">
      <label class="pf-wide">Title<input name="title" required value={v(item?.title)} /></label>
      <label>Sort title<input name="sort_title" value={v(isEdit ? item?.own_sort_title : item?.sort_title)} placeholder={item?.auto_sort ? `Blank: files as “${item.auto_sort}”` : "Leave blank to sort by title"} /></label>
      <label>Release year<input name="release_year" type="number" min="1880" max="2100" value={v(item?.release_year)} /></label>
      <label>Status
        <select name="status">
          <option value="owned" selected={(item?.status ?? "owned") === "owned"}>In collection</option>
          <option value="wishlist" selected={item?.status === "wishlist"}>Wish list</option>
          <option value="ordered" selected={item?.status === "ordered"}>On order</option>
          <option value="for_sale" selected={item?.status === "for_sale"}>For sale</option>
          <option value="sold" selected={item?.status === "sold"}>Sold</option>
        </select>
      </label>
      <label>TMDB id<input name="tmdb_id" type="number" value={v(item?.tmdb_id)} /></label>
      <label>TMDB type
        <select name="specs.tmdb_kind">
          <option value="movie" selected={(s.tmdb_kind ?? "movie") === "movie"}>Film</option>
          <option value="tv" selected={s.tmdb_kind === "tv"}>TV series</option>
        </select>
      </label>
      <label class="pf-check"><input type="checkbox" name="is_tv" checked={!!item?.is_tv} /> TV series release</label>
      <label class="pf-check"><input type="checkbox" name="is_set" checked={!!item?.is_set} /> Box set or disc with several films</label>
      <label>Series<input name="series" data-combo="pf-series" value={v(item?.series)} /></label>
      <label id="pf-in-set" hidden={!!item?.is_set}>Part of a set<input name="in_set" data-combo="pf-in_set" value={v(item?.parent?.title ?? (item as any)?.in_set)} placeholder="Box set or double feature it's on" /></label>
      <label>Title extension<input name="specs.title_extension" value={v(s.title_extension)} /></label>
      <label>Original title<input name="specs.original_title" value={v(s.original_title)} /></label>
      <label>Adaptation of<input name="specs.adaptation_of" data-combo="pf-adaptation_of" value={v(s.adaptation_of)} placeholder="Novel, Comics, TV Series…" /></label>
      <label class="pf-wide">Based on<input name="specs.adapted_titles" value={v(s.adapted_titles)} placeholder='"The A-Team"' /></label>
      <label class="pf-full">Tagline<input name="specs.tagline" value={v(s.tagline)} /></label>
      <label class="pf-full">Plot<textarea name="specs.plot" rows="3">{v(s.plot)}</textarea></label>
    </div>
  </section>

  <section class="pf-card">
    <h2>Edition</h2>
    <div class="pf-grid">
      <label>Format<input name="format" data-combo="pf-format" value={v(item?.format)} /></label>
      <label class="pf-wide">Edition<input name="edition" data-combo="pf-edition" value={v(item?.edition)} placeholder="2 Disc: 4K Ultra HD + Blu-ray + Digital Code" /></label>
      <label>Distributor<input name="distributor" data-combo="pf-distributor" value={v(item?.distributor)} /></label>
      <label>Barcode<input name="barcode" inputmode="numeric" value={v(item?.barcode)} /></label>
      <label>Packaging<input name="package" data-combo="pf-package" value={v(item?.package)} /></label>
      <label>Discs<input name="disc_count" type="number" min="1" value={v(item?.disc_count)} /></label>
      <label>Disc release date<input name="disc_release_date" type="date" value={v(item?.disc_release_date)} /></label>
      <label>Running time (min)<input name="runtime" type="number" min="1" value={v(item?.runtime)} /></label>
      <label>Age rating<input name="specs.audience_rating" data-combo="pf-audience_rating" value={v(s.audience_rating)} /></label>
      <label>Layers<input name="specs.layers" data-combo="pf-layers" value={v(s.layers)} placeholder="Single Side, Dual Layer" /></label>
      <label>HDR<input name="specs.hdr" data-combo="pf-hdr" value={v(s.hdr)} placeholder="HDR10, Dolby Vision" /></label>
      <label>Colour<input name="specs.color" data-combo="pf-color" value={v(s.color)} placeholder="Color" /></label>
    </div>
  </section>

  <section class="pf-card">
    <h2>Picture, sound and extras</h2>
    <p class="pf-hint">Tick what this release has. Type in a box to find a value, or press Enter to add a new one. Tidy the lists on the <a href="/collection/picklists" target="_blank">Pick Lists</a> page.</p>
    <div class="pf-grid pf-lists">
      {lists.map((l) => (
        <div class="pf-ticks" data-key={l.key}>
          <p class="pf-ticks-label">{l.label} <span class="pf-ticks-count"></span></p>
          <input class="pf-ticks-find" placeholder={`Find or add, e.g. ${l.hint}`} autocomplete="off" />
          <div class="pf-ticks-list">
            {ticks(l.key).map(({ o, on }) => (
              <label class="pf-tick"><input type="checkbox" name={`list.${l.key}`} value={o} checked={on} /><span>{o}</span></label>
            ))}
          </div>
        </div>
      ))}
      <label class="pf-full">Extra features<textarea name="specs.extra_features" rows="6">{v(s.extra_features)}</textarea></label>
    </div>
  </section>

  <section class="pf-card">
    <h2>Personal</h2>
    <div class="pf-grid">
      <label>Purchase date<input name="purchase_date" type="date" value={v(item?.purchase_date)} /></label>
      <label>Price paid<input name="purchase_price" type="number" step="0.01" min="0" value={v(item?.purchase_price)} /></label>
      <label>Current value<input name="current_value" type="number" step="0.01" min="0" value={v(item?.current_value)} /></label>
      <label>Store<input name="store" data-combo="pf-store" value={v(item?.store)} /></label>
      <label>Condition<input name="condition" data-combo="pf-condition" value={v(item?.condition)} /></label>
      <label>Location<input name="location" data-combo="pf-location" value={v(item?.location)} /></label>
      <label>Owner<input name="owner" data-combo="pf-owner" value={v(item?.owner)} /></label>
      <label>Index<input name="index_no" type="number" min="0" value={v(item?.index_no)} /></label>
      <label>My rating (out of 10)<input name="my_rating" type="number" min="1" max="10" value={v(item?.my_rating)} /></label>
      <label>Seen in cinema
        <select name="specs.seen_in_cinema">
          {["", "Yes", "No", "Not Applicable"].map((o) => <option value={o} selected={(s.seen_in_cinema ?? "") === o}>{o || "—"}</option>)}
        </select>
      </label>
      <label class="pf-check"><input type="checkbox" name="seen_it" checked={!!item?.seen_it} /> Seen (besides Watchd history)</label>
      <label>Tags<input name="tags" value={(item?.tags ?? []).join(", ")} placeholder="mcu, phase4" /></label>
      <label class="pf-full">Notes<textarea name="notes" rows="3">{v(item?.notes)}</textarea></label>
    </div>
  </section>

  <section class="pf-card">
    <h2>Artwork</h2>
    {!isEdit && (
      <div class="pf-covers">
        <div class="pf-cover">
          <img id="pf-front-preview" src={coverUrl ?? ""} alt="" hidden={!coverUrl} />
          <label>Front cover<input type="file" name="cover_front" accept="image/*" /></label>
          {coverUrl && <input type="hidden" name="cover_url" value={coverUrl} />}
        </div>
        <p class="pf-hint">You can change the poster and backdrop once the disc is saved.</p>
      </div>
    )}
    {isEdit && (
      <div class="pf-art-grid" data-item={item?.id}>
        {[
          { slot: "front", label: "Front cover", src: item?.front_cover, own: !!item?.front_cover, tmdb: "posters", wide: false },
          { slot: "poster", label: "Poster", src: item?.poster, own: !!item?.poster_is_own, tmdb: "posters", wide: false },
          { slot: "backdrop", label: "Backdrop", src: item?.backdrop, own: !!item?.backdrop_is_own, tmdb: "backdrops", wide: true },
        ].map((a) => (
          <div class:list={["pf-art", { wide: a.wide }]} data-slot={a.slot} data-tmdb={a.tmdb}>
            <p class="pf-art-label">{a.label} <span class="pf-art-source">{a.own ? "Your own" : a.src ? "From TMDB" : "None"}</span></p>
            <div class="pf-art-preview">{a.src ? <img src={a.src} alt="" /> : <span>No image</span>}</div>
            <div class="pf-art-actions">
              <label class="pf-art-btn">Upload<input type="file" accept="image/*" hidden /></label>
              <button type="button" class="pf-art-btn" data-act="link">Use a link</button>
              {item?.tmdb_id && <button type="button" class="pf-art-btn" data-act="pick">Pick from TMDB</button>}
              <button type="button" class="pf-art-btn danger" data-act="remove" hidden={!a.own}>{a.slot === "front" ? "Remove" : "Use TMDB's"}</button>
            </div>
            <div class="pf-art-picker" hidden></div>
          </div>
        ))}
      </div>
    )}
  </section>

  <div class="pf-actions">
    <button type="submit" class="pf-save">{isEdit ? "Save changes" : "Add to collection"}</button>
    <a class="pf-cancel" href={isEdit ? `/collection?item=${item?.id}` : "/collection"}>Cancel</a>
    {isEdit && <button type="button" class="pf-delete" id="pf-delete">Delete disc</button>}
    <p class="pf-error" id="pf-error" hidden></p>
  </div>
</form>

<script>
  const form = document.getElementById("phys-form") as HTMLFormElement | null;
  if (form) {
    const id = form.dataset.id;
    const errorEl = document.getElementById("pf-error")!;
    const showError = (msg: string) => { errorEl.textContent = msg; errorEl.hidden = false; };

    // Adding: a preview of the picked front cover.
    form.querySelector<HTMLInputElement>('input[name="cover_front"]')?.addEventListener("change", (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      const img = document.getElementById("pf-front-preview") as HTMLImageElement;
      if (file) { img.src = URL.createObjectURL(file); img.hidden = false; }
    });

    // Editing: each image changes straight away.
    document.querySelectorAll<HTMLElement>(".pf-art").forEach((box) => {
      const slot = box.dataset.slot!;
      const preview = box.querySelector<HTMLElement>(".pf-art-preview")!;
      const source = box.querySelector<HTMLElement>(".pf-art-source")!;
      const removeBtn = box.querySelector<HTMLButtonElement>('[data-act="remove"]')!;
      const picker = box.querySelector<HTMLElement>(".pf-art-picker")!;
      const show = (src: string | null, own: boolean) => {
        preview.innerHTML = src ? `<img src="${src}" alt="" />` : "<span>No image</span>";
        source.textContent = own ? "Your own" : src ? "From TMDB" : "None";
        removeBtn.hidden = !own;
      };
      const busy = (on: boolean) => box.classList.toggle("busy", on);
      const done = async (res: Response) => {
        busy(false);
        if (!res.ok) return showError((await res.json().catch(() => ({}))).detail || "That didn't work");
        errorEl.hidden = true;
        const data = await res.json();
        if (data.cover) show(data.cover, true);
        else {
          // Removed: a poster or backdrop falls back to TMDB's.
          const d = await fetch(`/api/proxy/physical/items/${id}`).then((r) => r.json());
          show(slot === "front" ? null : slot === "poster" ? d.poster : d.backdrop, false);
        }
      };
      const setFromLink = async (url: string) => {
        busy(true);
        done(await fetch(`/api/proxy/physical/items/${id}/art-link`, {
          method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ side: slot, url }),
        }));
      };

      box.querySelector<HTMLInputElement>('input[type="file"]')!.addEventListener("change", async (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;
        const up = new FormData();
        up.append("file", file);
        busy(true);
        done(await fetch(`/api/proxy/physical/items/${id}/cover?side=${slot}`, { method: "POST", body: up }));
      });
      box.addEventListener("click", async (e) => {
        const act = (e.target as HTMLElement).closest<HTMLElement>("[data-act]")?.dataset.act;
        const pick = (e.target as HTMLElement).closest<HTMLElement>("[data-pick]");
        if (pick) { picker.hidden = true; return setFromLink(pick.dataset.pick!); }
        if (act === "link") {
          const url = prompt("Paste a link to the image (https://…)");
          if (url) setFromLink(url);
        } else if (act === "remove") {
          busy(true);
          done(await fetch(`/api/proxy/physical/items/${id}/art?side=${slot}`, { method: "DELETE" }));
        } else if (act === "pick") {
          if (!picker.hidden) { picker.hidden = true; return; }
          picker.hidden = false;
          picker.innerHTML = "<p class='pf-hint'>Loading TMDB's images…</p>";
          const imgs = await fetch(`/api/proxy/physical/items/${id}/tmdb-images`).then((r) => r.json()).catch(() => null);
          const list: string[] = imgs?.[box.dataset.tmdb!] ?? [];
          picker.innerHTML = list.length
            ? list.map((u) => `<button type="button" data-pick="${u}"><img src="${u}" alt="" loading="lazy" /></button>`).join("")
            : "<p class='pf-hint'>TMDB has no images for this one.</p>";
        }
      });
    });

    // Pick-list fields: an arrow that drops down every value used so far,
    // narrowed as you type; anything new can still be typed in.
    form.querySelectorAll<HTMLInputElement>("input[data-combo]").forEach((input) => {
      const values = [...document.querySelectorAll<HTMLOptionElement>(`#${input.dataset.combo} option`)].map((o) => o.value);
      const wrap = document.createElement("div");
      wrap.className = "pf-combo";
      input.replaceWith(wrap);
      const arrow = document.createElement("button");
      arrow.type = "button";
      arrow.className = "pf-combo-arrow";
      arrow.tabIndex = -1;
      arrow.setAttribute("aria-label", "Show all");
      const menu = document.createElement("div");
      menu.className = "pf-combo-menu";
      menu.hidden = true;
      wrap.append(input, arrow, menu);
      input.autocomplete = "off";
      let active = -1;

      const render = (all: boolean) => {
        const q = input.value.trim().toLowerCase();
        const shown = all || !q ? values : values.filter((x) => x.toLowerCase().includes(q));
        active = -1;
        menu.innerHTML = shown.length
          ? shown.map((x) => `<button type="button" class="pf-combo-opt${x === input.value ? " on" : ""}" data-v="${x.replace(/"/g, "&quot;")}"></button>`).join("")
          : `<p class="pf-combo-none">${values.length ? "No match: it'll be saved as a new value" : "Nothing used yet: type a value"}</p>`;
        menu.querySelectorAll<HTMLElement>(".pf-combo-opt").forEach((b) => (b.textContent = b.dataset.v!));
        menu.hidden = false;
        menu.querySelector(".on")?.scrollIntoView({ block: "nearest" });
      };
      const close = () => { menu.hidden = true; };
      const pick = (x: string) => { input.value = x; close(); input.dispatchEvent(new Event("change", { bubbles: true })); };
      const move = (d: number) => {
        const opts = [...menu.querySelectorAll<HTMLElement>(".pf-combo-opt")];
        if (!opts.length) return;
        active = (active + d + opts.length) % opts.length;
        opts.forEach((o, i) => o.classList.toggle("active", i === active));
        opts[active].scrollIntoView({ block: "nearest" });
      };

      arrow.addEventListener("click", (e) => {
        e.preventDefault();
        if (menu.hidden) { render(true); input.focus(); } else close();
      });
      input.addEventListener("input", () => render(false));
      input.addEventListener("keydown", (e) => {
        if (e.key === "ArrowDown") { e.preventDefault(); if (menu.hidden) render(true); else move(1); }
        else if (e.key === "ArrowUp") { e.preventDefault(); move(-1); }
        else if (e.key === "Escape") close();
        else if (e.key === "Enter" && !menu.hidden) {
          e.preventDefault();
          const opt = menu.querySelectorAll<HTMLElement>(".pf-combo-opt")[active];
          if (opt) pick(opt.dataset.v!); else close();
        }
      });
      menu.addEventListener("mousedown", (e) => e.preventDefault());
      menu.addEventListener("click", (e) => {
        const opt = (e.target as HTMLElement).closest<HTMLElement>(".pf-combo-opt");
        if (opt) pick(opt.dataset.v!);
      });
      input.addEventListener("blur", close);
    });

    // Tick lists: find a value, or add a new one with Enter.
    form.querySelectorAll<HTMLElement>(".pf-ticks").forEach((box) => {
      const find = box.querySelector<HTMLInputElement>(".pf-ticks-find")!;
      const list = box.querySelector<HTMLElement>(".pf-ticks-list")!;
      const count = box.querySelector<HTMLElement>(".pf-ticks-count")!;
      const boxes = () => [...list.querySelectorAll<HTMLInputElement>("input[type=checkbox]")];
      const recount = () => {
        const n = boxes().filter((c) => c.checked).length;
        count.textContent = n ? `${n} ticked` : "";
      };
      const filter = () => {
        const q = find.value.trim().toLowerCase();
        for (const c of boxes()) c.closest<HTMLElement>(".pf-tick")!.hidden = !!q && !c.value.toLowerCase().includes(q);
      };
      find.addEventListener("input", filter);
      find.addEventListener("keydown", (e) => {
        if (e.key !== "Enter") return;
        e.preventDefault();
        const value = find.value.trim();
        if (!value) return;
        const existing = boxes().find((c) => c.value.toLowerCase() === value.toLowerCase());
        if (existing) existing.checked = true;
        else {
          // New values go after the ticked ones, so the order stays as entered.
          const row = document.createElement("label");
          row.className = "pf-tick";
          row.innerHTML = `<input type="checkbox" name="list.${box.dataset.key}" checked /><span></span>`;
          row.querySelector("input")!.value = value;
          row.querySelector("span")!.textContent = value;
          const lastOn = boxes().filter((c) => c.checked).pop()?.closest(".pf-tick");
          if (lastOn) lastOn.after(row); else list.prepend(row);
        }
        find.value = "";
        filter();
        recount();
      });
      list.addEventListener("change", recount);
      recount();
    });

    // A set isn't inside another set.
    form.querySelector<HTMLInputElement>('input[name="is_set"]')!.addEventListener("change", (e) => {
      document.getElementById("pf-in-set")!.hidden = (e.target as HTMLInputElement).checked;
    });

    const numberFields = ["release_year", "tmdb_id", "disc_count", "runtime", "index_no", "my_rating"];
    const decimalFields = ["purchase_price", "current_value"];

    function collect() {
      const fd = new FormData(form!);
      const body: Record<string, any> = { specs: {} };
      // Tick lists with nothing ticked are cleared.
      form!.querySelectorAll<HTMLElement>(".pf-ticks").forEach((b) => (body.specs[b.dataset.key!] = null));
      for (const [name, raw] of fd.entries()) {
        if (raw instanceof File || name === "cover_url") continue;
        const value = String(raw).trim();
        if (name.startsWith("specs.")) body.specs[name.slice(6)] = value || null;
        else if (name.startsWith("list.")) body.specs[name.slice(5)] = [...(body.specs[name.slice(5)] ?? []), value];
        else if (name === "tags") body.tags = value ? value.split(",").map((x) => x.trim()).filter(Boolean) : [];
        else if (numberFields.includes(name)) body[name] = value ? parseInt(value, 10) : null;
        else if (decimalFields.includes(name)) body[name] = value ? parseFloat(value) : null;
        else body[name] = value || null;
      }
      body.is_tv = form!.querySelector<HTMLInputElement>('input[name="is_tv"]')!.checked;
      body.is_set = form!.querySelector<HTMLInputElement>('input[name="is_set"]')!.checked;
      if (body.is_set) delete body.in_set;
      body.seen_it = form!.querySelector<HTMLInputElement>('input[name="seen_it"]')!.checked;
      const coverUrl = form!.querySelector<HTMLInputElement>('input[name="cover_url"]');
      if (coverUrl && !form!.querySelector<HTMLInputElement>('input[name="cover_front"]')?.files?.length) body.cover_url = coverUrl.value;
      return body;
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorEl.hidden = true;
      const body = collect();
      if (!body.title) return showError("A title is needed.");
      const save = form.querySelector<HTMLButtonElement>(".pf-save")!;
      save.disabled = true;
      try {
        const res = await fetch(id ? `/api/proxy/physical/items/${id}` : "/api/proxy/physical/items", {
          method: id ? "PATCH" : "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        if (!res.ok) throw new Error((await res.json().catch(() => ({}))).detail || "Couldn't save");
        const saved = await res.json();
        const file = form.querySelector<HTMLInputElement>('input[name="cover_front"]')?.files?.[0];
        if (file) {
          const up = new FormData();
          up.append("file", file);
          const r = await fetch(`/api/proxy/physical/items/${saved.id}/cover?side=front`, { method: "POST", body: up });
          if (!r.ok) throw new Error("Saved, but the cover didn't upload");
        }
        location.href = `/collection?${body.status === "wishlist" ? "status=wishlist&" : ""}item=${saved.id}`;
      } catch (err) {
        showError(err instanceof Error ? err.message : "Couldn't save");
        save.disabled = false;
      }
    });

    document.getElementById("pf-delete")?.addEventListener("click", async () => {
      if (!confirm("Delete this disc from your collection? This can't be undone.")) return;
      const res = await fetch(`/api/proxy/physical/items/${id}`, { method: "DELETE" });
      if (res.ok) location.href = "/collection";
      else showError("Couldn't delete it");
    });
  }
</script>

<style>
  .pf { display: flex; flex-direction: column; gap: 16px; max-width: 980px; }
  .pf-card { padding: 18px; border-radius: 18px; background: #0a0a0a; border: 1px solid #1c1c1f; }
