---
// Awards for a show, film or person: a list of wins and nominations, each
// with a small emblem for its award body. Filled after load from `endpoint`
// (an /api/proxy URL returning { awards: [...] }); shows "Loading…" until then
// and hides itself when there are none. Rows end with the nominee's name
// (person_name) or, on a person's page, the film or show (work_title).
// Names worked out from the credits rather than on record (name_inferred)
// are shown fainter, with a tooltip saying so.
interface Props {
  endpoint: string;
}

const { endpoint } = Astro.props;
---

<section id="awards" class="hidden mt-10 mb-4">
  <div class="flex items-baseline justify-between gap-4 mb-4">
    <h2 class="section-headline">Awards</h2>
    <span id="awards-count" class="text-sm font-bold text-zinc-500"></span>
  </div>
  <ul id="awards-list" class="divide-y divide-zinc-800/70 border-y border-zinc-800/70"></ul>
  <button id="awards-more" type="button" class="hidden mt-3 text-sm font-bold text-zinc-400 hover:text-zinc-100 transition-colors"></button>
</section>

<script define:vars={{ endpoint }}>
  const awardsSection = document.getElementById('awards');
  const awardsCount = document.getElementById('awards-count');
  const awardsList = document.getElementById('awards-list');
  const awardsMore = document.getElementById('awards-more');
  const AWARDS_SHOWN = 8;

  // Small drawn emblems per award body (currentColor: gold for wins, grey
  // for nominations), with a trophy for anything not listed.
  const svg = (body) => `<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">${body}</svg>`;
  const EMBLEMS = {
    // Winged figure holding an atom
    emmy: svg('<circle cx="12" cy="3.2" r="2.2" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M12 5.6c-.9 0-1.5.7-1.5 1.6v3.3L6 6.8c.4 3.1 2 5 4.5 5.7V17h3v-4.5c2.5-.7 4.1-2.6 4.5-5.7l-4.5 3.7V7.2c0-.9-.6-1.6-1.5-1.6z"/><path d="M9 17.5h6l1 2.5H8z"/><rect x="7" y="20.5" width="10" height="2" rx=".5"/>'),
    // Globe on a pedestal
    globe: svg('<circle cx="12" cy="8.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.4"/><ellipse cx="12" cy="8.5" rx="2.8" ry="6.5" fill="none" stroke="currentColor" stroke-width="1.1"/><path d="M5.5 8.5h13" stroke="currentColor" stroke-width="1.1"/><path d="M10 15.5h4l1.5 4h-7z"/><rect x="7" y="20" width="10" height="2.5" rx=".5"/>'),
    // Statuette
    oscar: svg('<circle cx="12" cy="3" r="1.9"/><path d="M10.4 5.4h3.2l.6 4.8-.9.4.4 7.4h-3.4l.4-7.4-.9-.4z"/><rect x="9" y="18.2" width="6" height="1.6" rx=".4"/><rect x="8" y="20.4" width="8" height="2.2" rx=".5"/>'),
    // Theatre mask
    mask: svg('<path d="M4 3.5c2.6 1 5.3 1.5 8 1.5s5.4-.5 8-1.5v7.5c0 5.2-3.6 9.5-8 9.5s-8-4.3-8-9.5z"/><path d="M7.2 9.3c.8-.8 2-.8 2.8 0M14 9.3c.8-.8 2-.8 2.8 0M8.5 14.5c2.1 1.6 4.9 1.6 7 0" fill="none" stroke="#18181b" stroke-width="1.4" stroke-linecap="round"/>'),
    // Generic trophy
    trophy: svg('<path d="M7 3h10v5a5 5 0 0 1-10 0z"/><path d="M7 5H4.5v1.5A3.5 3.5 0 0 0 8 10M17 5h2.5v1.5A3.5 3.5 0 0 1 16 10" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M10.8 13h2.4v4h-2.4z"/><path d="M8 17.5h8l.8 2.5H7.2z"/><rect x="6.5" y="20.5" width="11" height="2" rx=".5"/>'),
  };
  const emblemFor = (name = '') => {
    const n = name.toLowerCase();
    if (n.includes('emmy')) return EMBLEMS.emmy;
    if (n.includes('golden globe')) return EMBLEMS.globe;
    if (n.includes('academy award') || n.includes('oscar')) return EMBLEMS.oscar;
    if (n.includes('bafta') || n.includes('british academy') || n.includes('screen actors') || n.includes('sag')) return EMBLEMS.mask;
    return EMBLEMS.trophy;
  };
  const esc = (v) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  // Who or what the nomination was for: the nominee, or on a person's page
  // the film or show, linked when it is known.
  const INFERRED_TITLE = 'Worked out from the credits, not from the award record';
  const subject = (a) => {
    if (a.person_name) {
      return a.name_inferred
        ? `<span class="text-zinc-500 italic" title="${INFERRED_TITLE}">${esc(a.person_name)}</span>`
        : esc(a.person_name);
    }
    if (!a.work_title) return '';
    const cls = a.name_inferred ? 'text-zinc-500 italic ' : '';
    const tip = a.name_inferred ? ` title="${INFERRED_TITLE}"` : '';
    if (!a.work_tmdb_id || !a.work_type) return `<span class="${cls}"${tip}>${esc(a.work_title)}</span>`;
    const href = a.work_type === 'series' ? `/show/${a.work_tmdb_id}` : `/media/movie/${a.work_tmdb_id}`;
    return `<a href="${href}" class="${cls}hover:text-zinc-100 hover:underline"${tip}>${esc(a.work_title)}</a>`;
  };

  const row = (a) => {
    const who = subject(a);
    return `
    <li class="flex items-center gap-3 py-2.5">
      <span class="shrink-0 ${a.is_winner ? 'text-amber-400' : 'text-zinc-500'}" title="${esc(a.award_name)}">${emblemFor(a.award_name)}</span>
      <div class="min-w-0 flex-1">
        <div class="text-sm font-bold text-zinc-200 truncate">${esc(a.category_name)}${who ? ` <span class="text-zinc-400">– ${who}</span>` : ''}</div>
        <div class="text-xs text-zinc-500 truncate">${esc(a.award_name)}${a.details ? ` · ${esc(a.details)}` : ''}</div>
      </div>
      <span class="shrink-0 text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded ${a.is_winner ? 'bg-amber-400/15 text-amber-300' : 'bg-zinc-800 text-zinc-400'}">${a.is_winner ? 'Won' : 'Nominated'}</span>
      <span class="shrink-0 w-10 text-right text-xs font-bold text-zinc-500">${esc(a.year)}</span>
    </li>`;
  };

  // While the award index is first being built the API answers
  // { pending: true }; ask again every 20s for up to 15 minutes.
  const RETRY_MS = 20000;
  const MAX_TRIES = 45;
  const load = (attempt = 1) => fetch(endpoint)
      .then(async (res) => {
        if (!res.ok) {
          throw new Error(`Awards request failed: ${res.status}`);
        }
        return res.json();
      })
      .then((data) => {
        if (data.pending && attempt < MAX_TRIES) {
          awardsCount.textContent = 'Building the award list…';
          setTimeout(() => load(attempt + 1), RETRY_MS);
          return;
        }
        // Newest first; wins before nominations within a year.
        const awards = (data.awards ?? []).slice().sort((a, b) =>
          (Number(b.year) || 0) - (Number(a.year) || 0) || Number(!!b.is_winner) - Number(!!a.is_winner));
        if (!awards.length) {
          awardsSection.classList.add('hidden');
          return;
        }

        const wins = awards.filter((a) => a.is_winner).length;
        awardsCount.textContent =
          `${wins} ${wins === 1 ? 'win' : 'wins'} · ${awards.length} ${awards.length === 1 ? 'nomination' : 'nominations'}`;

        const render = (all) => {
          awardsList.innerHTML = (all ? awards : awards.slice(0, AWARDS_SHOWN)).map(row).join('');
          awardsMore.classList.toggle('hidden', awards.length <= AWARDS_SHOWN);
          awardsMore.textContent = all ? 'Show less' : `Show all ${awards.length}`;
          awardsMore.dataset.all = String(all);
        };
        awardsMore.addEventListener('click', () => render(awardsMore.dataset.all !== 'true'));
        render(false);
        awardsSection.classList.remove('hidden');
      })
      .catch((err) => {
        console.error('Failed to load awards:', err);
        awardsSection.classList.add('hidden');
      });

  if (awardsSection && endpoint) {
    // Award lists can take a while on a cold cache: show the section as
    // loading, and hide it again if there are no awards.
    awardsCount.textContent = 'Loading…';
    awardsSection.classList.remove('hidden');
    load();
  }
</script>
