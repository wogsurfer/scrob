---
import type { WatchEvent } from "../lib/api";
import { tmdbImageUrl } from "../lib/api";
import { HOME_TIME_ZONE, WATCH_TIME_FORMAT } from "../lib/time";

interface Props {
  event: WatchEvent;
}

const { event } = Astro.props;

const media = event.media;

const isEpisode =
  media.type === "episode" ||
  media.season_number != null ||
  media.episode_number != null;

const showOrMovieTitle = isEpisode
  ? (media.show_title || media.title)
  : media.title;

const posterPath = tmdbImageUrl(
  isEpisode && media.show_poster_path
    ? media.show_poster_path
    : media.poster_path,
  "w500",
);

// Movies: an edition TMDB doesn't list on its own (e.g. an extended cut) opens
// its theatrical film's page; a movie that isn't on TMDB at all opens the
// local movie page built from its stored details.
const editionOf = (media as { edition_of?: number | null }).edition_of;
const href = isEpisode
  ? media.show_tmdb_id && media.season_number != null && media.episode_number != null
    ? `/show/${media.show_tmdb_id}/season/${media.season_number}/${media.episode_number}`
    : "#"
  : editionOf
    ? `/media/movie/${editionOf}`
    : media.tmdb_id
      ? `/media/movie/${media.tmdb_id}`
      : `/movie/local/${media.id}`;

const watchedAt = event.watched_at
  ? new Date(event.watched_at + "Z")
  : null;

const timeString = watchedAt
  ? watchedAt.toLocaleTimeString("en-US", {
      ...WATCH_TIME_FORMAT,
      timeZone: HOME_TIME_ZONE,
    })
  : "";

const year = media.release_date
  ? media.release_date.slice(0, 4)
  : null;

const episodeNumber =
  isEpisode &&
  media.season_number != null &&
  media.episode_number != null
    ? `${String(media.season_number).padStart(2, "0")}x${String(media.episode_number).padStart(2, "0")}`
    : null;
---

<a
  href={href}
  class="history-card block"
  data-event-id={event.id}
>
  <div class="poster-wrap">
    {posterPath ? (
      <img
        src={posterPath}
        alt={showOrMovieTitle}
        class="poster"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="poster-placeholder">
        <span>🎬</span>
        <span>{showOrMovieTitle}</span>
      </div>
    )}
  </div>

  <div class="content">

    {timeString && (
      <div class="time">
        {timeString}
      </div>
    )}

    {event.watch_source && (
      <div class="watch-source">
        {event.watch_source}
      </div>
    )}

    <h3 class="title">
      {showOrMovieTitle}
    </h3>

    {isEpisode ? (
      <div class="episode">
        <span class="episode-number">
          {episodeNumber}
        </span>

        <span class="episode-title">
          {media.title}
        </span>
      </div>
    ) : (
      year && (
        <div class="year">
          {year}
        </div>
      )
    )}

    {media.user_rating != null && (
      <div class="rating">
        ★ {media.user_rating % 1 === 0
          ? media.user_rating
          : media.user_rating.toFixed(1)}
      </div>
    )}

  </div>
</a>

<style>
.history-card {
  display: block;
  width: 100%;
  text-decoration: none;
}

.poster-wrap {
  width: 100%;
  aspect-ratio: 2 / 3;
  overflow: hidden;
  border-radius: 14px;
  background: #0b0b0b;
  border: 1px solid #27272a;
}

.poster {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.poster-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 16px;
  text-align: center;
  color: #52525b;
  background: #18181b;
}

.poster-placeholder span:first-child {
  font-size: 28px;
  opacity: 0.4;
}

.poster-placeholder span:last-child {
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.content {
  padding: 10px 2px 0;
}

.time {
  color: #a1a1aa;
  font-size: 12px;
  font-weight: 700;
  margin-bottom: 5px;
}

.watch-source {
  color: #71717a;
  font-size: 11px;
  font-weight: 600;
  margin: -2px 0 5px;
}

.title {
  color: #ffffff;
  font-size: 17px;
  font-weight: 800;
  line-height: 1.15;
  margin: 0 0 5px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.episode {
  display: flex;
  align-items: baseline;
  gap: 5px;
  min-width: 0;
  line-height: 1.2;
}

.episode-number {
  color: #e50914;
  font-size: 13px;
  font-weight: 800;
  flex-shrink: 0;
}

.episode-title {
  color: #71717a;
  font-size: 13px;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.year {
  color: #71717a;
  font-size: 13px;
  font-weight: 500;
}

.rating {
  color: #e50914;
  font-size: 12px;
  font-weight: 800;
  margin-top: 5px;
}
</style>
