---
interface Props {
    title: string;
    year: number;
    poster_path: string | null;
    tmdb_rating: number | null;
}

const {
    title,
    year,
    poster_path,
    tmdb_rating,
} = Astro.props;
---

<div class="movie-card">
    <img
        src={`https://image.tmdb.org/t/p/w500${poster_path}`}
        alt={title}
        class="poster"
    />

    <div class="info">

        <div class="rating">
            ★ {tmdb_rating?.toFixed(1) ?? "-"}
        </div>

        <div class="title">
            {title}
        </div>

        <div class="year">
            {year}
        </div>

    </div>
</div>

<style>
.movie-card{
    width:220px;
}

.poster{
    width:220px;
    height:330px;
    object-fit:cover;
    border-radius:12px;
    display:block;
}

.info{
    margin-top:10px;
}

.rating{
    color:#d1d5db;
    font-size:.9rem;
}

.title{
    color:white;
    font-weight:600;
    margin-top:4px;
    line-height:1.3;
}

.year{
    color:#9ca3af;
    font-size:.9rem;
    margin-top:2px;
}
</style>