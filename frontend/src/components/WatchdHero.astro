<section class="watchd-hero">
  <div class="watchd-left">
    <p class="watchd-greeting">HELLO DAVID</p>
    <p class="watchd-since">WATCHING SINCE 1989</p>

    <div class="watchd-stats">
      <div>19,388 <span>WATCHES</span></div>
      <div>17,427 <span>EPISODES</span></div>
      <div>1,961 <span>MOVIES</span></div>
      <div>14,XXX <span>HOURS</span></div>
    </div>
  </div>

  <div class="watchd-right">
    <a href="#">ALL TIME</a>
    <a href="#">YTD</a>
  </div>
</section>

<style>
.watchd-hero{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    padding:40px 0 60px;
    border-bottom:1px solid #222;
}

.watchd-greeting{
    font-size:42px;
    font-weight:800;
    color:#fff;
    margin:0;
}

.watchd-since{
    margin-top:8px;
    color:#999;
    letter-spacing:2px;
    font-size:14px;
}

.watchd-stats{
    margin-top:40px;
    display:grid;
    gap:12px;
}

.watchd-stats div{
    color:white;
    font-size:30px;
    font-weight:700;
}

.watchd-stats span{
    color:#888;
    font-size:15px;
    margin-left:10px;
}

.watchd-right{
    display:flex;
    flex-direction:column;
    gap:16px;
    align-items:flex-end;
}

.watchd-right a{
    color:white;
    text-decoration:none;
    font-weight:700;
}

.watchd-right a:hover{
    color:#e50914;
}
</style>