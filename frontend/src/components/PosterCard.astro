---
import type { MediaItem, WatchlistMovie } from "../lib/api";
import { tmdbImageUrl } from "../lib/api";

import wRed from "../assets/watchd-w-red.png";
import wWhite from "../assets/watchd-w-white.png";

// Poster card in the Up Next style, for movies and shows: Explore Movies and
// Shows, the Watchlist page and the dashboard Watchlist row.
interface Props {
    item: MediaItem | WatchlistMovie;
}

const { item } = Astro.props;

// Fields the list endpoints add for the action strip (not on every type)
const extra = item as Partial<MediaItem> & Partial<WatchlistMovie> & {
    tmdb_id: number;
    title: string;
    episodes_watched?: number;
    episodes_total?: number;
};

const isSeries = extra.type === "series";
const poster = tmdbImageUrl(extra.poster_path ?? null, "w500");
const href = isSeries ? `/show/${extra.tmdb_id}` : `/media/movie/${extra.tmdb_id}`;
const year = extra.year ?? extra.release_date?.slice(0, 4) ?? null;

// A show counts as watched once every aired episode is; the collection icon
// lights up when any of it is in the library.
const watchPct = extra.watch_pct ?? 0;
const watched = isSeries ? watchPct >= 100 : (extra.watched ?? false);
const inLists = extra.in_lists ?? [];
const inLibrary = extra.in_library ?? false;
const collectionPct = extra.collection_pct ?? (inLibrary ? 100 : 0);
const collected = isSeries ? collectionPct > 0 : inLibrary;

// Progress bar for shows the user has started, as on the Up Next cards.
const epsWatched = extra.episodes_watched ?? null;
const epsTotal = extra.episodes_total ?? null;
const progress =
    isSeries && watchPct > 0 ? Math.max(0, Math.min(100, Number(watchPct))) : null;
const progressTip =
    progress === null
        ? ""
        : epsWatched !== null && epsTotal !== null
            ? `${epsWatched} of ${epsTotal} episodes watched · ${progress}%`
            : `${progress}% watched`;

const imdb =
    extra.imdb_rating != null
        ? Number(extra.imdb_rating).toFixed(1)
        : null;

const userRating =
    extra.user_rating != null
        ? extra.user_rating % 1 === 0
            ? String(extra.user_rating)
            : extra.user_rating.toFixed(1)
        : null;
---

<div
    class="wd-poster-card"
    data-card
    data-id={extra.id ?? undefined}
    data-tmdb-id={extra.tmdb_id}
    data-media-type={isSeries ? "series" : "movie"}
>

    <div class="wd-panel">

        <a href={href} class="wd-poster-link">
            {poster ? (
                <img src={poster} alt={extra.title} class="wd-poster" loading="lazy" />
            ) : (
                <div class="wd-poster-empty">
                    <span>{extra.title}</span>
                </div>
            )}
            {userRating && (
                <span class="wd-my-rating" title={`Your rating: ${userRating}`}>★ {userRating}</span>
            )}
        </a>

        <!-- Extras from the page, e.g. the list page's remove button -->
        <slot />

        <div class="wd-strip">

            <div class="wd-actions">

                <button
                    type="button"
                    class="wd-btn"
                    data-action="watched"
                    data-watched={String(watched)}
                    data-watch-pct={isSeries ? String(watchPct) : undefined}
                    data-state={watched ? "active" : "inactive"}
                    title={isSeries ? `${watchPct}% watched` : watched ? "Mark as unwatched" : "Mark as watched"}
                    aria-label={watched ? "Mark as unwatched" : "Mark as watched"}
                >
                    <img
                        src={watched ? wRed.src : wWhite.src}
                        data-watchd-red={wRed.src}
                        data-watchd-white={wWhite.src}
                        alt=""
                        width="25"
                        height="22"
                        class="wd-w"
                    />
                </button>

                <button
                    type="button"
                    class="wd-btn"
                    data-action="list"
                    data-in-lists={JSON.stringify(inLists)}
                    data-state={inLists.length > 0 ? "active" : "inactive"}
                    title="Add to list"
                    aria-label="Add to list"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="8" y1="6" x2="21" y2="6"/>
                        <line x1="8" y1="12" x2="21" y2="12"/>
                        <line x1="8" y1="18" x2="21" y2="18"/>
                        <line x1="3" y1="6" x2="3.01" y2="6"/>
                        <line x1="3" y1="12" x2="3.01" y2="12"/>
                        <line x1="3" y1="18" x2="3.01" y2="18"/>
                    </svg>
                </button>

                <button
                    type="button"
                    class="wd-btn"
                    data-action="collected"
                    data-in-library={String(inLibrary)}
                    data-collection-pct={String(collectionPct)}
                    data-state={collected ? "active" : "inactive"}
                    title={isSeries ? `${collectionPct}% in library` : inLibrary ? "Remove from collection" : "Add to collection"}
                    aria-label={inLibrary ? "Remove from collection" : "Add to collection"}
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"/>
                        <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
                        <path d="M15 22v-4a3 3 0 0 0-6 0v4"/>
                        <path d="M2 7h20"/>
                    </svg>
                </button>

            </div>

            <div class="wd-rating" title={imdb ? `IMDb ${imdb}` : "No IMDb rating"}>
                <span class="wd-imdb">IMDb</span>
                <span class:list={["wd-score", { "wd-score--none": !imdb }]}>{imdb ?? "—"}</span>
            </div>

        </div>

        {progress !== null && (
            <div class="wd-progress" tabindex="0" role="img" aria-label={progressTip}>
                <div class="wd-progress-fill" style={`width:${progress}%`}></div>
            </div>
        )}

    </div>

    <a href={href} class="wd-meta">
        <div class="wd-title">{extra.title}</div>
        {progress !== null && <div class="wd-tip">{progressTip}</div>}
        {year && <div class="wd-year">{year}</div>}
    </a>

</div>

<style>

.wd-poster-card{
    width:100%;
    container-type:inline-size;
    display:flex;
    flex-direction:column;
    gap:12px;
}

.wd-panel{
    position:relative;
    background:#18181b;
    border:1px solid #27272a;
    border-radius:16px 16px 0 0;
    overflow:hidden;
}

.wd-poster-link{
    position:relative;
    display:block;
}

.wd-my-rating{
    position:absolute;
    top:8px;
    right:8px;
    padding:3px 8px;
    border-radius:8px;
    background:rgba(0,0,0,.8);
    border:1px solid rgba(239,68,68,.5);
    color:#ef4444;
    font-size:13px;
    font-weight:800;
    line-height:1.2;
    backdrop-filter:blur(6px);
}

.wd-poster{
    display:block;
    width:100%;
    aspect-ratio:2/3;
    object-fit:cover;
}

.wd-poster-empty{
    aspect-ratio:2/3;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:0 20px;
    text-align:center;
    background:#18181b;
    color:#52525b;
    font-size:11px;
    font-weight:800;
    letter-spacing:.2em;
    text-transform:uppercase;
}

.wd-strip{
    display:flex;
    align-items:center;
    justify-content:space-between;
    height:48px;
    padding:0 10px 0 4px;
    box-sizing:border-box;
    border-top:1px solid #27272a;
}

.wd-actions{
    display:flex;
    align-items:center;
}

/* Narrower than the Up Next buttons so the strip fits the 210px card.
   The shared click handlers in Base.astro add background/colour classes to
   these buttons, so they are neutralised here and driven from data-state. */
.wd-btn{
    width:36px;
    height:38px;
    padding:0;
    border:0;
    border-radius:10px;
    display:flex;
    align-items:center;
    justify-content:center;
    cursor:pointer;
    background:transparent !important;
    color:#71717a !important;
    transition:filter .15s ease;
}

.wd-btn:hover{
    filter:brightness(1.3);
}

.wd-btn:focus-visible{
    outline:2px solid #ef4444;
    outline-offset:1px;
}

.wd-btn[data-action="list"][data-state="active"]{
    color:#38bdf8 !important;
}

.wd-btn[data-action="collected"][data-state="active"]{
    color:#c084fc !important;
}

.wd-w{
    display:block;
    width:25px;
    height:22px;
    object-fit:contain;
}

.wd-rating{
    display:flex;
    align-items:center;
    gap:5px;
}

.wd-imdb{
    background:#f5c518;
    color:#000;
    font-size:10px;
    font-weight:900;
    line-height:1.3;
    padding:1px 4px;
    border-radius:3px;
}

.wd-score{
    font-size:15px;
    font-weight:800;
    color:#f5c518;
}

.wd-score--none{
    color:#a1a1aa;
}

/* Narrow grid cells (small windows): drop the IMDb badge and tighten the
   buttons so the score still fits beside them. */
@container (max-width:200px){
    .wd-strip{ padding:0 6px 0 2px; }
    .wd-btn{ width:28px; }
    .wd-imdb{ display:none; }
}

.wd-progress{
    position:relative;
    height:3px;
    background:#27272a;
    transform-origin:bottom;
    transition:transform .15s ease;
    outline:none;
}

/* extra invisible hit area so the thin line is easy to hover */
.wd-progress::before{
    content:"";
    position:absolute;
    left:0;
    right:0;
    top:-5px;
    bottom:0;
}

.wd-progress:hover,
.wd-progress:focus{
    transform:scaleY(2);
}

.wd-progress-fill{
    height:100%;
    background:#ef4444;
}

.wd-tip{
    position:absolute;
    left:2px;
    top:-6px;
    z-index:5;
    padding:5px 10px;
    border-radius:8px;
    background:#27272a;
    border:1px solid #3f3f46;
    color:#ffffff;
    font-size:12px;
    font-weight:700;
    line-height:1.2;
    white-space:nowrap;
    pointer-events:none;
    opacity:0;
    transform:translateY(-2px);
    transition:opacity .15s ease, transform .15s ease;
}

.wd-poster-card:has(.wd-progress:hover) .wd-tip,
.wd-poster-card:has(.wd-progress:focus) .wd-tip{
    opacity:1;
    transform:none;
}

.wd-meta{
    position:relative;
    display:block;
    padding:0 2px;
    text-decoration:none;
}

.wd-title{
    color:#ffffff;
    font-size:16px;
    font-weight:600;
    line-height:1.25;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
}

.wd-year{
    margin-top:3px;
    color:#a1a1aa;
    font-size:14px;
    line-height:1.3;
}

</style>
