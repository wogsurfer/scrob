  <script>
    // ── Local watch times ──────────────────────────────────────────────────────
    // Pages render watch times server-side, where the clock is UTC; re-format
    // them in the viewer's own time zone (see lib/time.ts).
    import { WATCH_DATE_FORMAT, WATCH_TIME_FORMAT } from '../lib/time';

    document.querySelectorAll<HTMLTimeElement>('time[data-local]').forEach((el) => {
      const when = new Date(el.dateTime);
      if (Number.isNaN(when.getTime())) return;
      el.textContent = el.dataset.local === 'time'
        ? when.toLocaleTimeString('en-US', WATCH_TIME_FORMAT)
        : when.toLocaleDateString('en-US', WATCH_DATE_FORMAT);
    });
  </script>

  <script>
    // ── Theme toggle ───────────────────────────────────────────────────────────
    const themeToggle = document.getElementById('theme-toggle');

    const themeColorMeta = document.getElementById('theme-color-meta') as HTMLMetaElement | null;
    const syncThemeColor = () => {
      const isLight = document.documentElement.classList.contains('light');
      if (themeColorMeta) themeColorMeta.content = isLight ? '#f9fafb' : '#09090b';
    };
    syncThemeColor();

    themeToggle?.addEventListener('click', () => {
      document.documentElement.classList.toggle('light');
      const isLight = document.documentElement.classList.contains('light');
      localStorage.setItem('theme', isLight ? 'light' : 'dark');
      syncThemeColor();
    });

    // ── User dropdown (click-toggled) ──────────────────────────────────────────
    const userMenuBtn = document.getElementById('user-menu-btn');
    const userMenu = document.getElementById('user-menu');
    const userChevron = document.getElementById('user-chevron');

    userMenuBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = !userMenu?.classList.contains('hidden');
      userMenu?.classList.toggle('hidden', open);
      userChevron?.style.setProperty('transform', open ? '' : 'rotate(180deg)');
    });

    document.addEventListener('click', () => {
      userMenu?.classList.add('hidden');
      userChevron?.style.removeProperty('transform');
    });

    // ── Mobile search expand ───────────────────────────────────────────────────
    const navDefault = document.getElementById('nav-default');
    const navSearch = document.getElementById('nav-search');
    const mobileSearchInput = document.getElementById('mobile-search-input') as HTMLInputElement | null;

    document.getElementById('mobile-search-open')?.addEventListener('click', () => {
      navDefault?.classList.add('hidden');
      navSearch?.classList.remove('hidden');
      navSearch?.classList.add('flex');
      mobileSearchInput?.focus();
    });

    const closeSearch = () => {
      navSearch?.classList.add('hidden');
      navSearch?.classList.remove('flex');
      navDefault?.classList.remove('hidden');
    };

    document.getElementById('mobile-search-close')?.addEventListener('click', closeSearch);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !navSearch?.classList.contains('hidden')) {
        closeSearch();
        return;
      }
      if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes((e.target as HTMLElement).tagName)) {
        e.preventDefault();
        const desktopInput = document.getElementById('desktop-search-input') as HTMLInputElement | null;
        if (desktopInput && getComputedStyle(desktopInput).display !== 'none') {
          desktopInput.focus();
        } else {
          navDefault?.classList.add('hidden');
          navSearch?.classList.remove('hidden');
          navSearch?.classList.add('flex');
          mobileSearchInput?.focus();
        }
      }
    });
  </script>

  <script is:inline>
    // Load the admin badge after first paint so it doesn't hold up every page render.
    if (document.getElementById('pending-request-count')) {
      fetch('/api/proxy/admin/requests/pending-count')
        .then((response) => response.ok ? response.json() : null)
        .then((data) => {
          if (!data) return;
          const count = Number(data.pending) || 0;
          const badge = document.getElementById('pending-request-count');
          const dot = document.getElementById('pending-request-dot');
          if (badge) {
            badge.textContent = String(count);
            badge.hidden = count === 0;
            badge.classList.toggle('flex', count > 0);
          }
          if (dot) dot.hidden = count === 0;
        })
        .catch(() => {});
    }
  </script>

  <script>
    // ── Card action bar ────────────────────────────────────────────────────────
    const API = '/api/proxy';

    function esc(s: unknown): string {
      if (s == null) return '';
      return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    async function apiFetch(path: string, method = 'GET', body?: unknown) {
      const res = await fetch(`${API}${path}`, {
        method,
        headers: { ...(body ? { 'Content-Type': 'application/json' } : {}) },
        body: body ? JSON.stringify(body) : undefined,
      });
      if (!res.ok) throw new Error(await res.text());
      return res.json();
    }

    // ── Watched-at picker ──────────────────────────────────────────────────────
    function showWatchedAtPicker(anchorEl: HTMLElement): Promise<string | null> {
      return new Promise(resolve => {
        const picker = document.getElementById('watched-at-picker')!;
        const nowBtn = document.getElementById('watched-at-now-btn')!;
        const customBtn = document.getElementById('watched-at-custom-btn')!;
        const fields = document.getElementById('watched-at-custom-fields')!;
        const dateInput = document.getElementById('watched-at-date') as HTMLInputElement;
        const hourSelect = document.getElementById('watched-at-hour') as HTMLSelectElement;
        const minuteSelect = document.getElementById('watched-at-minute') as HTMLSelectElement;
        const confirmBtn = document.getElementById('watched-at-confirm')!;
        const cancelBtn = document.getElementById('watched-at-cancel')!;

        const activeClass = 'flex-1 px-3 py-2 rounded-xl text-sm font-bold transition-all cursor-pointer bg-blue-600 text-white';
        const inactiveClass = 'flex-1 px-3 py-2 rounded-xl text-sm font-bold transition-all cursor-pointer bg-zinc-800 text-zinc-400 border border-zinc-700 hover:text-zinc-200';

        const pad = (n: number) => String(n).padStart(2, '0');

        // Populate 24-hour time controls.
        hourSelect.innerHTML = Array.from({ length: 24 }, (_, h) =>
          `<option value="${pad(h)}">${pad(h)}</option>`
        ).join('');

        minuteSelect.innerHTML = Array.from({ length: 60 }, (_, m) =>
          `<option value="${pad(m)}">${pad(m)}</option>`
        ).join('');

        const now = new Date();

        const toLocal = (d: Date) =>
          `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;

        const today = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;

        dateInput.value = today;
        dateInput.max = today;
        hourSelect.value = pad(now.getHours());
        minuteSelect.value = pad(now.getMinutes());

        let useNow = true;

        fields.classList.add('hidden');
        nowBtn.className = activeClass;
        customBtn.className = inactiveClass;

        picker.classList.remove('hidden');

        const rect = anchorEl.getBoundingClientRect();
        const pickerH = picker.offsetHeight;
        const spaceBelow = window.innerHeight - rect.bottom;
        const top = spaceBelow >= pickerH + 8
          ? rect.bottom + window.scrollY + 4
          : rect.top + window.scrollY - pickerH - 4;

        picker.style.top = `${top}px`;
        picker.style.left = `${Math.min(rect.left + window.scrollX, window.innerWidth - 288 - 8)}px`;

        const close = (result: string | null) => {
          picker.classList.add('hidden');
          document.removeEventListener('pointerdown', outsideHandler);
          nowBtn.replaceWith(nowBtn.cloneNode(true));
          customBtn.replaceWith(customBtn.cloneNode(true));
          confirmBtn.replaceWith(confirmBtn.cloneNode(true));
          cancelBtn.replaceWith(cancelBtn.cloneNode(true));
          resolve(result);
        };

        document.getElementById('watched-at-now-btn')!.addEventListener('click', () => {
          useNow = true;
          fields.classList.add('hidden');
          (document.getElementById('watched-at-now-btn') as HTMLElement).className = activeClass;
          (document.getElementById('watched-at-custom-btn') as HTMLElement).className = inactiveClass;
        });

        document.getElementById('watched-at-custom-btn')!.addEventListener('click', () => {
          useNow = false;
          fields.classList.remove('hidden');
          (document.getElementById('watched-at-now-btn') as HTMLElement).className = inactiveClass;
          (document.getElementById('watched-at-custom-btn') as HTMLElement).className = activeClass;
        });

        document.getElementById('watched-at-confirm')!.addEventListener('click', () => {
          if (useNow) {
            close(toLocal(new Date()));
            return;
          }

          if (!dateInput.value) {
            close(toLocal(new Date()));
            return;
          }

          const val = `${dateInput.value}T${hourSelect.value}:${minuteSelect.value}`;

          // Don't allow a custom time in the future.
          if (new Date(val).getTime() > Date.now()) {
            close(toLocal(new Date()));
            return;
          }

          close(val);
        });

        document.getElementById('watched-at-cancel')!.addEventListener('click', () => close(null));

        const outsideHandler = (e: PointerEvent) => {
          if (
            !picker.contains(e.target as Node) &&
            e.target !== anchorEl &&
            !anchorEl.contains(e.target as Node)
          ) {
            close(null);
          }
        };

        setTimeout(() => document.addEventListener('pointerdown', outsideHandler), 0);
      });
    }

    // ── Confirm dialog ─────────────────────────────────────────────────────────
    (window as Window & { showConfirm: typeof showConfirm }).showConfirm = showConfirm;
    function showConfirm(title: string, body: string): Promise<boolean> {
      return new Promise(resolve => {
        const dialog = document.getElementById('confirm-dialog')!;
        (document.getElementById('confirm-title') as HTMLElement).textContent = title;
        (document.getElementById('confirm-body') as HTMLElement).textContent = body;
        dialog.classList.remove('hidden');
        const ok = document.getElementById('confirm-ok')!;
        const cancel = document.getElementById('confirm-cancel')!;
        const close = (v: boolean) => { dialog.classList.add('hidden'); ok.replaceWith(ok.cloneNode(true)); cancel.replaceWith(cancel.cloneNode(true)); resolve(v); };
        document.getElementById('confirm-ok')!.addEventListener('click', () => close(true), { once: true });
        document.getElementById('confirm-cancel')!.addEventListener('click', () => close(false), { once: true });
      });
    }

    // ── Rating popover ─────────────────────────────────────────────────────────
    let _activeRatingBtn: HTMLElement | null = null;

    const fmtRating = (n: number) => (Number.isInteger(n) ? String(n) : n.toFixed(1));

    function closeRatingPopover() {
      document.getElementById('rating-popover')!.classList.add('hidden');
      _activeRatingBtn = null;
    }

    // Updates whichever rate button was used: the header pill or the action-bar block
    function applyRatingToButton(btn: HTMLElement, value: number | null) {
      const rated = value !== null;
      btn.dataset.userRating = rated ? String(value) : '';
      btn.dataset.state = rated ? 'active' : 'inactive';
      btn.title = rated ? `Your rating: ${fmtRating(value!)}/10` : 'Rate this';
      btn.querySelector('svg')?.setAttribute('fill', rated ? 'currentColor' : 'none');

      if (btn.dataset.ratingStyle === 'pill') {
        btn.classList.toggle('text-red-500', rated);
        btn.classList.toggle('text-zinc-500', !rated);
        btn.classList.toggle('hover:text-red-400', !rated);
        const num = btn.querySelector('[data-rating-value]');
        if (num) num.textContent = rated ? fmtRating(value!) : '';
        return;
      }

      // action-bar block (amber)
      btn.classList.toggle('bg-zinc-800', !rated);
      btn.classList.toggle('text-zinc-500', !rated);
      btn.classList.toggle('hover:text-amber-400', !rated);
      btn.classList.toggle('bg-amber-500/50', rated);
      btn.classList.toggle('text-amber-300', rated);
      const label = btn.querySelector('span');
      if (label) label.textContent = rated ? fmtRating(value!) : 'Rate';
    }

    // localId: a movie that isn't on TMDB (pages/movie/local), rated by media id.
    function openRatingPopover(btn: HTMLElement, tmdbId: string, mediaType: string, currentRating: number | null, seasonNumber: number | null = null, episodeOrder: string = 'tmdb', localId = '') {
      _activeRatingBtn = btn;
      const popover = document.getElementById('rating-popover')!;
      const starsEl = document.getElementById('rating-stars')!;
      const labelEl = document.getElementById('rating-label')!;
      const zeroBtn = document.getElementById('rating-zero')!;
      const removeBtn = document.getElementById('rating-remove')!;

      const color = btn.dataset.ratingStyle === 'pill' ? 'text-red-500' : 'text-amber-400';
      const STAR = '<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>';

      let preview = currentRating ?? 0;
      let touched = currentRating != null;

      removeBtn.classList.toggle('hidden', currentRating == null);

      // Ten stars: grey base, coloured overlay clipped to 0 / 50 / 100%
      starsEl.innerHTML = '';
      for (let i = 1; i <= 10; i++) {
        const star = document.createElement('div');
        star.dataset.star = String(i);
        star.className = 'relative w-[22px] h-[22px] cursor-pointer';
        star.innerHTML = `
          <svg viewBox="0 0 24 24" fill="currentColor" class="absolute inset-0 w-[22px] h-[22px] text-zinc-700">${STAR}</svg>
          <div data-fill class="absolute inset-y-0 left-0 overflow-hidden ${color}" style="width:0%">
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-[22px] h-[22px] max-w-none">${STAR}</svg>
          </div>`;
        starsEl.appendChild(star);
      }

      const draw = (value: number, showLabel = true) => {
        preview = value;
        starsEl.querySelectorAll<HTMLElement>('[data-star]').forEach((star) => {
          const i = Number(star.dataset.star);
          const fill = value >= i ? 100 : value >= i - 0.5 ? 50 : 0;
          (star.querySelector('[data-fill]') as HTMLElement).style.width = `${fill}%`;
        });
        labelEl.textContent = showLabel ? fmtRating(value) : '';
        starsEl.setAttribute('aria-valuenow', String(value));
      };

      // Left half of a star = half point, right half = whole point
      const valueAt = (clientX: number, target: EventTarget | null): number | null => {
        const star = (target as HTMLElement | null)?.closest<HTMLElement>('[data-star]');
        if (!star) return null;
        const rect = star.getBoundingClientRect();
        const i = Number(star.dataset.star);
        return clientX - rect.left < rect.width / 2 ? i - 0.5 : i;
      };

      const save = async (value: number) => {
        try {
          if (localId) {
            await apiFetch(`/media/local/${localId}/rating`, 'POST', { rating: value });
          } else {
            const body: Record<string, unknown> = { tmdb_id: Number(tmdbId), media_type: mediaType, rating: value };
            if (seasonNumber !== null) body.season_number = seasonNumber;
            if (seasonNumber !== null && episodeOrder === 'tvdb') body.episode_order = 'tvdb';
            await apiFetch('/ratings', 'POST', body);
          }
          applyRatingToButton(btn, value);
          closeRatingPopover();
        } catch { /* ignore */ }
      };

      draw(currentRating ?? 0, currentRating != null);

      // Property handlers (not addEventListener) so reopening never stacks duplicates
      starsEl.onpointermove = (e) => {
        const v = valueAt(e.clientX, e.target);
        if (v !== null) draw(v);
      };
      starsEl.onpointerleave = () => draw(currentRating ?? 0, currentRating != null);
      starsEl.onclick = (e) => {
        const v = valueAt(e.clientX, e.target);
        if (v !== null) save(v);
      };
      starsEl.onkeydown = (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowUp') {
          e.preventDefault(); touched = true; draw(Math.min(10, preview + 0.5));
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') {
          e.preventDefault(); touched = true; draw(Math.max(0, preview - 0.5));
        } else if (e.key === 'Enter') {
          e.preventDefault(); if (touched) save(preview);
        } else if (e.key === 'Escape') {
          closeRatingPopover();
        }
      };
      zeroBtn.onclick = () => save(0);

      removeBtn.onclick = async () => {
        try {
          const seasonQuery = seasonNumber !== null ? `&season_number=${seasonNumber}` : '';
          const orderQuery = seasonNumber !== null && episodeOrder === 'tvdb' ? '&episode_order=tvdb' : '';
          await apiFetch(
            localId
              ? `/media/local/${localId}/rating`
              : `/ratings?tmdb_id=${tmdbId}&media_type=${mediaType}${seasonQuery}${orderQuery}`,
            'DELETE'
          );
          applyRatingToButton(btn, null);
          closeRatingPopover();
        } catch { /* ignore */ }
      };

      const rect = btn.getBoundingClientRect();
      popover.classList.remove('hidden');
      const popW = popover.offsetWidth;
      const left = Math.min(rect.left + window.scrollX, window.innerWidth - popW - 8);
      popover.style.left = `${Math.max(8, left)}px`;
      popover.style.top = `${rect.bottom + window.scrollY + 6}px`;
      starsEl.focus({ preventScroll: true });
    }

    document.getElementById('rating-popover-close')!.addEventListener('click', () => closeRatingPopover());
    document.addEventListener('click', (e) => {
      const popover = document.getElementById('rating-popover')!;
      const t = e.target as Node;
      if (!popover.classList.contains('hidden') && !popover.contains(t) && !_activeRatingBtn?.contains(t)) {
        closeRatingPopover();
      }
    });
    // ── List popover ───────────────────────────────────────────────────────────
    let _activeListBtn: HTMLElement | null = null;
    let _listTmdbId = '';
    let _listMediaType = '';

    function closeListPopover() {
      document.getElementById('list-popover')!.classList.add('hidden');
      _activeListBtn = null;
    }

    async function openListPopover(btn: HTMLElement, tmdbId: string, mediaType: string) {
      _activeListBtn = btn;
      _listTmdbId = tmdbId;
      _listMediaType = mediaType;
      const popover = document.getElementById('list-popover')!;
      const itemsEl = document.getElementById('list-popover-items')!;
      itemsEl.innerHTML = '<div class="px-3 py-2 text-xs text-zinc-500">Loading…</div>';
      popover.classList.remove('hidden');

      // Position near button (popover is absolute, so use page coords)
      const rect = btn.getBoundingClientRect();
      const top = rect.bottom + window.scrollY + 4;
      const left = Math.min(rect.left + window.scrollX, window.innerWidth - 272);
      popover.style.top = `${top}px`;
      popover.style.left = `${left}px`;

      // Fetch lists
      let lists: { id: number; name: string }[] = [];
      try {
        const data = await apiFetch('/lists');
        lists = data.lists ?? [];
      } catch { lists = []; }

      const currentLists: number[] = JSON.parse(btn.dataset.inLists ?? '[]');

      if (!lists.length) {
        itemsEl.innerHTML = '<div class="px-3 py-2 text-xs text-zinc-500">No lists yet.</div>';
        return;
      }

      itemsEl.innerHTML = lists.map(l => `
        <label class="flex items-center gap-2 px-3 py-2 hover:bg-zinc-800 cursor-pointer transition">
          <input type="checkbox" data-list-id="${esc(String(l.id))}" ${currentLists.includes(l.id) ? 'checked' : ''}
            class="w-3.5 h-3.5 rounded accent-blue-500" />
          <span class="text-sm text-zinc-200 truncate">${esc(l.name)}</span>
        </label>`).join('');

      itemsEl.querySelectorAll<HTMLInputElement>('input[data-list-id]').forEach(cb => {
        cb.addEventListener('change', async () => {
          const listId = cb.dataset.listId!;
          try {
            if (cb.checked) {
              await apiFetch(`/lists/${listId}/items`, 'POST', { tmdb_id: Number(_listTmdbId), media_type: _listMediaType });
            } else {
              // Find the list_item id — need to fetch list detail
              const detail = await apiFetch(`/lists/${listId}`);
              // By kind too: a film and a show can share a TMDB number.
              const item = detail.items?.find((i: { media: { tmdb_id: number; type: string } }) =>
                i.media?.tmdb_id === Number(_listTmdbId) && i.media?.type === _listMediaType);
              if (item) {
                await apiFetch(`/lists/${listId}/items/${item.id}`, 'DELETE');
                // If we're on the list detail page for this list, remove the card immediately
                const pageListId = window.location.pathname.match(/^\/list\/(\d+)/)?.[1];
                if (pageListId === String(listId)) {
                  const wrapper = document.querySelector(`[data-item-id="${item.id}"]`);
                  wrapper?.remove();
                  closeListPopover();
                  const grid = document.getElementById('items-grid');
                  if (grid && grid.children.length === 0) {
                    document.getElementById('empty-state')?.classList.remove('hidden');
                  }
                }
              }
            }
            // Update button state
            if (_activeListBtn) {
              const updated = cb.checked
                ? [...JSON.parse(_activeListBtn.dataset.inLists ?? '[]'), Number(listId)]
                : JSON.parse(_activeListBtn.dataset.inLists ?? '[]').filter((id: number) => id !== Number(listId));
              _activeListBtn.dataset.inLists = JSON.stringify(updated);
              const nowInLists = updated.length > 0;
              _activeListBtn.dataset.state = nowInLists ? 'active' : 'inactive';

              const isCard = _activeListBtn.parentElement?.classList.contains('grid');
              if (nowInLists) {
                _activeListBtn.classList.remove('bg-zinc-800', 'bg-zinc-900', 'text-zinc-500', 'text-zinc-400', 'hover:bg-sky-500/10', 'hover:text-sky-400');
                if (isCard) {
                  _activeListBtn.classList.add('bg-sky-500/20', 'text-sky-400');
                } else {
                  _activeListBtn.classList.add('bg-sky-500/50', 'text-sky-300', 'hover:bg-sky-400/50');
                }
              } else {
                _activeListBtn.classList.remove('bg-sky-500/20', 'bg-sky-500/50', 'text-sky-400', 'text-sky-300', 'hover:bg-sky-500/40', 'hover:bg-sky-400/50');
                if (isCard) {
                  _activeListBtn.classList.add('bg-zinc-900', 'text-zinc-400', 'hover:bg-sky-500/10', 'hover:text-sky-400');
                } else {
                  _activeListBtn.classList.add('bg-zinc-800', 'text-zinc-500', 'hover:bg-sky-500/10', 'hover:text-sky-400');
                }
              }
            }
          } catch { cb.checked = !cb.checked; }
        });
      });
    }

    document.getElementById('list-popover-close')!.addEventListener('click', () => closeListPopover());

    document.getElementById('list-popover-create')!.addEventListener('click', () => {
      closeListPopover();
      openCreateListModal();
    });

    document.addEventListener('click', (e) => {
      const popover = document.getElementById('list-popover')!;
      if (!popover.classList.contains('hidden') && !popover.contains(e.target as Node) && e.target !== _activeListBtn) {
        closeListPopover();
      }
    });

    // ── Create list modal ──────────────────────────────────────────────────────
    function openCreateListModal() {
      const modal = document.getElementById('create-list-modal')!;
      const input = document.getElementById('create-list-name') as HTMLInputElement;
      input.value = '';
      modal.classList.remove('hidden');
      input.focus();
    }

    document.getElementById('create-list-cancel')!.addEventListener('click', () => {
      document.getElementById('create-list-modal')!.classList.add('hidden');
    });

    document.getElementById('create-list-confirm')!.addEventListener('click', async () => {
      const input = document.getElementById('create-list-name') as HTMLInputElement;
      const name = input.value.trim();
      if (!name) { input.focus(); return; }
      try {
        await apiFetch('/lists', 'POST', { name });
        document.getElementById('create-list-modal')!.classList.add('hidden');
        // Re-open popover if we had an active card
        if (_activeListBtn) {
          const card = _activeListBtn.closest('[data-card]') as HTMLElement;
          if (card) openListPopover(_activeListBtn, card.dataset.tmdbId!, card.dataset.mediaType!);
        }
      } catch { /* ignore */ }
    });

    document.getElementById('create-list-name')!.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter') (document.getElementById('create-list-confirm') as HTMLButtonElement).click();
    });

    // ── Watched button UI updater ──────────────────────────────────────────────
    function updateWatchedButtonUI(targetBtn: HTMLElement, watched: boolean) {
      targetBtn.dataset.watched = String(watched);
      targetBtn.dataset.state = watched ? 'active' : 'inactive';
      const card = targetBtn.closest<HTMLElement>('[data-card]');
      const isSeries = card?.dataset.mediaType === 'series';
      const isCard = targetBtn.parentElement?.classList.contains('grid');
      if (isSeries) {
        const newPct = watched ? 100 : 0;
        targetBtn.dataset.watchPct = String(newPct);
        targetBtn.title = `${newPct}% watched`;
        targetBtn.style.background = '';
        const labelEl = targetBtn.querySelector('span');
        if (labelEl) labelEl.textContent = `${newPct}%`;
        const smLabelEl = targetBtn.querySelectorAll('span')[1];
        if (smLabelEl) smLabelEl.textContent = `${newPct}%`;
      } else {
        targetBtn.title = watched ? 'Mark as unwatched' : 'Mark as watched';
      }
      if (watched) {
        targetBtn.classList.remove('bg-zinc-800', 'bg-zinc-900', 'text-zinc-500', 'text-zinc-400', 'hover:bg-green-500/10', 'hover:text-green-400', 'hover:text-green-500');
        if (isCard) {
          targetBtn.classList.add('bg-green-500/20', 'text-green-400');
        } else {
          targetBtn.classList.add('bg-red-500/50', 'text-red-300', 'hover:bg-red-400/50');
        }
      } else {
        targetBtn.classList.remove('bg-red-500/20', 'bg-red-500/50', 'text-red-400', 'text-red-300', 'hover:bg-red-500/40', 'hover:bg-red-400/50');
        if (isCard) {
          targetBtn.classList.add('bg-zinc-900', 'text-zinc-400', 'hover:bg-green-500/10', 'hover:text-green-500');
        } else {
          targetBtn.classList.add('bg-zinc-800', 'text-zinc-500', 'hover:bg-red-500/10', 'hover:text-red-400');
        }
      }
      const logo = targetBtn.querySelector("img");

      if (logo) {
        logo.src = watched
          ? logo.dataset.watchdRed || logo.src
          : logo.dataset.watchdWhite || logo.src;
      }

      }

    // ── Watch history modal ────────────────────────────────────────────────────
    let _watchHistoryTmdbId = '';
    let _watchHistoryMediaType = '';
    let _watchHistoryDateMode: 'now' | 'custom' | 'unknown' | 'watching' = 'now';
    let _watchHistoryIsWatched = false;
    let _watchHistoryShowTmdbId = '';
    let _watchHistorySeasonNumber = '';
    let _watchHistoryEpisodeNumber = '';
    // Set for a movie that isn't on TMDB (pages/movie/local): the modal then
    // reads and writes through /media/local/{id} instead of TMDB ids.
    let _watchHistoryLocalId = '';
    const localWatchPath = () => `/media/local/${_watchHistoryLocalId}`;

    const toLocal = (d: Date) => {
      const p = (n: number) => String(n).padStart(2, '0');
      return `${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`;
    };
    const toUTC = (d: Date) => d.toISOString().slice(0, 16);

    function closeWatchHistoryModal() {
      const modal = document.getElementById('watch-history-modal')!;
      if (modal.classList.contains('hidden')) return;
      modal.classList.add('hidden');
      window.dispatchEvent(new CustomEvent('watchd:watch-history-closed'));
    }

    async function openWatchHistoryModal(_btn: HTMLElement, tmdbId: string, mediaType: string, showTmdbId = '', seasonNumber = '', episodeNumber = '', localId = '') {
      _watchHistoryLocalId = localId;
      _watchHistoryTmdbId = tmdbId;
      _watchHistoryMediaType = mediaType;
      _watchHistoryShowTmdbId = showTmdbId;
      _watchHistorySeasonNumber = seasonNumber;
      _watchHistoryEpisodeNumber = episodeNumber;

      // Reset "add play" form to "Just now"
      _watchHistoryDateMode = 'now';
      const nowBtn = document.getElementById('watch-history-now-btn')!;
      const customBtn = document.getElementById('watch-history-custom-btn')!;
      const unknownBtn = document.getElementById('watch-history-unknown-btn')!;
      const watchingBtn = document.getElementById('watch-history-watching-btn')!;
      const dateInput = document.getElementById('watch-history-date-input') as HTMLInputElement;
      const activeClass = 'flex-1 px-3 py-2 rounded-xl text-sm font-bold transition-all cursor-pointer bg-blue-600 text-white';
      const inactiveClass = 'flex-1 px-3 py-2 rounded-xl text-sm font-bold transition-all cursor-pointer bg-zinc-800 text-zinc-400 border border-zinc-700 hover:text-zinc-200';
      nowBtn.className = activeClass;
      customBtn.className = inactiveClass;
      unknownBtn.className = inactiveClass;
      watchingBtn.className = inactiveClass;
      dateInput.classList.add('hidden');
      dateInput.value = toLocal(new Date());
      dateInput.max = toLocal(new Date());

      _watchHistoryIsWatched = false;
      document.getElementById('watch-history-log-btn')!.textContent = 'Mark as watched';
      document.getElementById('watch-history-modal')!.classList.remove('hidden');
      await loadWatchHistoryEvents();
    }

    async function loadWatchHistoryEvents() {
      const eventsEl = document.getElementById('watch-history-modal-events')!;
      eventsEl.innerHTML = '<div class="px-4 py-3 text-xs text-zinc-500">Loading…</div>';
      const unwatchBtn = document.getElementById('watch-history-unwatch-btn') as HTMLButtonElement;
      unwatchBtn.classList.add('hidden');
      try {
        const events: Array<{ id: number; watched_at: string | null; watch_source: string | null }> = _watchHistoryLocalId
          ? (await apiFetch(localWatchPath())).watch_history
          : await apiFetch(
            `/history/item-events?tmdb_id=${_watchHistoryTmdbId}&media_type=${_watchHistoryMediaType}`
          );
        if (events.length === 0) {
          eventsEl.innerHTML = '<div class="px-4 py-3 text-sm text-zinc-500 italic">No plays recorded yet</div>';
        } else {
          eventsEl.innerHTML = events.map(ev => {
            const fmt = ev.watched_at
              ? new Date(ev.watched_at + 'Z').toLocaleString(undefined, { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' })
              : 'Unknown date';
            const sources = ['', 'Cinema', 'Blu-ray', '4K', 'DVD', 'Cable', 'VHS', 'TV', 'Netflix', 'Amazon', 'Disney+', 'AppleTV', 'PLEX', 'YouTube', 'Digital file'];
            const sourceOptions = sources.map(source => {
              const label = source || 'No source';
              return `<option value="${esc(source)}"${source === (ev.watch_source || '') ? ' selected' : ''}>${esc(label)}</option>`;
            }).join('');
            return `<div class="flex items-center gap-2 px-4 py-2.5 hover:bg-zinc-800/50 group">
              <span class="min-w-0 flex-1 text-sm text-zinc-200">${esc(fmt)}</span>
              <select class="max-w-36 rounded-lg border border-zinc-700 bg-zinc-800 px-2 py-1.5 text-xs text-zinc-300 focus:outline-none focus:border-green-500" data-watch-source-event="${ev.id}" data-current-source="${esc(ev.watch_source || '')}" aria-label="Watch source for ${esc(fmt)}">
                ${sourceOptions}
              </select>
              <button class="text-zinc-600 group-hover:text-zinc-400 hover:!text-red-400 transition-colors cursor-pointer" data-delete-event="${ev.id}" aria-label="Remove">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>`;
          }).join('');
        }
        const isWatched = events.length > 0;
        _watchHistoryIsWatched = isWatched;
        unwatchBtn.classList.toggle('hidden', !isWatched);
        document.getElementById('watch-history-log-btn')!.textContent = _watchHistoryDateMode === 'watching'
          ? 'Start watching'
          : isWatched ? 'Log a rewatch' : 'Mark as watched';
        if (_watchHistoryLocalId) {
          window.dispatchEvent(new CustomEvent('watchd:local-watch-history', {
            detail: { mediaId: _watchHistoryLocalId, isWatched, events },
          }));
          return;
        }
        document.querySelectorAll<HTMLElement>(
          `[data-card][data-tmdb-id="${_watchHistoryTmdbId}"][data-media-type="${_watchHistoryMediaType}"] [data-action="watched"]`
        ).forEach(b => updateWatchedButtonUI(b, isWatched));
      } catch {
        eventsEl.innerHTML = '<div class="px-4 py-2 text-xs text-red-400">Failed to load</div>';
      }
    }

    document.getElementById('watch-history-modal-close')!.addEventListener('click', closeWatchHistoryModal);
    window.addEventListener('watchd:open-local-watch-history', (e) => {
      const { mediaId } = (e as CustomEvent<{ mediaId: string }>).detail;
      openWatchHistoryModal(document.body, '', 'movie', '', '', '', String(mediaId));
    });
    document.getElementById('watch-history-modal')!.addEventListener('click', (e) => {
      if (e.target === document.getElementById('watch-history-modal')) closeWatchHistoryModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeWatchHistoryModal();
    });

    document.getElementById('watch-history-modal-events')!.addEventListener('click', async (e) => {
      const delBtn = (e.target as Element).closest<HTMLElement>('[data-delete-event]');
      if (!delBtn) return;
      delBtn.style.opacity = '0.4';
      delBtn.style.pointerEvents = 'none';
      try {
        await apiFetch(`/history/event/${delBtn.dataset.deleteEvent}`, 'DELETE');
        await loadWatchHistoryEvents();
      } catch {
        delBtn.style.opacity = '';
        delBtn.style.pointerEvents = '';
      }
    });

    document.getElementById('watch-history-modal-events')!.addEventListener('change', async (e) => {
      const sourceSelect = (e.target as Element).closest<HTMLSelectElement>('[data-watch-source-event]');
      if (!sourceSelect) return;
      const previousSource = sourceSelect.dataset.currentSource || '';
      sourceSelect.disabled = true;
      try {
        await apiFetch(`/history/event/${sourceSelect.dataset.watchSourceEvent}`, 'PATCH', {
          watch_source: sourceSelect.value || null,
        });
        sourceSelect.dataset.currentSource = sourceSelect.value;
      } catch {
        sourceSelect.value = previousSource;
      } finally {
        sourceSelect.disabled = false;
      }
    });

    document.getElementById('watch-history-unwatch-btn')!.addEventListener('click', async () => {
      const confirmed = await showConfirm(
        'Mark as unwatched?',
        'This will remove every recorded play for this item and mark it as unwatched on enabled services.'
      );
      if (!confirmed) return;

      const unwatchBtn = document.getElementById('watch-history-unwatch-btn') as HTMLButtonElement;
      unwatchBtn.disabled = true;
      unwatchBtn.textContent = 'Removing…';
      try {
        await apiFetch(
          _watchHistoryLocalId
            ? `${localWatchPath()}/watch`
            : `/history/item?tmdb_id=${encodeURIComponent(_watchHistoryTmdbId)}&media_type=${encodeURIComponent(_watchHistoryMediaType)}`,
          'DELETE'
        );
        await loadWatchHistoryEvents();
      } catch { /* keep the modal open so the user can retry */ }
      unwatchBtn.disabled = false;
      unwatchBtn.textContent = 'Mark as unwatched';
    });

    (() => {
      const activeClass = 'flex-1 px-3 py-2 rounded-xl text-sm font-bold transition-all cursor-pointer bg-blue-600 text-white';
      const inactiveClass = 'flex-1 px-3 py-2 rounded-xl text-sm font-bold transition-all cursor-pointer bg-zinc-800 text-zinc-400 border border-zinc-700 hover:text-zinc-200';
      const setNormalActionLabel = () => {
        document.getElementById('watch-history-log-btn')!.textContent = _watchHistoryIsWatched ? 'Log a rewatch' : 'Mark as watched';
      };

      document.getElementById('watch-history-now-btn')!.addEventListener('click', () => {
        _watchHistoryDateMode = 'now';
        (document.getElementById('watch-history-now-btn') as HTMLElement).className = activeClass;
        (document.getElementById('watch-history-custom-btn') as HTMLElement).className = inactiveClass;
        (document.getElementById('watch-history-unknown-btn') as HTMLElement).className = inactiveClass;
        (document.getElementById('watch-history-watching-btn') as HTMLElement).className = inactiveClass;
        document.getElementById('watch-history-date-input')!.classList.add('hidden');
        setNormalActionLabel();
      });

      document.getElementById('watch-history-custom-btn')!.addEventListener('click', () => {
        _watchHistoryDateMode = 'custom';
        (document.getElementById('watch-history-now-btn') as HTMLElement).className = inactiveClass;
        (document.getElementById('watch-history-custom-btn') as HTMLElement).className = activeClass;
        (document.getElementById('watch-history-unknown-btn') as HTMLElement).className = inactiveClass;
        (document.getElementById('watch-history-watching-btn') as HTMLElement).className = inactiveClass;
        const input = document.getElementById('watch-history-date-input') as HTMLInputElement;
        input.max = toLocal(new Date());
        input.classList.remove('hidden');
        input.focus();
        setNormalActionLabel();
      });

      document.getElementById('watch-history-unknown-btn')!.addEventListener('click', () => {
        _watchHistoryDateMode = 'unknown';
        (document.getElementById('watch-history-now-btn') as HTMLElement).className = inactiveClass;
        (document.getElementById('watch-history-custom-btn') as HTMLElement).className = inactiveClass;
        (document.getElementById('watch-history-unknown-btn') as HTMLElement).className = activeClass;
        (document.getElementById('watch-history-watching-btn') as HTMLElement).className = inactiveClass;
        document.getElementById('watch-history-date-input')!.classList.add('hidden');
        setNormalActionLabel();
      });

      document.getElementById('watch-history-watching-btn')!.addEventListener('click', () => {
        _watchHistoryDateMode = 'watching';
        (document.getElementById('watch-history-now-btn') as HTMLElement).className = inactiveClass;
        (document.getElementById('watch-history-custom-btn') as HTMLElement).className = inactiveClass;
        (document.getElementById('watch-history-unknown-btn') as HTMLElement).className = inactiveClass;
        (document.getElementById('watch-history-watching-btn') as HTMLElement).className = activeClass;
        document.getElementById('watch-history-date-input')!.classList.add('hidden');
        document.getElementById('watch-history-log-btn')!.textContent = 'Start watching';
      });

      document.getElementById('watch-history-log-btn')!.addEventListener('click', async () => {
        const input = document.getElementById('watch-history-date-input') as HTMLInputElement;
        const logBtn = document.getElementById('watch-history-log-btn') as HTMLButtonElement;
        const idleLabel = _watchHistoryDateMode === 'watching'
          ? 'Start watching'
          : logBtn.textContent || 'Mark as watched';
        logBtn.disabled = true;
        logBtn.textContent = _watchHistoryDateMode === 'watching' ? 'Starting…' : 'Saving…';
        try {
          if (_watchHistoryDateMode === 'watching') {
            const sessionBody: Record<string, unknown> = _watchHistoryLocalId
              ? { media_id: Number(_watchHistoryLocalId), media_type: 'movie' }
              : { tmdb_id: Number(_watchHistoryTmdbId), media_type: _watchHistoryMediaType };
            const sessionSource = (document.getElementById('watch-history-source') as HTMLSelectElement).value;
            if (sessionSource) sessionBody.watch_source = sessionSource;
            if (_watchHistoryMediaType === 'episode' && _watchHistoryShowTmdbId) {
              sessionBody.show_tmdb_id = Number(_watchHistoryShowTmdbId);
              if (_watchHistorySeasonNumber) sessionBody.season_number = Number(_watchHistorySeasonNumber);
              if (_watchHistoryEpisodeNumber) sessionBody.episode_number = Number(_watchHistoryEpisodeNumber);
            }
            await apiFetch('/history/session/start', 'POST', sessionBody);
            (document.getElementById('watch-history-source') as HTMLSelectElement).value = '';
            window.dispatchEvent(new CustomEvent('watchd:session-changed'));
            logBtn.textContent = 'Watching started';
            logBtn.disabled = false;
            window.setTimeout(closeWatchHistoryModal, 700);
            return;
          }

          const watchedAt = _watchHistoryDateMode === 'unknown'
            ? null
            : _watchHistoryDateMode === 'now'
              ? toUTC(new Date())
              : toUTC(new Date(input.value || toLocal(new Date())));
          const watchBody: Record<string, unknown> = {
            tmdb_id: Number(_watchHistoryTmdbId),
            media_type: _watchHistoryMediaType,
            completed: true,
            watched_at: watchedAt,
          };
          const watchSource = (document.getElementById('watch-history-source') as HTMLSelectElement).value;
          if (watchSource) watchBody.watch_source = watchSource;
          if (_watchHistoryMediaType === 'episode' && _watchHistoryShowTmdbId) {
            watchBody.series_tmdb_id = Number(_watchHistoryShowTmdbId);
            if (_watchHistorySeasonNumber) watchBody.season_number = Number(_watchHistorySeasonNumber);
            if (_watchHistoryEpisodeNumber) watchBody.episode_number = Number(_watchHistoryEpisodeNumber);
          }
          if (_watchHistoryLocalId) {
            await apiFetch(`${localWatchPath()}/watch`, 'POST', {
              watched_at: watchedAt,
              watch_source: watchSource || null,
            });
          } else {
            await apiFetch('/history', 'POST', watchBody);
          }
          await loadWatchHistoryEvents();
          (document.getElementById('watch-history-source') as HTMLSelectElement).value = '';
          // Reset to "Just now" after logging
          _watchHistoryDateMode = 'now';
          (document.getElementById('watch-history-now-btn') as HTMLElement).className = activeClass;
          (document.getElementById('watch-history-custom-btn') as HTMLElement).className = inactiveClass;
          (document.getElementById('watch-history-unknown-btn') as HTMLElement).className = inactiveClass;
          (document.getElementById('watch-history-watching-btn') as HTMLElement).className = inactiveClass;
          input.classList.add('hidden');
          setNormalActionLabel();
        } catch { logBtn.textContent = idleLabel; }
        logBtn.disabled = false;
      });
    })();

    // ── Main event delegation ──────────────────────────────────────────────────
    document.addEventListener('click', async (e) => {
      const target = e.target as Element;

      const btn = target.closest<HTMLElement>('[data-action]');
      if (!btn) return;

      const card = btn.closest<HTMLElement>('[data-card]');
      if (!card) return;

      const action = btn.dataset.action;
      const mediaActions = ['watched', 'watchlist', 'list', 'rate', 'collected'];
      if (!action || !mediaActions.includes(action)) return;

      e.preventDefault();
      e.stopPropagation();

      const tmdbIdRaw = card.dataset.tmdbId;
      const tmdbId = tmdbIdRaw && tmdbIdRaw !== 'null' ? tmdbIdRaw : '';
      const mediaId = card.dataset.id || '';
      const mediaType = card.dataset.mediaType!;
      const episodeOrder = card.dataset.episodeOrder || 'tmdb';

      if (action === 'watched') {
        const isWatched = btn.dataset.watched === 'true';
        const showTmdbId = card.dataset.showTmdbId;
        const season = card.dataset.season;
        // For season cards: showTmdbId = show TMDB ID, tmdbId = show TMDB ID (same)
        // season is set → season-level operation
        const seriesId = showTmdbId || tmdbId;

        if (mediaType === 'movie' || mediaType === 'episode') {
          await openWatchHistoryModal(btn, tmdbId, mediaType, card.dataset.showTmdbId || '', card.dataset.season || '', card.dataset.episodeNumber || '');
          return;
        }

        let confirmed = true;
        if (mediaType === 'series' && season) {
          confirmed = await showConfirm(
            isWatched ? 'Mark season as unwatched?' : 'Mark season as watched?',
            isWatched
              ? 'This will remove all watch events for every episode in this season.'
              : 'This will add a watch event for every episode in your library for this season.'
          );
        } else if (mediaType === 'series' && !isWatched) {
          confirmed = await showConfirm('Mark all episodes as watched?', 'This will add a watch event for every episode in your library for this show.');
        } else if (mediaType === 'series' && isWatched) {
          confirmed = await showConfirm('Remove all watch history?', 'This will remove all watch events for every episode of this show.');
        }
        if (!confirmed) return;

        try {
          if (mediaType === 'series' && season) {
            const orderQuery = episodeOrder === 'tvdb' ? '&episode_order=tvdb' : '';
            if (isWatched) {
              await apiFetch(`/history/season?series_tmdb_id=${seriesId}&season_number=${season}${orderQuery}`, 'DELETE');
            } else {
              const watchBody: Record<string, number | string> = {
                series_tmdb_id: Number(seriesId),
                season_number: Number(season),
              };
              if (episodeOrder === 'tvdb') watchBody.episode_order = 'tvdb';
              await apiFetch('/history/season', 'POST', watchBody);
            }
          } else if (mediaType === 'series') {
            if (isWatched) {
              await apiFetch(`/history/show-all?series_tmdb_id=${tmdbId}`, 'DELETE');
            } else {
              await apiFetch('/history/show-all', 'POST', { series_tmdb_id: Number(tmdbId) });
            }
          }
          const nowWatched = !isWatched;

          updateWatchedButtonUI(btn, nowWatched);

          // If marking a show as watched/unwatched, update all season/episode cards on the page
          if (mediaType === 'series' && !season) {
            // Find season cards: can be [data-tmdb-id=SHOW_ID] with [data-season] set, 
            // OR [data-show-tmdb-id=SHOW_ID] with [data-season] set.
            const allSeasonCards = document.querySelectorAll(`
              [data-card][data-media-type="series"][data-tmdb-id="${tmdbId}"][data-season]:not([data-season=""]),
              [data-card][data-media-type="series"][data-show-tmdb-id="${tmdbId}"][data-season]:not([data-season=""])
            `);
            allSeasonCards.forEach(c => {
              const sBtn = c.querySelector('[data-action="watched"]');
              if (sBtn) updateWatchedButtonUI(sBtn, nowWatched);
            });
            // Also update any episode cards for this show
            const allEpCards = document.querySelectorAll(`[data-card][data-media-type="episode"][data-show-tmdb-id="${tmdbId}"]`);
            allEpCards.forEach(c => {
              const eBtn = c.querySelector('[data-action="watched"]');
              if (eBtn) updateWatchedButtonUI(eBtn, nowWatched);
            });
          }

          // If marking a season as watched/unwatched, update all episodes for that season on the page
          if (mediaType === 'series' && season) {
            const seasonAttribute = episodeOrder === 'tvdb' ? 'data-display-season' : 'data-season';
            const allEpCards = document.querySelectorAll(`[data-card][data-media-type="episode"][data-show-tmdb-id="${seriesId}"][${seasonAttribute}="${season}"]`);
            allEpCards.forEach(c => {
              const eBtn = c.querySelector('[data-action="watched"]');
              if (eBtn) updateWatchedButtonUI(eBtn, nowWatched);
            });
          }
        } catch { /* ignore */ }

            } else if (action === 'watchlist') {
        const inWatchlist = btn.dataset.inWatchlist === 'true';

        try {
          if (inWatchlist) {
            await apiFetch(`/watchlist/${Number(tmdbId)}`, 'DELETE');
          } else {
            await apiFetch(`/watchlist?tmdb_id=${Number(tmdbId)}`, 'POST');
          }

          const nowInWatchlist = !inWatchlist;
          btn.dataset.inWatchlist = String(nowInWatchlist);
          btn.dataset.state = nowInWatchlist ? 'active' : 'inactive';
          btn.title = nowInWatchlist ? 'Remove from watchlist' : 'Add to watchlist';

          btn.classList.remove(
            'bg-yellow-500/50',
            'text-yellow-300',
            'hover:bg-yellow-400/50',
            'bg-zinc-800',
            'text-zinc-500',
            'hover:text-yellow-300'
          );

          if (nowInWatchlist) {
            btn.classList.add(
              'bg-yellow-500/50',
              'text-yellow-300',
              'hover:bg-yellow-400/50'
            );
          } else {
            btn.classList.add(
              'bg-zinc-800',
              'text-zinc-500',
              'hover:bg-yellow-400/50',
              'hover:text-yellow-300'
            );
          }

          const svg = btn.querySelector('svg');
          if (svg) {
            svg.setAttribute('fill', nowInWatchlist ? 'currentColor' : 'none');
          }
        } catch {
          // ignore
        }

      } else if (action === 'list') {
        if (!tmdbId) { alert('Cannot add unmatched item to lists'); return; }
        if (document.getElementById('list-popover')!.classList.contains('hidden') || _activeListBtn !== btn) {
          openListPopover(btn, tmdbId, mediaType);
        } else {
          closeListPopover();
        }

      } else if (action === 'collected') {
        // The collection is the physical discs: open your copy of a film you
        // own, or your discs of a show you own any of; otherwise add a disc
        // of it. Seasons and episodes go by their show.
        const showTmdbId = card.dataset.showTmdbId;
        const inLibrary = btn.dataset.inLibrary === 'true';
        const ownsShow = Number(btn.dataset.collectionPct || 0) > 0;
        if (btn.dataset.discId) {
          // A season you own: straight to its disc.
          window.location.href = `/collection?item=${btn.dataset.discId}`;
        } else if (mediaType === 'series' && ownsShow && (showTmdbId || tmdbId)) {
          window.location.href = `/collection?show=${showTmdbId || tmdbId}`;
        } else if (mediaType === 'movie' && tmdbId && inLibrary) {
          window.location.href = `/collection?tmdb=${tmdbId}`;
        } else if (mediaType === 'movie' && tmdbId) {
          window.location.href = `/collection/add?tmdb=${tmdbId}&kind=movie`;
        } else if ((mediaType === 'series' || mediaType === 'episode') && (showTmdbId || tmdbId)) {
          window.location.href = `/collection/add?tmdb=${mediaType === 'episode' ? showTmdbId : (showTmdbId || tmdbId)}&kind=tv`;
        } else {
          window.location.href = '/collection/add';
        }

      } else if (action === 'rate') {
        const currentRating = btn.dataset.userRating ? Number(btn.dataset.userRating) : null;
        const ratingSeason = (mediaType === 'series' && card.dataset.season) ? Number(card.dataset.season) : null;
        if (document.getElementById('rating-popover')!.classList.contains('hidden') || _activeRatingBtn !== btn) {
          openRatingPopover(btn, tmdbId, mediaType, currentRating, ratingSeason, episodeOrder, card.dataset.localId || '');
        } else {
          closeRatingPopover();
        }

      } else if (action === 'request') {
        const originalContent = btn.innerHTML;
        btn.innerHTML = '<svg class="animate-spin h-5 w-5 text-orange-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';
        btn.classList.add('pointer-events-none');
        
        try {
          const res = await apiFetch(`/media/${mediaType}/${tmdbId}/request`, 'POST');
          if (res.status === 'added' || res.status === 'already_exists') {
            btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-green-500"><polyline points="20 6 9 17 4 12"></polyline></svg><span class="text-[10px] font-bold uppercase tracking-wider leading-none text-green-500">' + (res.status === 'added' ? 'Added' : 'Exists') + '</span>';
            btn.classList.remove('bg-zinc-800', 'text-zinc-500', 'hover:bg-orange-500/10', 'hover:text-orange-400');
            btn.classList.add('bg-green-500/10', 'text-green-500');
            (btn as HTMLButtonElement).disabled = true;
          } else if (res.status === 'pending_approval') {
            btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-amber-400"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg><span class="text-[10px] font-bold uppercase tracking-wider leading-none text-amber-400">Pending</span>';
            btn.classList.remove('bg-zinc-800', 'text-zinc-500', 'hover:bg-orange-500/10', 'hover:text-orange-400');
            btn.classList.add('bg-amber-500/10', 'text-amber-400');
            (btn as HTMLButtonElement).disabled = true;
          } else {
            throw new Error('Failed to request');
          }
        } catch (err: any) {
          btn.innerHTML = originalContent;
          btn.classList.remove('pointer-events-none');
          // Try to parse error message
          let msg = 'Request failed';
          try {
             const data = JSON.parse(err.message);
             msg = data.detail || msg;
          } catch {
             if (err.message) msg = err.message;
          }
          alert(msg);
        }
      }
    });
  </script>
  <script>
    // ── Radarr / Sonarr monitored check (deferred after page load) ────────────
    (async () => {
      const btn = document.querySelector<HTMLButtonElement>('[data-action="request"][data-request-loading="true"]');
      if (!btn) return;
      const card = btn.closest<HTMLElement>('[data-card]');
      if (!card) return;
      const tmdbId = card.dataset.tmdbId;
      const mediaType = card.dataset.mediaType;
      if (!tmdbId || !mediaType) return;

      const API = '/api/proxy';

      try {
        const res = await fetch(`${API}/media/request-status?tmdb_id=${tmdbId}&media_type=${mediaType}`);
        if (!res.ok) return; // service down — keep disabled
        const { monitored } = await res.json();
        btn.removeAttribute('data-request-loading');
        if (monitored) {
          btn.title = mediaType === 'series' ? 'Already in Sonarr' : 'Already in Radarr';
          btn.dataset.state = 'active';
          btn.classList.remove('bg-zinc-800', 'text-zinc-500', 'hover:bg-orange-300/60', 'hover:text-orange-400');
          btn.classList.add('bg-orange-500/50', 'text-orange-300', 'hover:bg-orange-400/50');
        } else {
          btn.disabled = false;
        }
      } catch {
        // network error — keep disabled
      }
    })();
  </script>
  <script>
    // ── PWA install prompt ─────────────────────────────────────────────────────
    const DISMISS_KEY = 'pwa-install-dismissed';
    const DISMISS_TTL = 7 * 24 * 60 * 60 * 1000; // 7 days

    const banner   = document.getElementById('pwa-banner')!;
    const msgEl    = document.getElementById('pwa-banner-msg')!;
    const installWrap = document.getElementById('pwa-install-wrap')!;
    const installBtn  = document.getElementById('pwa-install-btn')!;
    const dismissBtn  = document.getElementById('pwa-dismiss')!;

    // Don't show if already running as installed PWA
    const isInstalled = window.matchMedia('(display-mode: standalone)').matches
      || (navigator as any).standalone === true;

    const wasDismissed = (() => {
      const val = localStorage.getItem(DISMISS_KEY);
      return val ? Date.now() - Number(val) < DISMISS_TTL : false;
    })();

    function showBanner() {
      if (isInstalled || wasDismissed) return;
      banner.classList.remove('hidden');
    }

    function dismiss() {
      banner.classList.add('hidden');
      localStorage.setItem(DISMISS_KEY, String(Date.now()));
    }

    dismissBtn.addEventListener('click', dismiss);

    // ── Android / desktop Chrome: use beforeinstallprompt ─────────────────────
    let deferredPrompt: any = null;

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
      installWrap.classList.remove('hidden');
      setTimeout(showBanner, 2000);
    });

    installBtn.addEventListener('click', async () => {
      if (!deferredPrompt) return;
      deferredPrompt.prompt();
      const { outcome } = await deferredPrompt.userChoice;
      deferredPrompt = null;
      if (outcome === 'accepted') {
        banner.classList.add('hidden');
      }
    });

    window.addEventListener('appinstalled', () => {
      banner.classList.add('hidden');
      deferredPrompt = null;
    });

    // ── iOS Safari: no beforeinstallprompt — show manual instructions ─────────
    // iPadOS 13+ spoofs a desktop Mac UA, so also check for Mac + touch support
    const isIos = /iphone|ipad|ipod/i.test(navigator.userAgent)
      || (navigator.userAgent.includes('Mac') && navigator.maxTouchPoints > 1);
    const isInStandaloneMode = (navigator as any).standalone === true;

    if (isIos && !isInStandaloneMode) {
      msgEl.textContent = 'Tap the Share button, then "Add to Home Screen".';
      setTimeout(showBanner, 2000);
    }
  </script>

  <script>
    document.getElementById('bottom-nav')?.addEventListener('touchstart', () => {
      navigator.vibrate?.(10);
    }, { passive: true });
  </script>

  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch((err) => {
          console.warn('[SW] Registration failed:', err);
        });
      });
    }
  </script>

  <script>
    // ── Grab and Drag Scrolling ────────────────────────────────────────────────
    function initDragScroll() {
      const sliders = document.querySelectorAll<HTMLElement>('.scrollbar-none');

      sliders.forEach(slider => {
        if (slider.dataset.dragInit) return;
        slider.dataset.dragInit = '1';
        let isDown = false;
        let startX: number;
        let scrollLeft: number;
        let hasMoved = false;
        let preventClickRef: ((e: MouseEvent) => void) | null = null;

        slider.addEventListener('mousedown', (e) => {
          // Only trigger on primary mouse button (left click)
          if (e.button !== 0) return;

          // Clear any pending preventClick from a previous drag so a fresh click is never blocked
          if (preventClickRef) {
            slider.removeEventListener('click', preventClickRef, true);
            preventClickRef = null;
          }

          isDown = true;
          hasMoved = false;
          // Do NOT add is-dragging yet — adding it here sets pointer-events:none on all
          // children, which shifts the mouseup target and breaks click events on cards.
          // is-dragging is added below only once actual movement is detected.
          startX = e.pageX - slider.offsetLeft;
          scrollLeft = slider.scrollLeft;
        });

        slider.addEventListener('mouseleave', () => {
          if (!isDown) return;
          isDown = false;
          slider.classList.remove('is-dragging');
        });

        slider.addEventListener('mouseup', (e) => {
          if (!isDown) return;
          isDown = false;
          slider.classList.remove('is-dragging');
          
          // If we moved, prevent the next click event from firing on child elements
          if (hasMoved) {
            preventClickRef = (event: MouseEvent) => {
              event.stopImmediatePropagation();
              event.preventDefault();
              slider.removeEventListener('click', preventClickRef!, true);
              preventClickRef = null;
            };
            slider.addEventListener('click', preventClickRef, true);
          }
        });

        slider.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          
          const x = e.pageX - slider.offsetLeft;
          const walk = (x - startX) * 1.5; // multiplier for speed
          
          if (Math.abs(walk) > 16) {
            hasMoved = true;
            slider.classList.add('is-dragging');
            e.preventDefault();
            slider.scrollLeft = scrollLeft - walk;
          }
        });

        // Prevent native drag starts (for images/links) to avoid interfering
        slider.addEventListener('dragstart', (e) => {
          if (isDown) e.preventDefault();
        });
      });
    }

    // Run on initial load
    initDragScroll();

    // Re-run if using Astro View Transitions (if added in the future)
    document.addEventListener('astro:after-swap', initDragScroll);
    
    // Also re-run after dynamic content is loaded (for Trending/Airing sections)
    // We can use a simple interval or a MutationObserver. 
    // Given the project style, an interval or manual trigger is common.
    // For now, let's also hook into the loadSection calls if they existed here, 
    // but they are in index.astro. For general discovery, we'll use a MutationObserver.
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.addedNodes.length) {
          initDragScroll();
        }
      });
    });
    
    observer.observe(document.body, { childList: true, subtree: true });

    // Bust bfcache on every page so back/forward always shows fresh server state
    window.addEventListener('pageshow', (e) => { if (e.persisted) location.reload(); });

    // Reveal blurred adult posters on click (capture phase so it fires before <a> navigation).
    // Also reveals the backdrop on the same page, which cannot be clicked directly.
    document.addEventListener('click', (e) => {
      const adultEl = (e.target as Element).closest<HTMLElement>('[data-adult="true"]');
      if (adultEl && document.documentElement.classList.contains('blur-explicit')) {
        e.preventDefault();
        e.stopImmediatePropagation();
        document.querySelectorAll<HTMLElement>('[data-adult="true"]').forEach(el => el.removeAttribute('data-adult'));
        document.querySelectorAll<HTMLElement>('[data-adult-backdrop="true"]').forEach(el => el.removeAttribute('data-adult-backdrop'));
      }
    }, true);
  </script>
  {token && !hideNav && <NowWatching />}
  <!-- Cast and crew cards keep their name and part to one line; hovering one
       shows them in full. -->
  <div id="person-tip" role="tooltip" hidden></div>
  <style is:global>
    #person-tip { position: fixed; z-index: 60; max-width: 260px; padding: 8px 12px; border-radius: 10px; background: #27272a; border: 1px solid #3f3f46; color: #fff; pointer-events: none; box-shadow: 0 8px 24px rgba(0,0,0,.45); }
    #person-tip b { display: block; font-size: 13px; font-weight: 900; line-height: 1.25; }
    #person-tip span { display: block; margin-top: 3px; font-size: 11px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: #a1a1aa; line-height: 1.3; }
    html.light #person-tip { background: #fff; border-color: #d4d4d8; color: #18181b; }
  </style>
  <script>
    const personTip = document.getElementById('person-tip')!;
    const cardOf = (el: EventTarget | null) => (el as HTMLElement | null)?.closest?.<HTMLElement>('a.group\\/cast, a.group\\/crew') ?? null;
    document.addEventListener('mouseover', (e) => {
      const card = cardOf(e.target);
      if (!card) return;
      const [name, part] = Array.from(card.querySelectorAll('p')).map((p) => p.textContent?.trim() ?? '');
      if (!name) return;
      personTip.replaceChildren();
      const b = document.createElement('b'); b.textContent = name; personTip.append(b);
      if (part) { const span = document.createElement('span'); span.textContent = part; personTip.append(span); }
      personTip.hidden = false;
      const r = card.getBoundingClientRect();
      const w = personTip.offsetWidth, h = personTip.offsetHeight;
      personTip.style.left = `${Math.max(8, Math.min(r.left + r.width / 2 - w / 2, innerWidth - w - 8))}px`;
      // Over the card's own name and part, so it's always on screen with the card.
      personTip.style.top = `${Math.max(8, r.bottom - h - 8)}px`;
    });
    document.addEventListener('mouseout', (e) => {
      if (cardOf(e.target) && !cardOf((e as MouseEvent).relatedTarget)) personTip.hidden = true;
    });
    addEventListener('scroll', () => { personTip.hidden = true; }, { passive: true, capture: true });
  </script>
</body>
